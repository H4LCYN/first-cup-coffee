{%- liquid
  assign s = section.settings
  assign bundle = s.bundle_product
  assign bundle_collection_id = s.bundle_collection.id

  comment
    The product description drives the page: its first <ul> becomes the bullets in the
    info column and everything else becomes the partnership copy at the bottom.
  endcomment
  assign desc = product.description
  assign list_html = ''
  assign copy_html = desc
  if desc contains '<ul'
    assign desc_pre = desc | split: '<ul' | first
    assign desc_rest = desc | remove_first: desc_pre
    assign list_html = desc_rest | split: '</ul>' | first | append: '</ul>'
    assign copy_html = desc_pre | append: desc_rest | remove_first: list_html
  endif

  assign is_split = false
  if s.feature_layout == 'split'
    assign is_split = true
  endif
  assign is_backdrop = false
  if s.feature_layout == 'backdrop'
    assign is_backdrop = true
  endif

  assign banner = nil
  assign banner_mobile = nil
  assign banner_fg = nil
  for block in section.blocks
    if block.type == 'banner_image' and banner == nil
      if block.settings.image != blank
        assign banner = block.settings.image | image_url: width: 2000
      elsif block.settings.image_asset != blank
        assign banner = block.settings.image_asset | asset_url
      endif
      if block.settings.mobile_image != blank
        assign banner_mobile = block.settings.mobile_image | image_url: width: 1000
      elsif block.settings.mobile_image_asset != blank
        assign banner_mobile = block.settings.mobile_image_asset | asset_url
      endif
      if block.settings.foreground_image != blank
        assign banner_fg = block.settings.foreground_image | image_url: width: 1100
      elsif block.settings.foreground_image_asset != blank
        assign banner_fg = block.settings.foreground_image_asset | asset_url
      endif
    endif
  endfor
-%}

<style>
  .fpf {
    --fpf-bg: {{ s.panel_bg }};
    --fpf-accent: {{ s.accent_color }};
    --fpf-text: {{ s.text_color }};
    --fpf-tag: {{ s.tag_color }};
    --fpf-discount: {{ s.discount_color }};
    --fpf-radius: {{ s.panel_radius }}px;
    margin: var(--desktop-y-spacing) var(--desktop-x-spacing) 0;
    color: var(--fpf-text);
  }

  .fpf__panel {
    max-width: 1292px;
    margin: 0 auto;
    overflow: hidden;
    border-radius: var(--fpf-radius);
    background: linear-gradient(rgba(0, 0, 0, 0.2), rgba(0, 0, 0, 0.2)), var(--fpf-bg);
  }

  /* Product image + info */
  .fpf__top {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 46px;
    justify-content: center;
    align-items: flex-start;
    padding: 50px 50px;
  }

  .fpf__media {
    height: 698px;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    border-radius: var(--fpf-radius);
  }

  .fpf__media img {
    display: block;
    width: auto;
    max-width: 100%;
    height: 665px;
    object-fit: contain;
  }

  .fpf__info {
    min-height: 698px;
    box-sizing: border-box;
    padding-top: 16px;
  }

  .fpf__eyebrow {
    margin: 0;
    font-family: Avenirnextltpro, sans-serif;
    font-size: 15.9px;
    line-height: 1;
    color: var(--fpf-accent);
  }

  .fpf__title {
    margin: 0;
    padding-top: 4.8px;
    font-family: "Avenir Next Condensed", sans-serif;
    font-weight: 700;
    font-size: 44.5px;
    line-height: 1;
    text-transform: uppercase;
    color: var(--fpf-text);
  }

  .fpf__price {
    margin: 16px 0 0;
    font-family: Avenirnextltpro, sans-serif;
    font-size: 22.25px;
    line-height: 1;
    color: var(--fpf-text);
  }

  .fpf__bullets {
    margin: 32px 0 0;
    padding: 0;
    font-family: "Avenir Next Condensed", sans-serif;
    font-size: 18px;
    line-height: 22.25px;
    color: var(--fpf-text);
  }

  .fpf__bullets:empty { display: none; }
  .fpf__bullets--blocks { padding-left: 40px; }
  .fpf__bullets ul { margin: 0; padding: 0 0 0 40px; }
  .fpf__bullets li { margin: 0; }
  .fpf__bullets p { margin: 0 0 12px; }

  .fpf .fbb { margin-top: 30px; }

  /* Format (size) switcher: links to the sibling products */
  .fpf__formats { margin-top: 30px; display: flex; flex-direction: column; gap: 11px; }
  .fpf__formats-label { margin: 0; font-family: "Avenir Next Condensed", sans-serif; font-weight: 700; font-size: 15px; line-height: 15.9px; color: var(--fpf-text); }
  .fpf__formats-label:empty { display: none; }
  .fpf__formats-row { display: flex; flex-wrap: wrap; gap: 14px; }
  .fpf__format {
    display: flex; align-items: center; justify-content: center; box-sizing: border-box;
    min-width: 106px; height: 39px; padding: 6px 15px;
    border: 2px solid var(--fpf-text); border-radius: 2px; background: transparent; color: var(--fpf-text);
    font-family: Roboto, sans-serif; font-weight: 700; font-size: 14px; line-height: 14px; letter-spacing: 0.7px;
    text-align: center; text-decoration: none; white-space: nowrap; transition: background-color .15s, border-color .15s;
  }
  a.fpf__format:hover { border-color: var(--fpf-accent); color: var(--fpf-text); }
  .fpf__format.is-current { background: var(--fpf-accent); border-color: var(--fpf-accent); }
  a.fpf__format:focus-visible { outline: 2px solid #fff; outline-offset: 3px; }
  .fpf__formats + .fbb { margin-top: 30px; }

  /* Buy box */
  .fbb__form { display: flex; flex-direction: column; gap: 30px; }
  .fbb__options { display: flex; flex-direction: column; gap: 17px; }
  .fbb__group { margin: 0; padding: 0; border: 0; min-width: 0; display: flex; flex-direction: column; gap: 11px; }
  .fbb__group--toggle { flex-direction: row; gap: 14px; flex-wrap: wrap; }
  .fbb__group[hidden], .fbb [hidden] { display: none !important; }
  .fbb__label {
    padding: 0; font-family: "Avenir Next Condensed", sans-serif; font-weight: 700;
    font-size: 15px; line-height: 15.9px; color: var(--fpf-text);
  }
  .fbb__sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
  .fbb__row { display: flex; flex-wrap: wrap; gap: 14px; align-items: flex-start; }
  .fbb__bag { display: flex; flex-direction: column; align-items: center; gap: 7px; }

  .fbb__opt { position: relative; display: block; cursor: pointer; }
  .fbb__opt input { position: absolute; opacity: 0; width: 1px; height: 1px; margin: 0; }
  .fbb__btn {
    display: flex; align-items: center; justify-content: center; box-sizing: border-box;
    min-width: 106px; height: 39px; padding: 6px 15px;
    border: 2px solid var(--fpf-text); border-radius: 2px; background: transparent; color: var(--fpf-text);
    font-family: Roboto, sans-serif; font-weight: 700; font-size: 14px; line-height: 14px; letter-spacing: 0.7px;
    text-align: center; white-space: nowrap;
    transition: background-color .15s, border-color .15s;
  }
  .fbb__opt--big .fbb__btn {
    width: 183px; height: 55px; text-transform: uppercase; white-space: normal;
  }
  .fbb__opt:hover .fbb__btn { border-color: var(--fpf-accent); }
  .fbb__opt input:checked + .fbb__btn { background: var(--fpf-accent); border-color: var(--fpf-accent); }
  .fbb__opt input:focus-visible + .fbb__btn { outline: 2px solid #fff; outline-offset: 3px; }

  .fbb__tag {
    position: absolute; z-index: 1; display: flex; align-items: center; justify-content: center; box-sizing: border-box;
    border-radius: 6.4px; background: var(--fpf-tag); color: #fff; text-align: center; text-transform: uppercase;
    font-family: "Avenir Next Condensed", sans-serif; font-weight: 700; font-size: 9.5px; line-height: 8.75px;
    pointer-events: none;
  }
  .fbb__tag--top { left: 50%; bottom: calc(100% - 8px); transform: translateX(-50%); width: 70px; height: 23px; }
  .fbb__tag--corner { top: -15px; left: calc(100% - 16px); padding: 7px; white-space: nowrap; }

  .fbb__discount {
    font-family: "Avenir Next Condensed", sans-serif; font-weight: 700; font-size: 15.1px; line-height: 15.1px;
    color: var(--fpf-discount); white-space: nowrap;
  }

  .fbb__add {
    box-sizing: border-box; width: 100%; max-width: 468px; padding: 7.7px 23px; border: 0; border-radius: 2.2px;
    background: var(--fpf-accent); color: #fff; cursor: pointer;
    font-family: Avenirnextltpro, sans-serif; font-weight: 700; font-size: 18px; line-height: 38px; text-transform: uppercase;
    transition: background-color .15s;
  }
  .fbb__add:hover:not(:disabled) { filter: brightness(0.9); }
  .fbb__add:focus-visible { outline: 2px solid #fff; outline-offset: 3px; }
  .fbb__add:disabled { opacity: .5; cursor: not-allowed; }
  .fbb__error { margin: 12px 0 0; font-family: Avenirnextltpro, sans-serif; font-size: 14px; color: #ff6b61; }

  /* Feature area */
  .fpf__feature {
    display: flex; flex-direction: column; align-items: center; text-align: center;
    min-height: 727px; box-sizing: border-box; padding: 105px 108px 56px;
    background-color: var(--fpf-bg); background-image: var(--fpf-banner, none); background-size: cover; background-position: center;
  }
  .fpf__quote { max-width: 935px; margin: 0 0 10px; }
  .fpf__quote-text {
    margin: 0; font-family: "Avenir Next Condensed", sans-serif; font-weight: 700; font-size: 44.5px; line-height: 49px; color: var(--fpf-text);
  }
  .fpf__quote-by {
    margin: 0; font-family: "Avenir Next Condensed", sans-serif; font-weight: 700; font-size: 24px; line-height: 49px; text-transform: uppercase; color: var(--fpf-text);
  }
  .fpf__logo { display: block; width: var(--fpf-logo-w-set, 321px); max-width: 100%; height: auto; margin: 0 auto 56px; }
  .fpf__body {
    max-width: 1027px; margin: 0 0 56px; font-family: "Avenir Next Condensed", sans-serif; font-size: 27px; line-height: 34px; color: var(--fpf-text);
  }
  .fpf__body p { margin: 0 0 1em; }
  .fpf__body p:last-child { margin-bottom: 0; }

  .fpf__heading {
    margin: 0 0 24px; font-family: "Avenir Next Condensed", sans-serif; font-weight: 700;
    font-size: 55px; line-height: 49px; text-transform: uppercase; color: var(--fpf-text);
  }

  /* Split feature layout: logo left, heading + copy right, banner anchored to the bottom */
  .fpf__feature--split {
    min-height: 0; padding: 10px 50px 0; align-items: stretch; text-align: left; background: transparent;
    --fpf-fade: color-mix(in srgb, var(--fpf-bg) 80%, #000);
  }
  .fpf__split { position: relative; z-index: 1; display: flex; gap: 48px; align-items: center; justify-content: center; }
  .fpf__split-logo { flex: 0 0 auto; }
  .fpf__split-logo .fpf__logo { width: var(--fpf-logo-w-set, 284px); margin: 0; border-radius: 50%; }
  .fpf__split-text { flex: 0 1 678px; display: flex; flex-direction: column; gap: 14px; }
  .fpf__split-text .fpf__heading { max-width: 557px; margin: 0; }
  .fpf__split-text .fpf__quote { max-width: none; margin: 0; }
  .fpf__split-text .fpf__body { max-width: none; margin: 0; font-size: 22px; line-height: 31px; }
  .fpf__scene {
    position: relative; height: 419px; margin: -4px -50px 0;
    background-color: var(--fpf-fade); background-image: var(--fpf-banner, none); background-size: cover; background-position: center top;
  }
  .fpf__scene::before {
    content: ""; position: absolute; top: 0; left: 0; right: 0; height: 270px;
    background: linear-gradient(to bottom, var(--fpf-fade) 10.236%, transparent);
  }
  .fpf__scene-fg { position: absolute; left: 90px; bottom: 0; display: block; width: 517px; max-width: 45%; height: auto; }

  /* Backdrop layout (BAFO, Figma 500:354): the banner photo sits behind the lower part of the
     whole panel, left-aligned at 2448px wide on a 1292px panel; the product description's
     paragraph moves up under the bullets; the feature area is an optional video, then the
     cut-out photo beside the logo and copy, flush with the panel's bottom edge. */
  .fpf__panel--backdrop { position: relative; isolation: isolate; }
  .fpf__backdrop {
    position: absolute; z-index: -1; left: 0; bottom: 0; width: 189.5%; aspect-ratio: 16 / 9;
    background-image: var(--fpf-banner, none); background-size: cover; background-position: left top;
    pointer-events: none;
  }
  .fpf__summary {
    margin-top: 14px; padding-top: 10px; font-family: "Avenir Next Condensed", sans-serif;
    font-size: 16px; line-height: 22.25px; color: var(--fpf-text);
  }
  .fpf__summary p { margin: 0 0 12px; }
  .fpf__summary p:last-child { margin-bottom: 0; }
  .fpf__feature--backdrop {
    min-height: 0; padding: 63px 0 0; align-items: stretch; text-align: left; background: transparent;
  }
  .fpf__video { position: relative; width: 888px; max-width: calc(100% - 100px); margin: 0 auto 49px; aspect-ratio: 16 / 9; background: #000; }
  .fpf__video video, .fpf__video iframe { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; object-fit: cover; }
  /* Play button: matches .vimeo-video-2026_big-play on the homepage */
  .fpf__video-toggle {
    position: absolute; inset: 0; display: flex; align-items: center; justify-content: center;
    padding: 0; border: 0; background: transparent; cursor: pointer;
  }
  .fpf__video-play {
    display: flex; align-items: center; justify-content: center; width: 76px; height: 76px; border-radius: 50%;
    background-color: rgba(0, 0, 0, 0.55); color: #fff; transition: opacity 0.2s, transform 0.2s;
  }
  .fpf__video-play svg { width: 38px; height: 38px; margin-left: 4px; }
  .fpf__video-toggle:hover .fpf__video-play { transform: scale(1.06); }
  .fpf__video-toggle:focus-visible { outline: 2px solid #fff; outline-offset: -4px; }
  .fpf__video.is-playing .fpf__video-play { opacity: 0; }
  .fpf__story { display: flex; align-items: center; gap: 34px; padding-left: 33px; }
  .fpf__story-fg { flex: 0 0 573px; align-self: flex-end; display: block; width: 573px; height: auto; }
  .fpf__story-text { flex: 0 1 606px; display: flex; flex-direction: column; align-items: center; gap: 48px; padding: 40px 0; }
  .fpf__story-text .fpf__logo { width: var(--fpf-logo-w-set, 150px); margin: 0; }
  .fpf__story-text .fpf__heading,
  .fpf__story-text .fpf__quote { align-self: stretch; margin: 0; }
  .fpf__story-text .fpf__body { align-self: stretch; max-width: none; margin: 0; font-size: 31px; line-height: 35px; }
  .fpf__story-text .fpf__body p { margin-bottom: 35px; }
  .fpf__story-text .fpf__body p:last-child { margin-bottom: 0; }

  @media screen and (max-width: 991px) {
    .fpf__backdrop { width: 300%; background-image: var(--fpf-banner-m, var(--fpf-banner, none)); }
    /* The bio sits over the photo's top edge on narrow screens: fade that edge into the panel and lift the text off it. */
    .fpf__backdrop::before { content: ""; position: absolute; top: 0; left: 0; right: 0; height: 30%; background: linear-gradient(to bottom, var(--fpf-bg), transparent); }
    .fpf__story-text .fpf__body { text-shadow: 0 1px 4px rgba(0, 0, 0, 0.85); }
    .fpf__feature--backdrop { padding-top: 16px; }
    .fpf__video { max-width: calc(100% - 48px); margin-bottom: 32px; }
    .fpf__story { flex-direction: column-reverse; align-items: center; gap: 24px; padding: 0 24px; }
    .fpf__story-fg { flex: none; align-self: center; width: 85%; max-width: 420px; }
    .fpf__story-text { flex: none; gap: 24px; padding: 0; }
    .fpf__story-text .fpf__logo { width: min(var(--fpf-logo-w-set, 150px), 120px); }
    .fpf__story-text .fpf__body { font-size: 20px; line-height: 1.35; }
    .fpf__story-text .fpf__body p { margin-bottom: 20px; }
  }

  @media screen and (max-width: 991px) {
    .fpf__heading { font-size: 34px; line-height: 1.05; margin-bottom: 16px; }
    .fpf__feature--split { padding: 16px 24px 0; }
    .fpf__split { flex-direction: column; gap: 24px; }
    .fpf__split-logo .fpf__logo { width: min(var(--fpf-logo-w-set, 284px), 200px); }
    .fpf__split-text .fpf__body { font-size: 19px; line-height: 1.4; }
    .fpf__scene { height: 280px; margin: 24px -24px 0; background-image: var(--fpf-banner-m, var(--fpf-banner, none)); }
    .fpf__scene::before { height: 160px; }
    .fpf__scene-fg { left: 12px; width: 62%; max-width: 340px; }
  }

  @media screen and (max-width: 991px) {
    .fpf__top { grid-template-columns: 1fr; gap: 0; padding: 24px 24px 40px; }
    .fpf__media { height: auto; padding: 24px 0; }
    .fpf__media img { height: auto; max-height: 520px; }
    .fpf__info { min-height: 0; }
    .fpf__bullets--blocks, .fpf__bullets ul { padding-left: 24px; }
    .fbb__opt--big .fbb__btn { width: 100%; }
    .fbb__group--toggle > .fbb__opt { flex: 1 1 183px; }
    .fbb__tag--corner { left: auto; right: -6px; }
    .fbb__add { max-width: none; }
    .fpf__split-text { flex: auto }
    .fpf__feature { min-height: 0; background-image: var(--fpf-banner-m, var(--fpf-banner, none)); }
    .fpf__feature:not(.fpf__feature--split):not(.fpf__feature--backdrop) { padding: 56px 24px 40px; }
    .fpf__quote-text { font-size: 28px; line-height: 1.15; }
    .fpf__quote-by { font-size: 18px; line-height: 1.6; }
    .fpf__logo { width: min(var(--fpf-logo-w-set, 321px), 220px); margin-bottom: 32px; }
    .fpf__body { font-size: 19px; line-height: 1.4; margin-bottom: 24px; }
  }
</style>

<section class="fpf" id="fpf-{{ section.id }}">
  <div class="fpf__panel{% if is_backdrop %} fpf__panel--backdrop{% endif %}">
    {%- if is_backdrop and banner != nil -%}
      <div class="fpf__backdrop" style="--fpf-banner: url('{{ banner }}');{% if banner_mobile != nil %} --fpf-banner-m: url('{{ banner_mobile }}');{% endif %}" aria-hidden="true"></div>
    {%- endif -%}
    <div class="fpf__top">
      <div class="fpf__media">
        {%- liquid
          assign product_img = nil
          if s.product_image != blank
            assign product_img = s.product_image | image_url: width: 1000
          elsif product.featured_image != blank
            assign product_img = product.featured_image | image_url: width: 1000
          elsif s.product_image_asset != blank
            assign product_img = s.product_image_asset | asset_url
          endif
        -%}
        {%- if product_img != nil -%}
          <img src="{{ product_img }}" alt="{{ product.featured_image.alt | default: product.title | escape }}" width="401" height="665" loading="eager">
        {%- endif -%}
      </div>

      <div class="fpf__info">
        {%- assign eyebrow = s.eyebrow_text | default: product.type -%}
        {%- if eyebrow != blank -%}
          <p class="fpf__eyebrow">{{ eyebrow }}</p>
        {%- endif -%}
        <h1 class="fpf__title">{{ product.title }}</h1>
        <!-- Start of Judge.me code --> <div class='jdgm-widget jdgm-preview-badge' data-id='{{ product.id }}' data-auto-install='false'> {{ product.metafields.judgeme.badge }} </div> <!-- End of Judge.me code -->
        <p class="fpf__price">{{ product.selected_or_first_available_variant.price | money }}</p>

        {%- if list_html != blank -%}
          <div class="fpf__bullets">{{ list_html }}</div>
        {%- else -%}
          <ul class="fpf__bullets fpf__bullets--blocks">
            {%- for block in section.blocks -%}
              {%- if block.type == 'bullet' -%}
                <li {{ block.shopify_attributes }}>{{ block.settings.text }}</li>
              {%- endif -%}
            {%- endfor -%}
          </ul>
        {%- endif -%}

        {%- if is_backdrop and copy_html != blank -%}
          <div class="fpf__summary">{{ copy_html }}</div>
        {%- endif -%}

        {%- liquid
          assign format_count = 0
          for block in section.blocks
            if block.type == 'format' and block.settings.product != blank
              assign format_count = format_count | plus: 1
            endif
          endfor
        -%}
        {%- if format_count > 1 -%}
          <div class="fpf__formats">
            <p class="fpf__formats-label">{{ s.formats_label }}</p>
            <div class="fpf__formats-row">
              {%- for block in section.blocks -%}
                {%- if block.type == 'format' and block.settings.product != blank -%}
                  {%- assign format_product = block.settings.product -%}
                  {%- assign format_name = block.settings.label | default: format_product.title -%}
                  {%- if format_product.handle == product.handle -%}
                    <span class="fpf__format is-current" aria-current="page" {{ block.shopify_attributes }}>{{ format_name }}</span>
                  {%- else -%}
                    <a class="fpf__format" href="{{ format_product.url }}" {{ block.shopify_attributes }}>{{ format_name }}</a>
                  {%- endif -%}
                {%- endif -%}
              {%- endfor -%}
            </div>
          </div>
        {%- else -%}
          {%- render 'format-switcher', product: product, label: s.formats_label -%}
        {%- endif -%}

        {%- render 'feature-buy-box', product: product, section: section, bundle: bundle, collection_id: bundle_collection_id -%}
      </div>
    </div>

    {%- capture banner_vars -%}{% if banner != nil %}--fpf-banner: url('{{ banner }}');{% endif %}{% if banner_mobile != nil %} --fpf-banner-m: url('{{ banner_mobile }}');{% endif %}{%- endcapture -%}
    {%- capture logo_html -%}
      {%- for block in section.blocks -%}
        {%- if block.type == 'partner_logo' -%}
          {%- liquid
            assign logo = nil
            if block.settings.image != blank
              assign logo = block.settings.image | image_url: width: 700
            elsif block.settings.image_asset != blank
              assign logo = block.settings.image_asset | asset_url
            endif
          -%}
          {%- if logo != nil -%}
            <img
              class="fpf__logo"
              src="{{ logo }}"
              alt="{{ block.settings.alt | escape }}"
              width="{{ block.settings.max_width }}"
              height="{{ block.settings.max_width }}"
              loading="lazy"
              style="--fpf-logo-w-set: {{ block.settings.max_width }}px;"
              {{ block.shopify_attributes }}
            >
          {%- endif -%}
        {%- endif -%}
      {%- endfor -%}
    {%- endcapture -%}

    {%- if is_backdrop -%}
      <div class="fpf__feature fpf__feature--backdrop">
        {%- for block in section.blocks -%}
          {%- if block.type == 'video' -%}
            {%- assign v = block.settings -%}
            {%- if v.video != blank -%}
              <div class="fpf__video" {{ block.shopify_attributes }}>
                {{ v.video | video_tag: image_size: '1100x', controls: true, playsinline: true, preload: 'metadata' }}
              </div>
            {%- elsif v.video_url != blank -%}
              <div class="fpf__video" {{ block.shopify_attributes }}>
                {%- if v.video_url.type == 'youtube' -%}
                  <iframe src="https://www.youtube-nocookie.com/embed/{{ v.video_url.id }}?rel=0" title="{{ v.title | default: product.title | escape }}" loading="lazy" allow="accelerometer; autoplay; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe>
                {%- elsif v.video_url.type == 'vimeo' -%}
                  {%- comment -%} Unlisted Vimeo links carry a privacy hash after the ID (vimeo.com/ID/HASH or ?h=HASH); the player needs it. {%- endcomment -%}
                  {%- liquid
                    assign vimeo_raw = v.video_url | append: ''
                    assign vimeo_hash = ''
                    if vimeo_raw contains 'h='
                      assign vimeo_hash = vimeo_raw | split: 'h=' | last | split: '&' | first
                    else
                      assign vimeo_after = vimeo_raw | split: v.video_url.id | last | split: '?' | first | remove_first: '/'
                      assign vimeo_hash = vimeo_after | split: '/' | first
                    endif
                  -%}
                  {%- comment -%} Same treatment as the homepage video (section-vimeo-video): Vimeo's own UI is off and a single round play button sits on top. {%- endcomment -%}
                  <iframe src="https://player.vimeo.com/video/{{ v.video_url.id }}?{% if vimeo_hash != blank %}h={{ vimeo_hash }}&amp;{% endif %}badge=0&amp;autopause=0&amp;controls=0&amp;title=0&amp;byline=0&amp;portrait=0&amp;dnt=1" title="{{ v.title | default: product.title | escape }}" loading="lazy" allow="autoplay; fullscreen; picture-in-picture" allowfullscreen data-fpf-vimeo></iframe>
                  <button type="button" class="fpf__video-toggle" data-fpf-video-toggle aria-label="Play video">
                    <span class="fpf__video-play" aria-hidden="true">
                      <svg viewBox="0 0 24 24"><path d="M8 5v14l11-7z" fill="currentColor"/></svg>
                    </span>
                  </button>
                {%- endif -%}
              </div>
            {%- endif -%}
          {%- endif -%}
        {%- endfor -%}
        <div class="fpf__story">
          {%- if banner_fg != nil -%}
            <img class="fpf__story-fg" src="{{ banner_fg }}" alt="" width="573" height="573" loading="lazy">
          {%- endif -%}
          <div class="fpf__story-text">
            {{ logo_html }}
            {%- for block in section.blocks -%}
              {%- case block.type -%}
                {%- when 'heading' -%}
                  {%- if block.settings.text != blank -%}
                    <h2 class="fpf__heading" {{ block.shopify_attributes }}>{{ block.settings.text | escape }}</h2>
                  {%- endif -%}
                {%- when 'quote' -%}
                  <div class="fpf__quote" {{ block.shopify_attributes }}>
                    {%- if block.settings.quote != blank -%}
                      <p class="fpf__quote-text">{{ block.settings.quote | escape }}</p>
                    {%- endif -%}
                    {%- if block.settings.attribution != blank -%}
                      <p class="fpf__quote-by">{{ block.settings.attribution | escape }}</p>
                    {%- endif -%}
                  </div>
                {%- when 'rich_text' -%}
                  {%- comment -%} The description's paragraph is already under the bullets, so only explicit copy shows here. {%- endcomment -%}
                  {%- if block.settings.text != blank -%}
                    <div class="fpf__body" {{ block.shopify_attributes }}>{{ block.settings.text }}</div>
                  {%- endif -%}
              {%- endcase -%}
            {%- endfor -%}
          </div>
        </div>
      </div>
    {%- elsif is_split -%}
      <div class="fpf__feature fpf__feature--split">
        <div class="fpf__split">
          {%- if logo_html != blank -%}
            <div class="fpf__split-logo">{{ logo_html }}</div>
          {%- endif -%}
          <div class="fpf__split-text">
            {%- for block in section.blocks -%}
              {%- case block.type -%}
                {%- when 'heading' -%}
                  {%- if block.settings.text != blank -%}
                    <h2 class="fpf__heading" {{ block.shopify_attributes }}>{{ block.settings.text | escape }}</h2>
                  {%- endif -%}
                {%- when 'quote' -%}
                  <div class="fpf__quote" {{ block.shopify_attributes }}>
                    {%- if block.settings.quote != blank -%}
                      <p class="fpf__quote-text">{{ block.settings.quote | escape }}</p>
                    {%- endif -%}
                    {%- if block.settings.attribution != blank -%}
                      <p class="fpf__quote-by">{{ block.settings.attribution | escape }}</p>
                    {%- endif -%}
                  </div>
                {%- when 'rich_text' -%}
                  {%- assign body_html = block.settings.text | default: copy_html -%}
                  {%- if body_html != blank -%}
                    <div class="fpf__body" {{ block.shopify_attributes }}>{{ body_html }}</div>
                  {%- endif -%}
              {%- endcase -%}
            {%- endfor -%}
          </div>
        </div>
        {%- if banner != nil or banner_fg != nil -%}
          <div class="fpf__scene" style="{{ banner_vars }}">
            {%- if banner_fg != nil -%}
              <img class="fpf__scene-fg" src="{{ banner_fg }}" alt="" width="517" height="406" loading="lazy">
            {%- endif -%}
          </div>
        {%- endif -%}
      </div>
    {%- else -%}
    <div
      class="fpf__feature"
      style="{{ banner_vars }}"
    >
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'heading' -%}
            {%- if block.settings.text != blank -%}
              <h2 class="fpf__heading" {{ block.shopify_attributes }}>{{ block.settings.text | escape }}</h2>
            {%- endif -%}
          {%- when 'quote' -%}
            <div class="fpf__quote" {{ block.shopify_attributes }}>
              {%- if block.settings.quote != blank -%}
                <p class="fpf__quote-text">{{ block.settings.quote | escape }}</p>
              {%- endif -%}
              {%- if block.settings.attribution != blank -%}
                <p class="fpf__quote-by">{{ block.settings.attribution | escape }}</p>
              {%- endif -%}
            </div>
          {%- when 'partner_logo' -%}
            {{ logo_html }}
          {%- when 'rich_text' -%}
            {%- assign body_html = block.settings.text | default: copy_html -%}
            {%- if body_html != blank -%}
              <div class="fpf__body" {{ block.shopify_attributes }}>{{ body_html }}</div>
            {%- endif -%}
        {%- endcase -%}
      {%- endfor -%}
    </div>
    {%- endif -%}
  </div>
  <div class="fpf__reviews" style="max-width:1200px;margin:0 auto;padding:40px 20px;color:#222222;"><!-- Start of Judge.me code -->{% assign has_legacy = false %}{% if product.metafields.judgeme.widget.size > 20 %}{% assign has_legacy = true %}{% endif %}<div style='clear:both'></div><div id='judgeme_product_reviews' class='jdgm-widget jdgm-review-widget' data-product-title='{{ product.title | escape }}' data-id='{{ product.id }}' data-product-id='{{ product.id }}' data-widget='review' data-auto-install='false' data-shop-reviews-count='{{ shop.metafields.judgeme.shop_reviews_count | default: 0 | escape }}' data-entry-point='review_widget.js' data-entry-key='review-widget/main.js'>{% if has_legacy %}<div class='jdgm-legacy-widget-content' style='display: none;'>{{ product.metafields.judgeme.widget }}</div>{% endif %}</div>{% if product.metafields.judgeme.review_widget_data %}<script>jdgm.data ||= {}; jdgm.data.reviewWidget ||= {}; jdgm.data.reviewWidget[{{ product.id }}] = {{ product.metafields.judgeme.review_widget_data }}</script>{% endif %}<!-- End of Judge.me code --></div>
</section>

<script>
  (function () {
    var section = document.getElementById('fpf-{{ section.id }}');
    var iframe = section && section.querySelector('[data-fpf-vimeo]');
    if (!iframe) return;
    var frame = iframe.parentNode;
    var toggle = frame.querySelector('[data-fpf-video-toggle]');

    function init() {
      var player = new Vimeo.Player(iframe);
      function setPlaying(playing) {
        frame.classList.toggle('is-playing', playing);
        toggle.setAttribute('aria-label', playing ? 'Pause video' : 'Play video');
      }
      player.on('play', function () { setPlaying(true); });
      player.on('pause', function () { setPlaying(false); });
      player.on('ended', function () { setPlaying(false); });
      toggle.addEventListener('click', function () {
        player.getPaused().then(function (paused) { return paused ? player.play() : player.pause(); });
      });
    }

    if (window.Vimeo && window.Vimeo.Player) return init();
    var api = document.querySelector('script[src="https://player.vimeo.com/api/player.js"]');
    if (!api) {
      api = document.createElement('script');
      api.src = 'https://player.vimeo.com/api/player.js';
      document.head.appendChild(api);
    }
    api.addEventListener('load', init);
  })();
</script>

{%- if s.show_related -%}
  <div class="section_related-products">
    <div class="padding-global">
      <div class="container-large">
        <div class="padding-section-medium">
          <div class="related-products_component">
            <h2 class="product-features_heading">{{ s.related_heading }}</h2>
            <div class="related-products_wrapper">
              <div class="w-dyn-list" shopify-recommended="{{ product.id }}">
                <div role="list" class="collection-list-2 w-dyn-items"></div>
                <div class="w-dyn-empty" style="display: none;"><div>No items found.</div></div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
{%- endif -%}

