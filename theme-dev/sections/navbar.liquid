{% schema %}
{
  "name": "Navbar",
  "tag": "div",
  "class": "navbar w-nav",
  "settings": [
    {
      "id": "coffee_link",
      "label": "Coffee link",
      "type": "url",
      "info": "Defaults to the coffee collection."
    },
    {
      "id": "account_portal",
      "label": "Account Portal",
      "type": "url"
    },
    {
      "type": "link_list",
      "id": "main_nav_menu",
      "label": "Main Nav Menu",
      "info": "Shown between Coffee and Join the Club. Items linking to the Join the Club page are skipped.",
      "default": "main-menu"
    },
    {
      "type": "text",
      "id": "join_club_text",
      "label": "Join the Club label",
      "default": "Join The Club"
    },
    {
      "id": "join_club_link",
      "label": "Join the Club link",
      "type": "url",
      "info": "Defaults to /pages/subscribe-save."
    },
    {
      "type": "header",
      "content": "Featured links (desktop, right side)"
    },
    {
      "type": "text",
      "id": "featured_blend_text",
      "label": "Featured Blend label",
      "default": "Featured Blend"
    },
    {
      "type": "url",
      "id": "featured_blend_link",
      "label": "Featured Blend link",
      "info": "Leave empty to use the Featured Blends collection."
    },
    {
      "type": "text",
      "id": "pray_first_text",
      "label": "Pray First label",
      "default": "Pray First"
    },
    {
      "id": "pray_first_link",
      "label": "Pray First link",
      "type": "url",
      "info": "Defaults to the Prayer Wall page."
    }
  ]
}
{% endschema %}