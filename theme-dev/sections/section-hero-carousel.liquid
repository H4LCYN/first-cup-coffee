
<div class="site-redesign-26 hero-carousel-2026">
  <div class="swiper hero-carousel-2026_swiper" data-autoplay-speed="{{ section.settings.autoplay_speed | times: 1000 }}">
    <div class="swiper-wrapper">
      {%- for block in section.blocks -%}
        <div class="swiper-slide hero-carousel-2026_slide is-text-{{ block.settings.text_position }}" {{ block.shopify_attributes }}>
          {%- if block.settings.image != blank -%}
            <img
              src="{{ block.settings.image | img_url: '1920x' }}"
              srcset="{{ block.settings.image | img_url: '768x' }} 768w, {{ block.settings.image | img_url: '1440x' }} 1440w, {{ block.settings.image | img_url: '1920x' }} 1920w"
              sizes="100vw"
              alt="{{ block.settings.image.alt | escape }}"
              loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"
              class="hero-carousel-2026_image"
            >
          {%- elsif block.settings.fallback_image != blank -%}
            <img
              src="{{ block.settings.fallback_image | asset_url }}"
              alt=""
              loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"
              class="hero-carousel-2026_image"
            >
          {%- endif -%}
          <div class="hero-carousel-2026_grain"></div>
          <div class="hero-carousel-2026_scrim"></div>
          <div class="hero-carousel-2026_content">
            <div class="hero-carousel-2026_heading">{{ block.settings.heading }}</div>
            {%- if block.settings.button_text != blank -%}
              <a href="{{ block.settings.button_link }}" class="hero-carousel-2026_button">{{ block.settings.button_text }}</a>
            {%- endif -%}
          </div>
        </div>
      {%- endfor -%}
    </div>
    <div class="swiper-pagination hero-carousel-2026_pagination"></div>
  </div>
</div>

<style>
  .site-redesign-26.hero-carousel-2026 {
    position: relative;
  }

  .hero-carousel-2026_swiper {
    width: 100%;
    aspect-ratio: 1440 / 576;
    min-height: 320px;
  }

  .hero-carousel-2026_slide {
    position: relative;
    overflow: hidden;
    background-color: var(--dark-grey);
  }

  .hero-carousel-2026_image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero-carousel-2026_grain {
    position: absolute;
    inset: 0;
    background-image: url('{{ "hero-carousel-grain-overlay.png" | asset_url }}');
    background-size: cover;
    background-position: center;
    mix-blend-mode: lighten;
    opacity: 0.5;
    pointer-events: none;
  }

  .hero-carousel-2026_scrim {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .hero-carousel-2026_slide.is-text-left .hero-carousel-2026_scrim {
    background: linear-gradient(to right, rgba(0, 0, 0, 0.75) 0%, rgba(0, 0, 0, 0.45) 35%, rgba(0, 0, 0, 0) 70%);
  }

  .hero-carousel-2026_slide.is-text-right .hero-carousel-2026_scrim {
    background: linear-gradient(to left, rgba(0, 0, 0, 0.75) 0%, rgba(0, 0, 0, 0.45) 35%, rgba(0, 0, 0, 0) 70%);
  }

  .hero-carousel-2026_content {
    position: relative;
    z-index: 1;
    height: 100%;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 24px;
    padding: 0 6vw;
    max-width: 640px;
  }

  .hero-carousel-2026_slide.is-text-right .hero-carousel-2026_content {
    margin-left: auto;
    align-items: flex-end;
    text-align: right;
  }

  .hero-carousel-2026_heading {
    font-family: Avenirnextltpro, sans-serif;
    font-weight: 700;
    font-size: 48px;
    line-height: 1.1;
    color: #fff;
    text-transform: uppercase;
  }

  .hero-carousel-2026_heading p {
    margin: 0;
  }

  .hero-carousel-2026_button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: fit-content;
    background-color: #ff7800;
    border-radius: 3px;
    padding: 12px 28px;
    font-family: Avenirnextltpro, sans-serif;
    font-weight: 700;
    font-size: 21px;
    color: #000;
    text-decoration: none;
  }

  .hero-carousel-2026_pagination {
    position: absolute;
    bottom: 24px;
    left: 0;
    right: 0;
    z-index: 2;
    display: flex;
    justify-content: center;
    gap: 8px;
  }

  .hero-carousel-2026 .swiper-pagination-bullet {
    background: #fff;
    opacity: 0.5;
    width: 10px;
    height: 10px;
    margin: 0 !important;
  }

  .hero-carousel-2026 .swiper-pagination-bullet-active {
    opacity: 1;
    background: var(--butterscotch);
  }

  @media screen and (max-width: 767px) {
    .hero-carousel-2026_swiper {
      aspect-ratio: 1 / 1;
      min-height: 320px;
    }

    /* Figma's 600x600 mobile frames center text regardless of the
       desktop left/right position, and anchor it toward the bottom
       with a bottom scrim rather than a side scrim. */
    .hero-carousel-2026_scrim,
    .hero-carousel-2026_slide.is-text-left .hero-carousel-2026_scrim,
    .hero-carousel-2026_slide.is-text-right .hero-carousel-2026_scrim {
      background: linear-gradient(to top, rgba(0, 0, 0, 0.8) 0%, rgba(0, 0, 0, 0.5) 25%, rgba(0, 0, 0, 0) 55%);
    }

    .hero-carousel-2026_content,
    .hero-carousel-2026_slide.is-text-right .hero-carousel-2026_content {
      margin-left: 0;
      max-width: 100%;
      align-items: center;
      text-align: center;
      justify-content: flex-end;
      padding-bottom: 48px;
    }

    .hero-carousel-2026_heading {
      font-size: 26px;
    }

    .hero-carousel-2026_button {
      font-size: 17px;
      padding: 10px 22px;
    }
  }
</style>

<script>var currentSection = document.currentScript.closest('.shopify-section');currentSection.setAttribute("class","section_hero-carousel site-redesign-26");</script>

{% schema %}
{
  "name": "Section - Hero Carousel",
  "tag": "section",
  "class": "section_hero-carousel",
  "settings": [
    {
      "type": "range",
      "id": "autoplay_speed",
      "label": "Seconds per slide",
      "min": 3,
      "max": 12,
      "step": 1,
      "default": 6
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Background image"
        },
        {
          "type": "text",
          "id": "fallback_image",
          "label": "Fallback photo filename (asset, used only if no image is picked above)",
          "info": "Advanced: filename of a theme asset, e.g. hero-carousel-slide-1.jpg"
        },
        {
          "type": "richtext",
          "id": "heading",
          "label": "Heading",
          "default": "<p>Quality Coffee. Bettering Lives. Building Community.</p>"
        },
        {
          "type": "select",
          "id": "text_position",
          "label": "Text position",
          "options": [
            { "value": "left", "label": "Left" },
            { "value": "right", "label": "Right" }
          ],
          "default": "left"
        },
        {
          "type": "text",
          "id": "button_text",
          "label": "Button text",
          "default": "Get Your First Cup"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Button link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Section - Hero Carousel",
      "blocks": [
        {
          "type": "slide",
          "settings": {
            "heading": "<p>Quality Coffee. Bettering Lives. Building Community.</p>",
            "text_position": "left",
            "button_text": "Get Your First Cup"
          }
        },
        {
          "type": "slide",
          "settings": {
            "heading": "<p>Buzz, Neil, George and now, you.</p>",
            "text_position": "left",
            "button_text": "Get Your First Cup"
          }
        },
        {
          "type": "slide",
          "settings": {
            "heading": "<p>Roasted in Texas. Built for America.</p>",
            "text_position": "left",
            "button_text": "Get Your First Cup"
          }
        },
        {
          "type": "slide",
          "settings": {
            "heading": "<p>Named for the firsts. Brewed for the next.</p>",
            "text_position": "right",
            "button_text": "Get Your First Cup"
          }
        }
      ]
    }
  ]
}
{% endschema %}
