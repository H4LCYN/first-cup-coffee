
      <div class="navbar__container w-container">
        <div class="col md-no-padding">
          <div class="flex">
            <a href="{{ routes.root_url }}" class="brand-link w-nav-brand">{%- if section.settings.brand_logo == nil -%}<img src="{{ 'e-coffee-logo.svg' | asset_url }}" loading="lazy" alt="" class="brand-image">{%- else -%}<img src="{{ section.settings.brand_logo.src | img_url: 'master' }}" loading="lazy" alt="{{ section.settings.brand_logo.alt | escape }}" class="brand-image">{%- endif -%}</a>
          </div>
        </div>
        <nav role="navigation" class="col md-no-padding w-nav-menu">
          <a data-w-id="6a596877-9da3-dc48-eb34-fcaea8a3d408" href="#" class="nav-link w-inline-block"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" class="icon is-black">
              <path d="M0 0h24v24H0z" fill="none"></path>
              <path d="M15.5 14h-.79l-.28-.27C15.41 12.59 16 11.11 16 9.5 16 5.91 13.09 3 9.5 3S3 5.91 3 9.5 5.91 16 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z" fill="currentColor"></path>
            </svg></a>
        </nav>
        <nav role="navigation" class="col md-no-padding w-nav-menu">
          <div class="flex justify-end">
            <a href="{{ routes.account_register_url }}" class="nav-link w-inline-block"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" class="icon">
                <path d="M0 0h24v24H0V0z" fill="none"></path>
                <path d="M12 6c1.1 0 2 .9 2 2s-.9 2-2 2-2-.9-2-2 .9-2 2-2m0 10c2.7 0 5.8 1.29 6 2H6c.23-.72 3.31-2 6-2m0-12C9.79 4 8 5.79 8 8s1.79 4 4 4 4-1.79 4-4-1.79-4-4-4zm0 10c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z" fill="currentColor"></path>
              </svg></a>
          </div>
        </nav>
        <div class="w-nav-button">
          <div class="w-icon-nav-menu"></div>
        </div>
        <div class="search-container">
          <div class="search-close"></div>
          <form action="/search" class="search w-form" method="get" role="search"><input class="search-field w-input" maxlength="256" name="q" placeholder="{{ 'tn2774f8a2' | t }}" type="search" id="search" required=""><input type="submit" class="btn-stretched w-button" value="{{ 'tn6ca0ae38' | t }}"></form>
        </div>
        <div data-open-product="" data-wf-cart-type="rightDropdown" data-wf-cart-query="" data-wf-page-link-href-prefix="" class="w-commerce-commercecartwrapper" data-node-type="commerce-cart-wrapper" udy-collection="cart">
          <a class="w-commerce-commercecartopenlink cart-button w-inline-block" role="button" aria-haspopup="dialog" aria-label="Open cart" data-node-type="commerce-cart-open-link" href="#"><svg xmlns="http://www.w3.org/2000/svg" enable-background="new 0 0 24 24" viewBox="0 0 24 24" class="icon">
              <g>
                <rect fill="none" height="24" width="24"></rect>
                <path d="M18 6h-2c0-2.21-1.79-4-4-4S8 3.79 8 6H6c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2zm-6-2c1.1 0 2 .9 2 2h-4c0-1.1.9-2 2-2zm6 16H6V8h2v2c0 .55.45 1 1 1s1-.45 1-1V8h4v2c0 .55.45 1 1 1s1-.45 1-1V8h2v12z" fill="currentColor"></path>
              </g>
            </svg>
            <div class="w-commerce-commercecartopenlinkcount cart-quantity">{{ cart.item_count }}</div>
          </a>
          <div style="display:none" class="w-commerce-commercecartcontainerwrapper w-commerce-commercecartcontainerwrapper--cartType-rightDropdown" data-node-type="commerce-cart-container-wrapper">
            <div data-node-type="commerce-cart-container" role="dialog" class="w-commerce-commercecartcontainer">
              <div class="w-commerce-commercecartheader mini-cart-header">
                <h5 class="w-commerce-commercecartheading">{{ 'tn77ee8913' | t }}</h5>
                <a class="w-commerce-commercecartcloselink w-inline-block" role="button" aria-label="Close cart" data-node-type="commerce-cart-close-link"><svg class="icon" width="16px" height="16px" viewBox="0 0 16 16">
                    <g stroke="none" stroke-width="1" fill="none" fill-rule="evenodd">
                      <g fill-rule="nonzero" fill="#333333">
                        <polygon points="6.23223305 8 0.616116524 13.6161165 2.38388348 15.3838835 8 9.76776695 13.6161165 15.3838835 15.3838835 13.6161165 9.76776695 8 15.3838835 2.38388348 13.6161165 0.616116524 8 6.23223305 2.38388348 0.616116524 0.616116524 2.38388348 6.23223305 8"></polygon>
                      </g>
                    </g>
                  </svg></a>
              </div>
              <div class="w-commerce-commercecartformwrapper">
                <form style="display:none" class="w-commerce-commercecartform" data-node-type="commerce-cart-form">
                  <script type="text/x-wf-template" id="wf-template-961ce596-2126-69a5-110f-5e4be75d0bd0"><div data-node-type="cart-item" template-part-bind="961ce596-2126-69a5-110f-5e4be75d0bd1" class="w-commerce-commercecartitem"><img data-node-type="cart-item-image" template-part-bind="961ce596-2126-69a5-110f-5e4be75d0bd2" class="w-commerce-commercecartitemimage" src="<%= it.image %>"><div data-node-type="cart-item-info" template-part-bind="961ce596-2126-69a5-110f-5e4be75d0bd3" class="w-commerce-commercecartiteminfo"><div data-node-type="cart-product-name" class="p-medium text-weight-normal w-commerce-commercecartproductname" template-part-bind="961ce596-2126-69a5-110f-5e4be75d0bd4"><%= it.title %></div><div class="product-price" template-part-bind="961ce596-2126-69a5-110f-5e4be75d0bd5"><%= it.price %></div><ul template-part-bind="961ce596-2126-69a5-110f-5e4be75d0bd6" class="w-commerce-commercecartoptionlist"><% Object.entries(it.properties).forEach( data =>  { %><li data-node-type="cart-option-list-item"><span data-node-type="cart-option-list-item-label" template-part-bind="961ce596-2126-69a5-110f-5e4be75d0bd8"><%= data[0] %></span><span data-node-type="span">{{ 't726' | t }}</span><span data-node-type="cart-option-list-item-value" template-part-bind="961ce596-2126-69a5-110f-5e4be75d0bdb"><%= data[1] %></span></li><% }) %></ul><a data-node-type="cart-remove-link" href="#" role="button" template-part-bind="961ce596-2126-69a5-110f-5e4be75d0bdc" data-product-id="<%= it.id %>"><div class="p-small text-color-gray2">{{ 'tn6e501b5c' | t }}</div></a></div><input class="w-commerce-commercecartquantity" name="<%= it.id %>" type="number" min="0" min="1" value="<%= it.quantity %>" data-node-type="cart-quantity"></div></script>
                  <div class="w-commerce-commercecartlist mini-cart-list" data-wf-collection="database.commerceOrder.userItems" data-wf-template-id="wf-template-961ce596-2126-69a5-110f-5e4be75d0bd0"></div>
                  <div class="w-commerce-commercecartfooter mini-cart-footer">
                    <div aria-atomic="true" aria-live="polite" class="w-commerce-commercecartlineitem">
                      <div class="text-color-gray2">{{ 'tn76f396dc' | t }}</div>
                      <div class="w-commerce-commercecartordervalue text-weight-normal">{{ cart.items_subtotal_price | money }}</div>
                    </div>
                    <div>
                      <div data-node-type="commerce-cart-quick-checkout-actions">{{ content_for_additional_checkout_buttons }}</div>
                      <a href="/checkout" value="Continue to Checkout" class="w-commerce-commercecartcheckoutbutton btn-stretched secondary" data-loading-text="{{ 't498bd87e' | t }}" data-node-type="cart-checkout-button">{{ 'tn7941186e' | t }}</a>
                    </div>
                  </div>
                </form>
                <div class="w-commerce-commercecartemptystate">
                  <div aria-label="This cart is empty" aria-live="polite">{{ 't3d503d2b' | t }}</div>
                </div>
                <div aria-live="assertive" style="display:none" data-node-type="commerce-cart-error" class="w-commerce-commercecarterrorstate">
                  <div class="w-cart-error-msg" data-w-cart-quantity-error="Product is not available in this quantity." data-w-cart-general-error="Something went wrong when adding this item to the cart." data-w-cart-checkout-error="Checkout is disabled on this site." data-w-cart-cart_order_min-error="The order minimum was not met. Add more items to your cart to continue." data-w-cart-subscription_error-error="Before you purchase, please use your email invite to verify your address so we can send order updates.">{{ 'tn1c765d0d' | t }}</div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    

<script>var currentSection = document.currentScript.closest('.shopify-section');currentSection.setAttribute("data-animation","default");currentSection.setAttribute("data-collapse","none");currentSection.setAttribute("data-duration","400");currentSection.setAttribute("data-easing","ease");currentSection.setAttribute("data-easing2","ease");currentSection.setAttribute("role","banner");currentSection.setAttribute("class","navbar-old w-nav");</script>
        
