
<div class="site-redesign-26 split-cta-2026">
  <div class="split-cta-2026_card">
    {%- for block in section.blocks -%}
      <div class="split-cta-2026_panel is-{{ block.settings.color }}" {{ block.shopify_attributes }}>
        <div class="split-cta-2026_photo">
          {%- if block.settings.image != blank -%}
            <img src="{{ block.settings.image | img_url: '1200x' }}" alt="{{ block.settings.image.alt | escape }}" loading="lazy" decoding="async" class="split-cta-2026_image">
          {%- elsif block.settings.fallback_image != blank -%}
            <img src="{{ block.settings.fallback_image | asset_url }}" alt="" loading="lazy" decoding="async" class="split-cta-2026_image">
          {%- endif -%}
        </div>
        <div class="split-cta-2026_content">
          <h2 class="split-cta-2026_heading">{{ block.settings.heading | escape }}</h2>
          {%- if block.settings.text != blank -%}
            <p class="split-cta-2026_text">{{ block.settings.text | escape }}</p>
          {%- endif -%}
          {%- if block.settings.button_text != blank -%}
            <a href="{{ block.settings.button_link }}" class="split-cta-2026_button">{{ block.settings.button_text | escape }}</a>
          {%- endif -%}
        </div>
      </div>
    {%- endfor -%}
  </div>
</div>

<style>
  /* Two side-by-side photo + colour panels in one rounded card (Figma
     "Frame 340", node 244:2229 on the Locations page). */
  section.site-redesign-26.section_split-cta {
    padding-bottom: 100px;
  }

  .split-cta-2026_card {
    display: flex;
    max-width: 1146px;
    margin: 0 auto;
    border-radius: var(--desktop-border-radius);
    overflow: hidden;
  }

  .split-cta-2026_panel {
    flex: 1 1 0;
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .split-cta-2026_panel.is-green {
    background-color: var(--uniform-green);
  }

  .split-cta-2026_panel.is-red {
    background-color: var(--firebrick);
  }

  .split-cta-2026_photo {
    position: relative;
    aspect-ratio: 573 / 318;
    overflow: hidden;
  }

  .split-cta-2026_image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 30%;
  }

  .split-cta-2026_content {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 37px;
    padding: 46px 64px 58px;
  }

  .split-cta-2026_heading {
    margin: 0;
    font-family: Avenirnextltpro, sans-serif;
    font-weight: 700;
    font-size: 48px;
    line-height: 1;
    color: #fff;
    text-transform: uppercase;
  }

  .split-cta-2026_text {
    flex: 1;
    margin: 0;
    max-width: 416px;
    font-family: Roboto, sans-serif;
    font-weight: 400;
    font-size: 20px;
    line-height: 26px;
    color: #fff;
  }

  .split-cta-2026_button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 216px;
    min-height: 53px;
    padding: 8px 23px;
    background-color: var(--butterscotch);
    border-radius: 2px;
    font-family: Avenirnextltpro, sans-serif;
    font-weight: 700;
    font-size: 18px;
    color: #000;
    text-align: center;
    text-transform: uppercase;
    text-decoration: none;
    transition: opacity 0.2s;
  }

  .split-cta-2026_button:hover {
    opacity: 0.85;
  }

  @media screen and (max-width: 991px) {
    .split-cta-2026_content {
      padding: 36px 36px 44px;
    }

    .split-cta-2026_heading {
      font-size: 36px;
    }

    .split-cta-2026_text {
      font-size: 18px;
      line-height: 24px;
    }
  }

  @media screen and (max-width: 767px) {
    section.site-redesign-26.section_split-cta {
      padding-bottom: 60px;
    }

    .split-cta-2026_card {
      flex-direction: column;
      border-radius: 16px;
    }

    .split-cta-2026_content {
      gap: 20px;
      padding: 28px 24px 36px;
    }

    .split-cta-2026_heading {
      font-size: 32px;
    }

    .split-cta-2026_button {
      min-width: 0;
      min-height: 48px;
      font-size: 16px;
    }
  }
</style>

<script>var currentSection = document.currentScript.closest('.shopify-section');currentSection.setAttribute("class","section_split-cta site-redesign-26");</script>

{% schema %}
{
  "name": "Section - Split CTA",
  "tag": "section",
  "class": "section_split-cta",
  "max_blocks": 2,
  "blocks": [
    {
      "type": "panel",
      "name": "Panel",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Photo"
        },
        {
          "type": "text",
          "id": "fallback_image",
          "label": "Fallback photo filename (asset, used only if no photo is picked above)",
          "info": "Advanced: filename of a theme asset, e.g. 2q6a8648-1.webp"
        },
        {
          "type": "select",
          "id": "color",
          "label": "Panel colour",
          "options": [
            { "value": "green", "label": "Uniform green" },
            { "value": "red", "label": "Firebrick red" }
          ],
          "default": "green"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Heading"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Paragraph"
        },
        {
          "type": "text",
          "id": "button_text",
          "label": "Button text"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Button link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Section - Split CTA",
      "blocks": [
        { "type": "panel", "settings": { "color": "green", "heading": "Order Ahead" } },
        { "type": "panel", "settings": { "color": "red", "heading": "Reserve a Room" } }
      ]
    }
  ]
}
{% endschema %}
