{%- assign headerSnippetPath = "header-password" -%}{%- assign wfPage = "654d36a6d6abfe37729082b0" -%}{%- assign bodyClasses = "" -%}
  <div class="page-wrapper">
    {%- render 'google-icons' -%}
    <header class="header">
      {%- section 'navbar' -%}
    </header>
    <main class="main-wrapper">
      <section class="section container form">
        <div class="form-container w-form">
          <h4>{{ 't462ff49' | t }}</h4>
          <div class="spacer-3"></div>
          {%- form "customer_login",  class: "form" -%}<label for="email" class="form-label">{{ 't3ff5b7c' | t }}</label><input class="form-field w-input" maxlength="256" name="customer[email]" data-name="Email" placeholder="" type="email" id="email"><label for="Password" class="form-label">{{ 't4c641ebb' | t }}</label><input class="form-field w-input" maxlength="256" name="customer[password]" data-name="Password 4" placeholder="" type="password" id="Password-4" required=""><input type="submit" data-wait="Please wait..." class="btn-stretched w-button" value="{{ 'tn6bbed3c8' | t }}">
            <div class="w-users-userformfooter form-footer space-between">
              <a href="{{ routes.account_register_url }}" class="form-link">{{ 'tn204ff442' | t }}</a>
              <a href="{{ pages["reset-password"].url }}" class="form-link">{{ 't2822d26c' | t }}</a>
            </div>
          {%- assign form_success = form.posted_successfully? -%}{%- assign form_errors = form.errors -%}{%- render "form-general-script", form_success: form_success, form_errors: form_errors -%}{%- endform -%}
          <div class="w-form-done  {% if form_success %}form-posted-successfully{% endif %}">
            <div>{{ 't5a0ea5a1' | t }}</div>
          </div>
          {%- unless form_success -%}<div class="w-form-fail  {% if form.errors %}form-has-errors{% endif %}">
            <div>{%- render "form-errors", form_errors: form_errors -%}</div>
          </div>{%- endunless -%}
        </div>
      </section>
      {%- section 'footer' -%}
    </main>
    {%- section 'template-footer' -%}
  </div>
  <script src="https://d3e54v103j8qbb.cloudfront.net/js/jquery-3.5.1.min.dc5e7f18c8.js?site=654ae336a6e86029761320fd" type="text/javascript" integrity="sha256-9/aliU8dGd2tb6OSsuzixeV4y/faTqgFtohetphbbj0=" crossorigin="anonymous"></script>
  <script src="{{ 'first-cup-coffee.js' | asset_url }}" type="text/javascript"></script>
  <script>
  function megaBack() {
  var x = document.getElementsByClassName("mega-menu");
    $('.menu-button').on('click', function(evt) {
  if (window.getComputedStyle(x).display === "block") {
    setTimeout(function() {
        $('.mega-menu_mobile-close').triggerHandler('click');
    }, 005);
});
  }
}
</script>
  <script>
$('.input-number-increment').click(function() {
  var $input = $(this).parents('.input-number-group').find('.input-number');
  var val = parseInt($input.val(), 10);
  $input.val(val + 1);
});
$('.input-number-decrement').click(function() {
  var $input = $(this).parents('.input-number-group').find('.input-number');
  var val = parseInt($input.val(), 10);
  $input.val(Math.max(val - 1, 1));
})
</script>

