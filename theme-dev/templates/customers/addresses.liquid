            <div class="div-block-3"></div><input type="submit" data-wait="Please wait..." button="delete" class="btn-stretched secondary w-button" value="{{ 't6104467f' | t }}"><input type="submit" data-wait="Please wait..." class="btn-stretched w-button" value="{{ 'tn47b11822' | t }}">
          {%- assign form_success = form.posted_successfully? -%}{%- assign form_errors = form.errors -%}{%- render "form-general-script", form_success: form_success, form_errors: form_errors -%}<script>if (Shopify) {

var hideElementId = 'address_province_{{form.id}}';
var provinceSelect = document.getElementById('address_province_{{form.id}}');
if (provinceSelect.closest('[container="province"]')) {
    provinceSelect.closest('[container="province"]').id = "address_province_container_{{form.id}}";
    hideElementId = "address_province_container_{{form.id}}";
}
new Shopify.CountryProvinceSelector(
    'address_country_{{form.id}}',
    'address_province_{{form.id}}',
    {
        hideElement: hideElementId
    }
);

document.querySelectorAll('#address_form_{{form.id}} [button="delete"]').forEach( button => {
                            
    button.addEventListener('click', function(evt) {
     var target = button.closest('form').action;
     var confirmMessage = evt.target.dataset.confirmMessage;
 
     console.log(target);
 
     evt.preventDefault();
     evt.stopPropagation();
     // eslint-disable-next-line no-alert
     if (
       confirm(
         confirmMessage || 'Are you sure you wish to delete this address?'
       )
     ) {
       Shopify.postLink(target, {
         parameters: { _method: 'delete' }
       });
     }
   });
                         
});

}</script>{%- endform -%}
