<script>
  document.querySelector("input[type='submit'].subscription-add-to-cart").addEventListener('click', async () => {
    var bundleId = document.querySelector('#wf-form-subscription-box-form').getAttribute('data-bundle-id');
    var selectedBundleVariantId = document
      .querySelector("input[name='product-count']:checked", '#wf-form-subscription-box-form')
      .getAttribute('data-bundle-variant-id');
    var sellingPlan = document
      .querySelector("input[name='Deliver-Every']:checked", '#wf-form-subscription-box-form')
      .getAttribute('data-selling-plan-id');
    var productId = '{{ product.id }}';
    var selectedVariant = '{{ product.selected_or_first_available_variant.id }}';
    var collectionId = document.querySelector('#wf-form-subscription-box-form').getAttribute('data-collection-id');
    var quantity = parseInt(
      document.querySelector("input[name='product-count']:checked", '#wf-form-subscription-box-form').value
    );
    var productName = $('.desktop-product-header .product_name').text();
    const bundleProductData = {
      variantId: selectedBundleVariantId, //ID of the custom coffee box variant (i.e. number of bags)
      productId: bundleId, //ID of the custom coffee box
      sellingPlan: sellingPlan,
    };
    // This creates the bundle object containing the selections
    // we'll pass this object to `getBundleId`.
    const bundle = {
      externalVariantId: bundleProductData.variantId,
      externalProductId: bundleProductData.productId,
      selections: [
        {
          collectionId: collectionId,
          externalProductId: productId,
          externalVariantId: selectedVariant,
          quantity: quantity,
        },
      ],
    };
    const rbId = await recharge.bundle.getBundleId(bundle);
    // Adds the value directly to the cart
    const cartData = {
      items: [
        {
          id: bundleProductData.variantId,
          quantity: 1,
          selling_plan: bundleProductData.sellingPlan,
          properties: { Contents: quantity + 'X ' + productName, _rb_id: rbId },
        },
      ],
    };
    await fetch(window.Shopify.routes.root + 'cart/add.js', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(cartData),
    });
    window.location.href = '/cart';
  });
</script>

