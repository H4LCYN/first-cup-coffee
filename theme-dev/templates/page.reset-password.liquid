{%- assign headerSnippetPath = "header-password" -%}{%- assign wfPage = "654d36a6d6abfe37729082b7" -%}{%- assign bodyClasses = "" -%}
  <div class="page-wrapper">
    {%- render 'google-icons' -%}
    <header class="header">
      {%- section 'navbar' -%}
    </header>
    <main class="main-wrapper">
      <section class="section container form">
        <div class="w-users-userresetpasswordformwrapper form-container">
          <div tabindex="-1" class="w-users-userformsuccessstate w-form-success">
            <div class="w-users-userformheader"><img src="https://d3e54v103j8qbb.cloudfront.net/img/email-72.67fa6be437.svg" loading="lazy" alt="">
              <h2>{{ 't6bfe9c32' | t }}</h2>
            </div>
            <p>{{ 'tn13a89bf' | t }}</p>
          </div>
          {%- form "recover_customer_password",  class: "form" -%}<form class="form" method="post" data-wf-user-form-type="resetPassword">
            <h4 class="text-color-white">{{ 't2bfd368c' | t }}</h4>
            <div class="spacer-3"></div><label for="wf-reset-password-email" class="form-field text-color-white">{{ 't3ff5b7c' | t }}</label><input maxlength="256" placeholder="" name="email" id="wf-reset-password-email" aria-describedby="wf-reset-password-paragraph" class="form-label w-input" type="email" autocomplete="username" required="" data-wf-user-form-input-type="email"><input type="submit" data-wait="Please wait..." class="w-users-userformbutton btn-stretched w-button" value="{{ 't2bfd368c' | t }}">
          {%- assign form_success = form.posted_successfully? -%}{%- assign form_errors = form.errors -%}{%- render "form-general-script", form_success: form_success, form_errors: form_errors -%}</form>{%- endform -%}
          {%- unless form_success -%}<div style="display:none" data-wf-user-form-error="true" class="w-users-userformerrorstate w-form-fail  {% if form.errors %}form-has-errors{% endif %}">
            <div class="user-form-error-msg" wf-reset-pw-form-general-error-error="There was an error resetting your password. Please try again, or contact us if you continue to have problems.">{%- render "form-errors", form_errors: form_errors -%}</div>
          </div>{%- endunless -%}
        </div>
      </section>
      {%- section 'footer' -%}
    </main>
  </div>
  <script src="https://d3e54v103j8qbb.cloudfront.net/js/jquery-3.5.1.min.dc5e7f18c8.js?site=654ae336a6e86029761320fd" type="text/javascript" integrity="sha256-9/aliU8dGd2tb6OSsuzixeV4y/faTqgFtohetphbbj0=" crossorigin="anonymous"></script>
  <script src="{{ 'first-cup-coffee.js' | asset_url }}" type="text/javascript"></script>
  <script>
  function megaBack() {
  var x = document.getElementsByClassName("mega-menu");
    $('.menu-button').on('click', function(evt) {
  if (window.getComputedStyle(x).display === "block") {
    setTimeout(function() {
        $('.mega-menu_mobile-close').triggerHandler('click');
    }, 005);
});
  }
}
</script>
  <script>
$('.input-number-increment').click(function() {
  var $input = $(this).parents('.input-number-group').find('.input-number');
  var val = parseInt($input.val(), 10);
  $input.val(val + 1);
});
$('.input-number-decrement').click(function() {
  var $input = $(this).parents('.input-number-group').find('.input-number');
  var val = parseInt($input.val(), 10);
  $input.val(Math.max(val - 1, 1));
})
</script>

