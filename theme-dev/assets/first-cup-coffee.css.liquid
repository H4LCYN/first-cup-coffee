  --uniform-green: {{settings.color_uniform_green}};
  --butterscotch: {{settings.color_butterscotch}};
  --gray-4: {{settings.color_gray_4}};
  --first-cup-charcoal: {{settings.color_first_cup_charcoal}};
  --gray-3: {{settings.color_gray_3}};
  --firebrick: {{settings.color_firebrick}};
  --golden-brown: {{settings.color_golden_brown}};
  --burnt-umber: {{settings.color_burnt_umber}};
