e=\"commerce-cart-form\">\n                        <script type=\"text/x-wf-template\" id=\"wf-template-a39490a8-b5f0-903b-4b49-2d852812f939\"><div data-node-type=\"cart-item\" class=\"cart-item w-commerce-commercecartitem\" template-part-bind=\"a39490a8-b5f0-903b-4b49-2d852812f93a\"><% if (it.properties.Contents) { %><div class=\"fcbox-line\"><% } %><img data-node-type=\"cart-item-image\" class=\"minicart-img w-commerce-commercecartitemimage\" template-part-bind=\"a39490a8-b5f0-903b-4b49-2d852812f93b\" src=\"<%= it.image %>\"><div data-node-type=\"cart-item-info\" class=\"minicart_prod-info-wrapper w-commerce-commercecartiteminfo\" template-part-bind=\"a39490a8-b5f0-903b-4b49-2d852812f93c\"><div data-node-type=\"cart-product-name\" class=\"p-medium is-minicart w-commerce-commercecartproductname\" template-part-bind=\"a39490a8-b5f0-903b-4b49-2d852812f93d\"><% if (it.properties.Contents) { %><%= it.product_title %> - <%= it.variant_title %><% if (it.selling_plan_allocation) { %> - <%= it.selling_plan_allocation.selling_plan.name.split('every ').pop() %><% } %><% } else { %><%= it.title %><% } %></div><% if (it.properties.Contents) { %><ul class=\"fcbox-line__items\" data-box-line=\"<%= it.id %>\"><% it.properties.Contents.split(/, (?=\\d+X )/).forEach(c => { %><li><%= c %></li><% }) %></ul><div class=\"fcbox-line__actions\"><button type=\"button\" class=\"fcbox-edit\" data-box-open=\"\" data-box-line-variant=\"<%= it.variant_id %>\">Edit box</button><a data-node-type=\"cart-remove-link\" href=\"#\" role=\"button\" data-product-id=\"<%= it.id %>\" class=\"fcbox-edit fcbox-edit--remove fa-icon\" aria-label=\"Remove box\">{{ 'tf2ed' | t }}</a></div><% } else { %><ul template-part-bind=\"a39490a8-b5f0-903b-4b49-2d852812f93f\" class=\"w-commerce-commercecartoptionlist\"><% Object.entries(it.properties).forEach( data =>  { %><li data-node-type=\"cart-option-list-item\"><span data-node-type=\"cart-option-list-item-label\" template-part-bind=\"a39490a8-b5f0-903b-4b49-2d852812f941\"><%= data[0] %></span><span data-node-type=\"span\">{{ 't726' | t }}</span><span data-node-type=\"cart-option-list-item-value\" template-part-bind=\"a39490a8-b5f0-903b-4b49-2d852812f944\"><%= data[1] %></span></li><% }) %></ul><% } %><div class=\"fc-qty-row\"><div class=\"input-group input-number-group is-minicart fc-qty\"><button type=\"button\" class=\"fc-qty__btn\" data-qty-step=\"-1\" aria-label=\"Decrease quantity\">-</button><input class=\"w-commerce-commercecartquantity input-number is-minicart\" name=\"<%= it.id %>\" type=\"number\" min=\"0\" value=\"<%= it.quantity %>\" data-node-type=\"cart-quantity\"><button type=\"button\" class=\"fc-qty__btn\" data-qty-step=\"1\" aria-label=\"Increase quantity\">+</button></div><a data-node-type=\"cart-remove-link\" href=\"#\" role=\"button\" template-part-bind=\"a39490a8-b5f0-903b-4b49-2d852812f945\" data-product-id=\"<%= it.id %>\"><div class=\"fa-icon is-minicart\">{{ 'tf2ed' | t }}</div></a></div></div><div class=\"div-block-7\"><s class=\"fc-compare-price\" data-compare-handle=\"<%= it.handle %>\" data-compare-variant=\"<%= it.variant_id %>\" data-compare-qty=\"<%= it.quantity %>\" hidden></s><div class=\"product-price is-minicart\" template-part-bind=\"a39490a8-b5f0-903b-4b49-2d852812f93e\"><%= it.total %></div></div><% if (it.properties.Contents) { %></div><% } %></div></script>\n                        <div class=\"w-commerce-commercecartlist mini-cart-list\" data-wf-collection=\"database.commerceOrder.userItems\" data-wf-template-id=\"wf-template-a39490a8-b5f0-903b-4b49-2d852812f939\"></div>\n                        <div class=\"w-commerce-commercecartfooter mini-cart-footer\">\n                          <div aria-atomic=\"true\" aria-live=\"polite\" class=\"w-commerce-commercecartlineitem\">\n                            <div>{{ 'tn76f396dc' | t }}</div>\n                            <div class=\"w-commerce-commercecartordervalue text-weight-normal\">{{ cart.items_subtotal_price | money }}</div>\n                          </div>\n                          <div>\n                            {% comment %}\n                            <div data-node-type=\"commerce-cart-quick-checkout-actions\">{{ content_for_additional_checkout_buttons }}</div>\n                            {% endcomment %}\n                            <a href=\"/checkout\" value=\"Continue to Checkout\" class=\"w-commerce-commercecartcheckoutbutton btn-stretched secondary\" data-loading-text=\"{{ 't498bd87e' | t }}\" data-node-type=\"cart-checkout-button\">{{ 'tn7941186e' | t }}</a>\n                          </div>\n                        </div>\n                      </form>\n                      <div class=\"w-commerce-commercecartemptystate\">\n                        <div aria-label=\"This cart is empty\" aria-live=\"polite\">{{ 't3d503d2b' | t }}</div>\n                      </div>\n                      <div aria-live=\"assertive\" style=\"display:none\" data-node-type=\"commerce-cart-error\" class=\"w-commerce-commercecarterrorstate\">\n                        <div class=\"w-cart-error-msg\" data-w-cart-quantity-error=\"Product is not available in this quantity.\" data-w-cart-general-error=\"Something went wrong when adding this item to the cart.\" data-w-cart-checkout-error=\"Checkout is disabled on this site.\" data-w-cart-cart_order_min-error=\"The order minimum was not met. Add more items to your cart to continue.\" data-w-cart-subscription_error-error=\"Before you purchase, please use your email invite to verify your address so we can send order updates.\">{{ 'tn1c765d0d' | t }}</div>\n                      </div>\n                    </div>\n                  </div>\n                </div>\n              </div>\n            </div>\n          </div>\n        </div>\n      </div>\n    \n\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Roboto:wght@400;500&display=swap\">\n<style>\n  /* 2026 nav design (Figma \"Main Navigation\"). Desktop only: the ≤991px hamburger menu keeps its own styles. */\n  .nav_menu-links-wrapper.is-highlight .nav_link { color: var(--butterscotch); }\n  .nav_divider, .nav_feature-link { display: none; }\n\n  @media screen and (min-width: 992px) {\n    .navbar .navbar_top-wrapper { padding-left: 0; padding-right: 0; border-bottom: 0; }\n    .navbar .nav_container { max-width: 1450px; }\n    .navbar .nav_wrapper { height: 80px; gap: 0; }\n    .navbar .brand { margin-right: 0; padding: 0 15px; }\n    .navbar .brand-image { width: 145px; height: auto; max-height: none; }\n\n    .navbar .nav_link-component { font-family: Roboto, sans-serif; font-weight: 500; font-size: 14px; line-height: 20px; }\n    .navbar .nav_link { box-sizing: border-box; height: 80px; padding: 0 15px; align-items: center; }\n    .navbar .nav_menu-links-wrapper:hover .nav_link { color: var(--butterscotch); }\n\n    .navbar .nav_utility-wrapper { height: 80px; padding-right: 8px; }\n    .nav_divider { display: block; width: 1px; height: 20px; margin: 0 10px; background: #bfbfbf; }\n    .nav_feature-link {\n      display: flex; align-items: center; box-sizing: border-box; width: auto; height: 80px; padding: 0 16px;\n      color: #fff; font-family: Roboto, sans-serif; font-weight: 500; font-size: 14px; line-height: 16.8px;\n      letter-spacing: 0.7px; text-transform: uppercase; text-decoration: none;\n    }\n    .nav_feature-link:hover { color: var(--butterscotch); }\n    .navbar .nav-link.is-utility, .navbar .cart-button { padding: 6.357px; }\n    .navbar .nav_utility-wrapper .icon { width: 23.836px; }\n  }\n</style>\n\n<script>var currentSection = document.currentScript.closest('.shopify-section');currentSection.setAttribute(\"data-animation\",\"default\");currentSection.setAttribute(\"data-collapse\",\"medium\");currentSection.setAttribute(\"data-duration\",\"400\");currentSection.setAttribute(\"data-easing\",\"ease\");currentSection.setAttribute(\"data-easing2\",\"ease\");currentSection.setAttribute(\"role\",\"banner\");currentSection.setAttribute(\"class\",\"navbar w-nav\");</script>\n        \n<script>\n  // Slide-out cart quantity stepper: step the Webflow quantity field and let Udesly's change handler update the cart.\n  document.addEventListener('click', function (e) {\n    var btn = e.target.closest('.cart_container [data-qty-step]');\n    if (!btn) return;\n    var input = btn.parentNode.querySelector('[data-node-type=\"cart-quantity\"]');\n    if (!input) return;\n    input.value = Math.max(0, (Number(input.value) || 0) + Number(btn.getAttribute('data-qty-step')));\n    input.dispatchEvent(new Event('change', { bubbles: true }));\n  });\n</script>\n\n{% schema %}\n{\n  \"name\": \"Navbar\",\n  \"tag\": \"div\",\n  \"class\": \"navbar w-nav\",\n  \"settings\": [\n    {\n      \"id\": \"coffee_link\",\n      \"label\": \"Coffee link\",\n      \"type\": \"url\",\n      \"info\": \"Defaults to the coffee collection.\"\n    },\n    {\n      \"id\": \"account_portal\",\n      \"label\": \"Account Portal\",\n      \"type\": \"url\"\n    },\n    {\n      \"type\": \"link_list\",\n      \"id\": \"main_nav_menu\",\n      \"label\": \"Main Nav Menu\",\n      \"info\": \"Shown between Coffee and Join the Club. Items linking to the Join the Club page are skipped.\",\n      \"default\": \"main-menu\"\n    },\n    {\n      \"type\": \"text\",\n      \"id\": \"join_club_text\",\n      \"label\": \"Join the Club label\",\n      \"default\": \"Join The Club\"\n    },\n    {\n      \"id\": \"join_club_link\",\n      \"label\": \"Join the Club link\",\n      \"type\": \"url\",\n      \"info\": \"Leave empty to open the Box Builder menu.\"\n    },\n    {\n      \"type\": \"header\",\n      \"content\": \"Featured links (desktop, right side)\"\n    },\n    {\n      \"type\": \"text\",\n      \"id\": \"featured_blend_text\",\n      \"label\": \"Featured Blend label\",\n      \"default\": \"Featured Blend\"\n    },\n    {\n      \"type\": \"url\",\n      \"id\": \"featured_blend_link\",\n      \"label\": \"Featured Blend link\",\n      \"info\": \"Leave empty to use the Featured Blends collection.\"\n    },\n    {\n      \"type\": \"text\",\n      \"id\": \"pray_first_text\",\n      \"label\": \"Pray First label\",\n      \"default\": \"Pray First\"\n    },\n    {\n      \"id\": \"pray_first_link\",\n      \"label\": \"Pray First link\",\n      \"type\": \"url\",\n      \"info\": \"Defaults to the Prayer Wall page.\"\n    }\n  ]\n}\n{% endschema %}"
      }
    },
    {
      "filename": "sections/prayer-wall.liquid",
      "body": {
        "type": "TEXT",
        "value": "<style>\n.pw-section [hidden] { display: none !important; }\n.pw-section { background: #fff; font-family: Avenirnextltpro, sans-serif; color: #000; }\n\n/* Hero */\n.pw-hero {\n  position: relative; overflow: hidden; background: #406274;\n  min-height: 568px; display: flex; align-items: center;\n}\n.pw-hero__bg, .pw-hero__shade, .pw-hero__light { position: absolute; inset: 0; pointer-events: none; }\n.pw-hero__bg { background: url('{{ 'prayer-wall-hero.jpg' | asset_url }}') center / cover no-repeat; }\n.pw-hero__shade { width: min(1219px, 100%); background: linear-gradient(to right, #232323, rgba(35,35,35,0)); }\n.pw-hero__light { background: url('{{ 'prayer-wall-hero-light.jpg' | asset_url }}') center / cover no-repeat; mix-blend-mode: lighten; opacity: 0.5; }\n.pw-hero__content {\n  position: relative; display: flex; flex-direction: column; justify-content: center; gap: 35px;\n  max-width: 469px; box-sizing: content-box;\n  padding: 40px 24px 40px clamp(24px, 10.6vw, 153px);\n}\n.pw-hero__title {\n  margin: 0; font-family: Avenirnextltpro, sans-serif; font-weight: 700; text-transform: uppercase;\n  font-size: clamp(44px, 9vw, 72.767px); line-height: 0.92; color: #fff;\n}\n.pw-hero__intro { margin: 0; font-family: Roboto, sans-serif; font-size: 20px; line-height: 26px; color: #fff; }\n.pw-hero__actions { display: flex; flex-wrap: wrap; gap: 35px; }\n.pw-hero__btn {\n  display: inline-flex; align-items: center; justify-content: center; box-sizing: border-box;\n  min-width: 216px; padding: 8px 23px; border: 0; border-radius: 2px; cursor: pointer;\n  background: #d29f13; color: #000; text-decoration: none; transition: background .15s;\n  font-family: Avenirnextltpro, sans-serif; font-weight: 700; font-size: 18px; text-transform: uppercase;\n}\n.pw-hero__btn:hover { background: #b88a10; color: #000; }\n\n/* Body */\n.pw-body { max-width: 1140px; margin: 0 auto; padding: 65px 24px 100px; box-sizing: content-box; display: flex; flex-direction: column; align-items: center; gap: 64px; }\n.pw-body > * { width: 100%; }\n#pw-toasts { display: flex; flex-direction: column; gap: 0.5rem; }\n#pw-toasts:empty { display: none; }\n#pw-root { display: flex; flex-direction: column; align-items: center; gap: 64px; }\n#pw-root > * { width: 100%; }\n.pw__loading { color: #888; font-style: italic; text-align: center; }\n.pw__error { color: #893024; text-align: center; }\n.pw__empty { color: #888; font-style: italic; text-align: center; }\n\n/* Notices (toasts) */\n.pw-toast {\n  display: flex; align-items: flex-start; gap: 13px; box-sizing: border-box; width: 100%;\n  padding: 15px 19px; border-left: 5px solid #333; border-radius: 4px; background: rgba(51,51,51,0.2);\n  color: #000; font-family: Avenirnextltpro, sans-serif; font-weight: 500; font-size: 15.5px; line-height: 1.5;\n  animation: pw-toast-in .2s ease;\n}\n.pw-toast--error { background: rgba(137,48,36,0.5); border-left-color: #893024; }\n.pw-toast--success { background: rgba(45,106,79,0.5); border-left-color: #2d6a4f; }\n.pw-toast--info { background: rgba(94,126,41,0.5); border-left-color: #5e7e29; }\n.pw-toast--warning { background: rgba(184,138,16,0.5); border-left-color: #b88a10; }\n.pw-toast__msg { flex: 1; }\n.pw-toast__close {\n  display: inline-flex; align-items: center; justify-content: center; flex-shrink: 0;\n  width: 26px; height: 26px; margin: -2px 0; color: #000; opacity: 0.75; cursor: pointer; font-size: 21.5px; line-height: 1;\n}\n.pw-toast__close:hover { opacity: 1; }\n@keyframes pw-toast-in { from { opacity: 0; transform: translateY(.5rem); } to { opacity: 1; transform: translateY(0); } }\n\n/* Submit form + pending */\n.pw__submit-wrap, .pw__pending-wrap { border: 2px solid #d29f13; border-radius: 24px; padding: 36px; box-sizing: border-box; }\n.pw__submit-title, .pw__pending-title { margin: 0 0 17px; font-family: Avenirnextltpro, sans-serif; font-weight: 600; font-size: 24px; line-height: 1.1; color: #333; }\n.pw__pending-note { margin: 0 0 12px; font-size: 14px; color: #888; }\n.pw__pending-list { list-style: none; padding: 0; margin: 0; }\n.pw__pending-item { padding: 10px 0; border-top: 1px solid #eee; }\n.pw__pending-item:first-child { border-top: none; }\n.pw__pending-text { margin: 0 0 2px; font-size: 14px; line-height: 1.4; color: #000; }\n.pw__pending-date { margin: 0; font-size: 13px; color: #888; }\n.pw__input, .pw__textarea {\n  display: block; width: 100%; box-sizing: border-box; margin-bottom: 12px; padding: 10px 12px;\n  border: 1px solid #ccc; border-radius: 6px; background: #fff; color: #171717;\n  font-size: 16px; font-family: inherit; line-height: 1.5; resize: vertical;\n}\n.pw__input:focus, .pw__textarea:focus { outline: none; border-color: #d29f13; box-shadow: 0 0 0 2px rgba(210,159,19,.2); }\n.pw__textarea--sm { font-size: 14px; }\n.pw__form-footer { display: flex; align-items: center; gap: 16px; flex-wrap: wrap; }\n.pw__anon-label { display: flex; align-items: center; gap: 6px; font-size: 14px; color: #333; cursor: pointer; }\n\n/* Cards: two staggered columns on desktop, one on mobile */\n.pw__list { display: flex; gap: 64px; align-items: flex-start; }\n.pw__col { flex: 1 1 0; min-width: 0; display: flex; flex-direction: column; gap: 64px; }\n.pw__list--single { flex-direction: column; gap: 32px; align-items: stretch; }\n.pw__card {\n  display: flex; flex-direction: column; align-items: flex-start; gap: 17px; box-sizing: border-box;\n  border: 2px solid #d29f13; border-radius: 24px; background: #fff; padding: 36px;\n}\n.pw__card-praise {\n  display: inline-block; padding: 10px 13px; border-radius: 6px; background: #d8f3dc; color: #2d6a4f;\n  font-size: 15.5px; line-height: 1; font-weight: 400;\n}\n.pw__card-praise strong { font-weight: 700; }\n.pw__card-title { margin: 0; font-weight: 600; font-size: 24px; line-height: 1.11; color: #333; overflow-wrap: anywhere; }\n.pw__card-text { margin: 0; font-size: 14px; line-height: 1.38; color: #000; overflow-wrap: anywhere; white-space: pre-line; }\n.pw__card-meta { margin: 0; font-size: 13.8px; line-height: 1.4; color: #888; }\n.pw__card-footer { display: flex; align-items: center; gap: 12px; flex-wrap: wrap; }\n\n/* Praise form */\n.pw__praise-form { width: 100%; border-top: 1px solid #eee; padding-top: 12px; }\n.pw__praise-form-footer { display: flex; gap: 8px; }\n\n/* Buttons */\n.pw__btn {\n  border: none; cursor: pointer; font-family: inherit; line-height: 1.4; transition: background .15s;\n  text-transform: uppercase; letter-spacing: 0.05em; font-size: 14px; border-radius: 2px; padding: 6px 15px;\n}\n.pw__btn:disabled { opacity: 0.5; cursor: not-allowed; }\n.pw__btn--primary { background: #d29f13; color: #000; font-weight: 700; }\n.pw__btn--primary:hover:not(:disabled) { background: #b88a10; }\n.pw__btn--pray, .pw__more {\n  display: inline-flex; align-items: center; justify-content: center; box-sizing: border-box;\n  min-width: 183px; height: 55px; padding: 6px 15px; border-radius: 2px;\n  background: #d29f13; color: #fff; font-family: Roboto, sans-serif; font-weight: 700; font-size: 14px; letter-spacing: 0.05em; text-transform: uppercase;\n}\n.pw__btn--pray:hover:not(:disabled), .pw__more:hover { background: #b88a10; }\n.pw__btn--pray-active { background: #3d441e; }\n.pw__btn--pray-active:hover:not(:disabled) { background: #2c3115; }\n.pw__btn--delete { background: none; color: #893024; text-decoration: underline; padding: 6px 2px; text-transform: none; letter-spacing: 0; }\n.pw__btn--delete:hover:not(:disabled) { color: #6a2319; }\n.pw__btn--praise { background: none; color: #5e7e29; text-decoration: underline; padding: 6px 2px; text-transform: none; letter-spacing: 0; }\n.pw__btn--ghost { background: none; color: #333; border: 1px solid #bbb; }\n.pw__more { align-self: center; width: auto; border: 0; cursor: pointer; }\n.pw__more[hidden] { display: none; }\nbutton#pw-submit-btn { display: flex; height: 40px; padding: 0 52px; justify-content: center; align-items: center; line-height: 1; }\n\n/* Honeypot: off-screen, not display:none, so naive bots still fill it */\n.pw__hp { position: absolute; left: -9999px; width: 1px; height: 1px; overflow: hidden; }\n\n/* Guest submit modal */\n.pw-modal {\n  position: fixed; inset: 0; z-index: 1000; display: flex; align-items: center; justify-content: center;\n  padding: 16px; background: rgba(0,0,0,0.55);\n}\n.pw-modal__box {\n  position: relative; width: 100%; max-width: 480px; box-sizing: border-box; padding: 36px;\n  border: 2px solid #d29f13; border-radius: 24px; background: #fff;\n}\n.pw-modal__title { margin: 0 0 12px; padding-right: 28px; font-weight: 600; font-size: 24px; line-height: 1.11; color: #333; }\n.pw-modal__text { margin: 0 0 24px; font-size: 15.5px; line-height: 1.5; color: #000; }\n.pw-modal__actions { display: flex; gap: 12px; flex-wrap: wrap; }\n.pw-modal__actions .pw__btn { flex: 1 1 140px; height: 44px; }\n.pw-modal__close {\n  position: absolute; top: 14px; right: 16px; padding: 4px; border: 0; background: none;\n  color: #333; font-size: 26px; line-height: 1; cursor: pointer;\n}\n\n@media (max-width: 991px) {\n  .pw-hero { min-height: 480px; }\n  .pw-hero__content { gap: 24px; max-width: none; padding-right: 24px; }\n  .pw-hero__actions { gap: 16px; }\n  .pw-hero__btn { min-width: 0; flex: 1 1 160px; }\n  .pw-body { padding-top: 40px; padding-bottom: 64px; gap: 40px; }\n  #pw-root { gap: 40px; }\n  .pw__submit-wrap, .pw__pending-wrap, .pw__card, .pw-modal__box { padding: 24px; border-radius: 20px; }\n}\n</style>\n\n{%- comment -%} Speed preview 2026-11-07: let the browser find the main hero image during HTML parse instead of after CSS. {%- endcomment -%}\n{{ 'prayer-wall-hero.jpg' | asset_url | preload_tag: as: 'image', fetchpriority: 'high' }}\n<section class=\"pw-section\" id=\"prayer-wall\" data-proxy=\"/apps/prayer-wall\">\n  <div class=\"pw-hero\">\n    <div class=\"pw-hero__bg\"></div>\n    <div class=\"pw-hero__shade\"></div>\n    <div class=\"pw-hero__light\"></div>\n    <div class=\"pw-hero__content\">\n      {%- if section.settings.title != blank -%}\n        <h1 class=\"pw-hero__title\">{{ section.settings.title | escape }}</h1>\n      {%- endif -%}\n      {%- if section.settings.intro != blank -%}\n        <p class=\"pw-hero__intro\">{{ section.settings.intro | escape }}</p>\n      {%- endif -%}\n      <div class=\"pw-hero__actions\">\n        <button type=\"button\" class=\"pw-hero__btn\" data-pw-scroll=\"form\">Request Prayer</button>\n        <button type=\"button\" class=\"pw-hero__btn\" data-pw-scroll=\"list\">Latest Request</button>\n      </div>\n    </div>\n  </div>\n\n  <div class=\"pw-body\">\n    {%- comment -%} New customer accounts: /account/login doesn't apply; return_to must be relative. {%- endcomment -%}\n    {%- assign pw_return = request.path | url_encode -%}\n    <script>\n      window.__PW_CUSTOMER__ = {\n        loggedIn: {% if customer %}true{% else %}false{% endif %},\n        loginUrl: {{ '/customer_authentication/login?return_to=' | append: pw_return | json }},\n      };\n      // Speed preview: start the initial prayer list request now, before the form/card templates are parsed.\n      // Same GET the page already makes; on any failure the original api('/') path runs.\n      window.__PW_INITIAL__ = fetch('/apps/prayer-wall/', { headers: { 'Content-Type': 'application/json' } })\n        .then(function (r) { return r.ok ? r.json() : null; })\n        .catch(function () { return null; });\n    </script>\n\n    <div id=\"pw-toasts\"></div>\n\n    <div id=\"pw-root\">\n      <p class=\"pw__loading\" aria-live=\"polite\">Loading prayer requests…</p>\n    </div>\n  </div>\n\n  {%- unless customer -%}\n    <div class=\"pw-modal\" id=\"pw-guest-modal\" hidden>\n      <div class=\"pw-modal__box\" role=\"dialog\" aria-modal=\"true\" aria-labelledby=\"pw-guest-modal-title\" aria-describedby=\"pw-guest-modal-text\">\n        <button type=\"button\" class=\"pw-modal__close\" data-pw-modal-close aria-label=\"Close\">×</button>\n        <h2 class=\"pw-modal__title\" id=\"pw-guest-modal-title\">{{ section.settings.guest_modal_heading | escape }}</h2>\n        <p class=\"pw-modal__text\" id=\"pw-guest-modal-text\">{{ section.settings.guest_modal_text | escape }}</p>\n        <div class=\"pw-modal__actions\">\n          <button type=\"button\" class=\"pw__btn pw__btn--primary\" data-pw-modal-login>Login</button>\n          <button type=\"button\" class=\"pw__btn pw__btn--ghost\" data-pw-modal-guest>Post Anyway</button>\n        </div>\n      </div>\n    </div>\n  {%- endunless -%}\n</section>\n\n<template id=\"pw-tpl-form\">\n  <div class=\"pw__submit-wrap\" id=\"pw-form-panel\" hidden>\n    <h3 class=\"pw__submit-title\">{{ section.settings.submit_heading | default: 'Share a Prayer Request' | escape }}</h3>\n    <form class=\"pw__form\" id=\"pw-form\" novalidate>\n      <input\n        class=\"pw__input\"\n        type=\"text\"\n        id=\"pw-request-title\"\n        placeholder=\"Title (optional)\"\n        maxlength=\"80\"\n      >\n      <textarea\n        class=\"pw__textarea\"\n        id=\"pw-request-text\"\n        placeholder=\"{{ section.settings.submit_placeholder | escape }}\"\n        rows=\"4\"\n        maxlength=\"2000\"\n        required\n      ></textarea>\n      <div class=\"pw__hp\" aria-hidden=\"true\">\n        <label>Leave this field empty <input type=\"text\" name=\"website\" tabindex=\"-1\" autocomplete=\"off\"></label>\n      </div>\n      <div class=\"pw__form-footer\">\n        <label class=\"pw__anon-label\">\n          <input type=\"checkbox\" id=\"pw-anon\"> Post anonymously\n        </label>\n        <button class=\"pw__btn pw__btn--primary\" type=\"submit\" id=\"pw-submit-btn\">Submit Request</button>\n      </div>\n    </form>\n  </div>\n</template>\n\n\n<template id=\"pw-tpl-pending\">\n  <div class=\"pw__pending-wrap\">\n    <h3 class=\"pw__pending-title\">Your Pending Requests</h3>\n    <p class=\"pw__pending-note\">These are awaiting review before appearing on the wall.</p>\n    <ul class=\"pw__pending-list\" id=\"pw-pending-list\"></ul>\n  </div>\n</template>\n\n<template id=\"pw-tpl-pending-item\">\n  <li class=\"pw__pending-item\">\n    <p class=\"pw__pending-text\"></p>\n    <p class=\"pw__pending-date\"></p>\n  </li>\n</template>\n\n<template id=\"pw-tpl-card\">\n  <article class=\"pw__card\">\n    <div class=\"pw__card-praise\" hidden></div>\n    <h3 class=\"pw__card-title\" hidden></h3>\n    <p class=\"pw__card-text\" hidden></p>\n    <p class=\"pw__card-meta\"></p>\n    <div class=\"pw__card-footer\">\n      <button class=\"pw__btn pw__btn--pray\" type=\"button\" data-action=\"pray\" data-id=\"\"></button>\n      <button class=\"pw__btn pw__btn--delete\" type=\"button\" data-action=\"delete\" data-id=\"\" hidden>Delete my request</button>\n      <button class=\"pw__btn pw__btn--praise\" type=\"button\" data-action=\"open-praise\" data-id=\"\" hidden>Add praise report</button>\n    </div>\n    <form class=\"pw__praise-form\" hidden>\n      <textarea class=\"pw__textarea pw__textarea--sm\" placeholder=\"Share how God answered this prayer…\" rows=\"3\" maxlength=\"1000\" required></textarea>\n      <div class=\"pw__praise-form-footer\">\n        <button class=\"pw__btn pw__btn--primary\" type=\"submit\">Submit</button>\n        <button class=\"pw__btn pw__btn--ghost\" type=\"button\" data-cancel-praise>Cancel</button>\n      </div>\n    </form>\n  </article>\n</template>\n\n\n<script>\n(function () {\n  const ROOT = document.getElementById('pw-root');\n  const PROXY = document.getElementById('prayer-wall').dataset.proxy;\n  const C = window.__PW_CUSTOMER__;\n  const PAGE_SIZE = 8;\n  // localStorage, not sessionStorage: Sign in with Shop can finish in a new tab.\n  const DRAFT_KEY = 'pw-draft';\n  const DRAFT_MAX_AGE = 60 * 60 * 1000;\n  const MODAL = document.getElementById('pw-guest-modal');\n  let modalForm = null;\n  const TWO_COLS = window.matchMedia('(min-width: 992px)');\n  let listEl = null, moreBtn = null, cards = [], shown = PAGE_SIZE;\n  TWO_COLS.addEventListener('change', () => { if (listEl && cards.length) layout(); });\n\n  // Hero buttons: reveal the request form, or jump to the latest requests.\n  document.querySelectorAll('[data-pw-scroll]').forEach(btn => btn.addEventListener('click', () => {\n    let target;\n    if (btn.dataset.pwScroll === 'form') {\n      const panel = document.getElementById('pw-form-panel');\n      if (panel) {\n        panel.hidden = false;\n        target = panel;\n        const ta = panel.querySelector('textarea');\n        if (ta) setTimeout(() => ta.focus({ preventScroll: true }), 300);\n      } else {\n        target = document.getElementById('pw-toasts');\n      }\n    } else {\n      // Land on the top of the first card, not the middle of the (tall) list,\n      // and clear the sticky navbar so the card isn't hidden behind it.\n      const first = document.querySelector('#pw-list .pw__card') || document.getElementById('pw-list');\n      if (!first) return;\n      const nav = document.querySelector('.navbar');\n      const navHeight = nav ? nav.getBoundingClientRect().height : 0;\n      const top = first.getBoundingClientRect().top + window.scrollY - navHeight - 24;\n      window.scrollTo({ top, behavior: 'smooth' });\n      return;\n    }\n    if (target) target.scrollIntoView({ behavior: 'smooth', block: 'center' });\n  }));\n\n  async function api(path, options) {\n    const res = await fetch(PROXY + path, {\n      method: options?.method || 'GET',\n      headers: { 'Content-Type': 'application/json' },\n      body: options?.body ? JSON.stringify(options.body) : undefined,\n    });\n    const data = await res.json();\n    if (!res.ok) throw new Error(data.error || 'Request failed');\n    return data;\n  }\n\n  function clone(id) {\n    return document.getElementById(id).content.cloneNode(true);\n  }\n\n  function formatDate(iso) {\n    if (!iso) return '';\n    return new Date(iso).toLocaleDateString(undefined, { month: 'short', day: 'numeric', year: 'numeric' });\n  }\n\n  function prayLabel(count, isPraying) {\n    return (isPraying ? '🙏 Praying' : 'Pray for this') + (count > 0 ? ` (${count})` : '');\n  }\n\n  function escHtml(s) {\n    return String(s).replace(/[&<>\"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;',\"'\":'&#39;'}[c]));\n  }\n\n  function toProperCase(str) {\n    if (!str) return str;\n    return str.toLowerCase().replace(/\\b\\w/g, c => c.toUpperCase());\n  }\n\n  function showToast(msg, type = 'error', duration = 5000, id = null) {\n    const container = document.getElementById('pw-toasts');\n    if (!container) return;\n    if (id && document.getElementById(id)) return;\n    const el = document.createElement('div');\n    el.className = 'pw-toast pw-toast--' + type;\n    if (id) el.id = id;\n    const msgEl = document.createElement('span');\n    msgEl.className = 'pw-toast__msg';\n    msgEl.textContent = msg;\n    const closeEl = document.createElement('span');\n    closeEl.className = 'pw-toast__close';\n    closeEl.textContent = '×';\n    closeEl.setAttribute('role', 'button');\n    closeEl.setAttribute('aria-label', 'Dismiss');\n    closeEl.addEventListener('click', () => el.remove());\n    el.appendChild(msgEl);\n    el.appendChild(closeEl);\n    container.appendChild(el);\n    if (duration > 0) setTimeout(() => el.remove(), duration);\n  }\n\n  // Requests posted before the `title` field existed are a single free-text field,\n  // so use the first sentence/line as the title when it is short enough.\n  function splitRequest(text) {\n    const t = String(text || '').trim();\n    const line = t.split('\\n')[0];\n    const m = line.match(/^(.*?[.!?])(?:\\s|$)/);\n    const first = (m ? m[1] : line).trim();\n    const rest = t.slice(first.length).trim();\n    if (first.length > 80) return { title: '', body: t };\n    return { title: first.replace(/\\.$/, ''), body: rest };\n  }\n\n  function buildCard(req) {\n    const frag = clone('pw-tpl-card');\n    const card = frag.querySelector('.pw__card');\n\n    // Prefer the explicit title; older requests without one fall back to the first sentence.\n    const parts = req.title ? { title: req.title, body: req.requestText } : splitRequest(req.requestText);\n    if (parts.title) {\n      const titleEl = card.querySelector('.pw__card-title');\n      titleEl.textContent = parts.title;\n      titleEl.hidden = false;\n    }\n    if (parts.body) {\n      const textEl = card.querySelector('.pw__card-text');\n      textEl.textContent = parts.body;\n      textEl.hidden = false;\n    }\n    const name = req.displayName ? toProperCase(req.displayName) : 'Anonymous';\n    card.querySelector('.pw__card-meta').textContent = 'Requester: ' + name;\n\n    if (req.praiseReport) {\n      const el = card.querySelector('.pw__card-praise');\n      el.innerHTML = '<strong>Praise Report:</strong> ' + escHtml(req.praiseReport);\n      el.hidden = false;\n    }\n\n    const prayBtn = card.querySelector('[data-action=\"pray\"]');\n    prayBtn.dataset.id = req.id;\n    prayBtn.textContent = prayLabel(req.prayingCount, req.isPrayingByMe);\n    if (req.isPrayingByMe) prayBtn.classList.add('pw__btn--pray-active');\n    if (!C.loggedIn) { prayBtn.disabled = true; prayBtn.title = 'Sign in to pray'; }\n\n    if (req.isMyRequest) {\n      const delBtn = card.querySelector('[data-action=\"delete\"]');\n      delBtn.dataset.id = req.id;\n      delBtn.hidden = false;\n\n      if (!req.praiseReport) {\n        const praiseBtn = card.querySelector('[data-action=\"open-praise\"]');\n        praiseBtn.dataset.id = req.id;\n        praiseBtn.hidden = false;\n      }\n    }\n\n    prayBtn.addEventListener('click', onPray);\n    card.querySelector('[data-action=\"delete\"]').addEventListener('click', onDelete);\n    card.querySelector('[data-action=\"open-praise\"]').addEventListener('click', onOpenPraise);\n    card.querySelector('[data-cancel-praise]').addEventListener('click', onCancelPraise);\n    card.querySelector('.pw__praise-form').addEventListener('submit', onPraiseSubmit);\n\n    return card;\n  }\n\n  function render(data) {\n    ROOT.innerHTML = '';\n\n    if (data.canSubmit || data.guestCanSubmit) {\n      ROOT.appendChild(clone('pw-tpl-form'));\n      const form = ROOT.querySelector('#pw-form');\n      if (!C.loggedIn) {\n        const anonLabel = form.querySelector('.pw__anon-label');\n        if (anonLabel) anonLabel.remove();\n      }\n      form.addEventListener('submit', onSubmit);\n      if (C.loggedIn) restoreDraft(form);\n    } else if (data.limitReason) {\n      showToast(data.limitReason, 'info', 0, 'pw-toast-limit');\n    }\n\n    if (data.myPendingRequests?.length) {\n      const frag = clone('pw-tpl-pending');\n      const list = frag.querySelector('#pw-pending-list');\n      data.myPendingRequests.forEach(r => {\n        const itemFrag = clone('pw-tpl-pending-item');\n        itemFrag.querySelector('.pw__pending-text').textContent = r.requestText;\n        itemFrag.querySelector('.pw__pending-date').textContent = 'Submitted ' + formatDate(r.submittedAt);\n        list.appendChild(itemFrag);\n      });\n      ROOT.appendChild(frag);\n    }\n\n    listEl = document.createElement('div');\n    listEl.id = 'pw-list';\n    listEl.className = 'pw__list';\n    cards = data.requests.map(buildCard);\n    shown = PAGE_SIZE;\n    if (!cards.length) {\n      const p = document.createElement('p');\n      p.className = 'pw__empty';\n      p.textContent = 'No prayer requests yet. Be the first to share.';\n      listEl.appendChild(p);\n      ROOT.appendChild(listEl);\n    } else {\n      ROOT.appendChild(listEl);\n      moreBtn = document.createElement('button');\n      moreBtn.type = 'button';\n      moreBtn.className = 'pw__more';\n      moreBtn.textContent = 'Read more';\n      moreBtn.addEventListener('click', () => { shown += PAGE_SIZE; layout(); });\n      ROOT.appendChild(moreBtn);\n      layout();\n    }\n  }\n\n  // Desktop: alternate cards across two staggered columns. Mobile: one column.\n  function layout() {\n    const visible = cards.slice(0, shown);\n    const single = !TWO_COLS.matches;\n    listEl.classList.toggle('pw__list--single', single);\n    listEl.innerHTML = '';\n    if (single) {\n      visible.forEach(c => listEl.appendChild(c));\n    } else {\n      const cols = [document.createElement('div'), document.createElement('div')];\n      cols.forEach(c => { c.className = 'pw__col'; listEl.appendChild(c); });\n      visible.forEach((c, i) => cols[i % 2].appendChild(c));\n    }\n    if (moreBtn) moreBtn.hidden = shown >= cards.length;\n  }\n\n  // Guests choose between logging in and posting for review before anything is sent.\n  function onSubmit(e) {\n    e.preventDefault();\n    const form = e.currentTarget;\n    const textEl = form.querySelector('#pw-request-text');\n    if (!textEl.value.trim()) { textEl.focus(); return; }\n    if (C.loggedIn) submitRequest(form);\n    else openGuestModal(form);\n  }\n\n  async function submitRequest(form) {\n    const btn = form.querySelector('#pw-submit-btn');\n    const text = form.querySelector('#pw-request-text').value.trim();\n    const title = form.querySelector('#pw-request-title').value.trim();\n    const anonEl = form.querySelector('#pw-anon');\n    const anon = anonEl ? anonEl.checked : false;\n    const website = form.querySelector('[name=\"website\"]').value;\n    btn.disabled = true; btn.textContent = 'Submitting…';\n    try {\n      const res = await api('/submit', { method: 'POST', body: { title, requestText: text, isAnonymous: anon, website } });\n      if (res.status === 'pending') {\n        form.reset();\n        btn.disabled = false; btn.textContent = 'Submit Request';\n        showToast(\"Thanks — your request will appear once it's reviewed.\", 'success', 0, 'pw-toast-pending');\n        document.getElementById('pw-toasts').scrollIntoView({ behavior: 'smooth', block: 'center' });\n      } else {\n        await reload();\n      }\n    } catch (err) {\n      showToast(err.message);\n      btn.disabled = false; btn.textContent = 'Submit Request';\n    }\n  }\n\n  function openGuestModal(form) {\n    modalForm = form;\n    MODAL.hidden = false;\n    MODAL.querySelector('[data-pw-modal-login]').focus();\n    document.addEventListener('keydown', onModalKey);\n  }\n\n  // Esc, ✕ and backdrop close without posting; focus goes back to Submit.\n  function closeGuestModal() {\n    MODAL.hidden = true;\n    document.removeEventListener('keydown', onModalKey);\n    if (modalForm) modalForm.querySelector('#pw-submit-btn').focus();\n  }\n\n  function onModalKey(e) {\n    if (e.key === 'Escape') { e.preventDefault(); closeGuestModal(); return; }\n    if (e.key !== 'Tab') return;\n    const focusable = MODAL.querySelectorAll('button');\n    const first = focusable[0], last = focusable[focusable.length - 1];\n    if (!MODAL.contains(document.activeElement)) { e.preventDefault(); first.focus(); }\n    else if (e.shiftKey && document.activeElement === first) { e.preventDefault(); last.focus(); }\n    else if (!e.shiftKey && document.activeElement === last) { e.preventDefault(); first.focus(); }\n  }\n\n  if (MODAL) {\n    MODAL.querySelector('[data-pw-modal-close]').addEventListener('click', closeGuestModal);\n    MODAL.addEventListener('click', e => { if (e.target === MODAL) closeGuestModal(); });\n    MODAL.querySelector('[data-pw-modal-guest]').addEventListener('click', () => {\n      closeGuestModal();\n      submitRequest(modalForm);\n    });\n    MODAL.querySelector('[data-pw-modal-login]').addEventListener('click', () => {\n      try {\n        localStorage.setItem(DRAFT_KEY, JSON.stringify({\n          title: modalForm.querySelector('#pw-request-title').value,\n          requestText: modalForm.querySelector('#pw-request-text').value,\n          savedAt: Date.now(),\n        }));\n      } catch {}\n      window.location.href = C.loginUrl;\n    });\n  }\n\n  // After the login round-trip, refill the form with what the guest had typed.\n  function restoreDraft(form) {\n    let draft = null;\n    try {\n      draft = JSON.parse(localStorage.getItem(DRAFT_KEY));\n      localStorage.removeItem(DRAFT_KEY);\n    } catch {}\n    if (!draft || !draft.requestText || Date.now() - draft.savedAt > DRAFT_MAX_AGE) return;\n    form.querySelector('#pw-request-title').value = draft.title || '';\n    form.querySelector('#pw-request-text').value = draft.requestText;\n    const panel = document.getElementById('pw-form-panel');\n    panel.hidden = false;\n    panel.scrollIntoView({ behavior: 'smooth', block: 'center' });\n    showToast('Welcome back! Your request is ready to submit.', 'success', 8000);\n  }\n\n  async function onPray(e) {\n    const btn = e.currentTarget;\n    btn.disabled = true;\n    try {\n      const res = await api('/pray', { method: 'POST', body: { id: btn.dataset.id } });\n      btn.classList.toggle('pw__btn--pray-active', res.praying);\n      btn.textContent = prayLabel(res.count, res.praying);\n    } catch (err) { showToast(err.message); }\n    finally { btn.disabled = false; }\n  }\n\n  async function onDelete(e) {\n    if (!confirm('Remove your prayer request from the wall?')) return;\n    const btn = e.currentTarget;\n    btn.disabled = true;\n    try {\n      await api('/delete', { method: 'POST', body: { id: btn.dataset.id } });\n      await reload();\n    } catch (err) { showToast(err.message); btn.disabled = false; }\n  }\n\n  function onOpenPraise(e) {\n    const card = e.currentTarget.closest('.pw__card');\n    e.currentTarget.hidden = true;\n    card.querySelector('.pw__praise-form').hidden = false;\n    card.querySelector('.pw__praise-form textarea').focus();\n  }\n\n  function onCancelPraise(e) {\n    const card = e.currentTarget.closest('.pw__card');\n    card.querySelector('.pw__praise-form').hidden = true;\n    card.querySelector('[data-action=\"open-praise\"]').hidden = false;\n  }\n\n  async function onPraiseSubmit(e) {\n    e.preventDefault();\n    const form = e.currentTarget;\n    const card = form.closest('.pw__card');\n    const id = card.querySelector('[data-action=\"delete\"]').dataset.id;\n    const text = form.querySelector('textarea').value.trim();\n    const submitBtn = form.querySelector('[type=\"submit\"]');\n    if (!text) return;\n    submitBtn.disabled = true; submitBtn.textContent = 'Submitting…';\n    try {\n      await api('/update-praise', { method: 'POST', body: { id, praiseReportText: text } });\n      await reload();\n    } catch (err) {\n      showToast(err.message);\n      submitBtn.disabled = false; submitBtn.textContent = 'Submit';\n    }\n  }\n\n  async function reload() {\n    try {\n      const early = window.__PW_INITIAL__ ? await window.__PW_INITIAL__ : null;\n      window.__PW_INITIAL__ = null;\n      render(early || await api('/'));\n    } catch {\n      ROOT.innerHTML = '<p class=\"pw__error\">Could not load prayer requests. Please refresh the page.</p>';\n    }\n  }\n\n  reload();\n})();\n</script>\n\n{% schema %}\n{\n  \"name\": \"Prayer Wall\",\n  \"settings\": [\n    {\n      \"type\": \"text\",\n      \"id\": \"title\",\n      \"label\": \"Section heading\",\n      \"default\": \"How can we pray for you?\"\n    },\n    {\n      \"type\": \"textarea\",\n      \"id\": \"intro\",\n      \"label\": \"Intro text\",\n      \"default\": \"We believe in the power of prayer. Share your needs below and our community will stand with you.\"\n    },\n    {\n      \"type\": \"text\",\n      \"id\": \"submit_heading\",\n      \"label\": \"Submit form heading\",\n      \"default\": \"Share a Prayer Request\"\n    },\n    {\n      \"type\": \"text\",\n      \"id\": \"submit_placeholder\",\n      \"label\": \"Submit form placeholder\",\n      \"default\": \"Share what's on your heart…\"\n    },\n    {\n      \"type\": \"header\",\n      \"content\": \"Guest submit popup\"\n    },\n    {\n      \"type\": \"text\",\n      \"id\": \"guest_modal_heading\",\n      \"label\": \"Heading\",\n      \"default\": \"Your request will be subject to review.\"\n    },\n    {\n      \"type\": \"textarea\",\n      \"id\": \"guest_modal_text\",\n      \"label\": \"Text\",\n      \"default\": \"To post immediately, log in and become a part of the First Cup Community!\"\n    }\n  ],\n  \"presets\": [\n    {\n      \"name\": \"Prayer Wall\"\n    }\n  ]\n}\n{% endschema %}\n"
      }
    },
    {
      "filename": "sections/section-collection-products.liquid",
      "body": {
        "type": "TEXT",
        "value": "\n{%- comment -%}\n  PLP grid + filters. Filtering/sorting is Finsweet Attributes (cmsfilter /\n  cmssort / selectcustom), loaded in snippets/header-collection.liquid — the\n  fs-* attributes below are load-bearing, not decorative. Webflow's w-dropdown\n  classes drive the open/close behavior via first-cup-coffee.js, so they stay\n  too; the 2026 styling is layered on through the plp-2026_* classes.\n{%- endcomment -%}\n\n<div class=\"site-redesign-26 plp-2026\">\n  <div class=\"plp-2026_inner\">\n    {%- if section.settings.show_filters -%}\n      <div class=\"plp-2026_filter-wrap\">\n        <div fs-cmsfilter-element=\"filters\" fs-cmsfilter-tagformat=\"list\" class=\"plp-2026_filter-form w-form\">\n          <form action=\"https://\" method=\"get\" class=\"plp-2026_filter-bar\">\n            <p class=\"plp-2026_filter-label\">{{ section.settings.filter_label }}</p>\n\n            <div class=\"plp-2026_facets\">\n              {%- for block in section.blocks -%}\n                {%- if block.type == 'facet' -%}\n                  <div data-delay=\"0\" data-hover=\"false\" class=\"plp-2026_facet fs-dropdown-1 w-dropdown\" {{ block.shopify_attributes }}>\n                    <div class=\"plp-2026_facet-toggle fs-dropdown_toggle-1 w-dropdown-toggle\">\n                      <span class=\"plp-2026_facet-label\">{{ block.settings.label }}</span>\n                      <img src=\"{{ 'plp-chevron.svg' | asset_url }}\" alt=\"\" class=\"plp-2026_facet-chevron\">\n                    </div>\n                    <nav class=\"plp-2026_facet-panel fs-dropdown_list w-dropdown-list\">\n                      <div class=\"plp-2026_facet-options\">\n                        {%- assign options = block.settings.options | split: ',' -%}\n                        {%- for option in options -%}\n                          {%- assign option_label = option | strip -%}\n                          <label class=\"plp-2026_check w-checkbox\">\n                            <div class=\"plp-2026_check-box w-checkbox-input w-checkbox-input--inputType-custom\"></div>\n                            <input\n                              type=\"checkbox\"\n                              name=\"{{ block.settings.field | handle }}-{{ forloop.index }}\"\n                              style=\"opacity:0;position:absolute;z-index:-1\"\n                            >\n                            <span fs-cmsfilter-field=\"{{ block.settings.field }}\" class=\"plp-2026_check-label w-form-label\">{{ option_label }}</span>\n                          </label>\n                        {%- endfor -%}\n                      </div>\n                      <a\n                        fs-cmsfilter-element=\"clear\"\n                        fs-cmsfilter-clear=\"{{ block.settings.field }}\"\n                        href=\"#\"\n                        class=\"plp-2026_facet-reset\"\n                      >{{ section.settings.reset_label }}</a>\n                    </nav>\n                  </div>\n                {%- endif -%}\n              {%- endfor -%}\n            </div>\n\n            <div data-delay=\"0\" data-hover=\"false\" fs-selectcustom-element=\"dropdown\" class=\"plp-2026_sort fs-select w-dropdown\">\n              <div class=\"plp-2026_sort-toggle w-dropdown-toggle\">\n                <span class=\"plp-2026_sort-label\">{{ section.settings.sort_label }}</span>\n                <span fs-selectcustom-element=\"label\" class=\"plp-2026_sort-value\">{{ section.settings.sort_default }}</span>\n                <img src=\"{{ 'plp-chevron-sort.svg' | asset_url }}\" alt=\"\" class=\"plp-2026_sort-chevron\">\n              </div>\n              <nav class=\"plp-2026_sort-panel fs-dropdown_list w-dropdown-list\">\n                <select name=\"sort-by\" fs-cmssort-element=\"trigger\" class=\"fs-select_field w-select\">\n                  <option value=\"Featured-desc\">Featured</option>\n                  <option value=\"Name-asc\">Name (A-Z)</option>\n                  <option value=\"Name-desc\">Name (Z-A)</option>\n                  <option value=\"Price-asc\">Price (low to high)</option>\n                  <option value=\"Price-desc\">Price (high to low)</option>\n                </select>\n                <a href=\"#\" fs-cmssort-field=\"Featured-desc\" class=\"plp-2026_sort-link w-dropdown-link\">Featured</a>\n              </nav>\n            </div>\n          </form>\n        </div>\n\n        <div class=\"plp-2026_tags\">\n          <a fs-cmsfilter-element=\"tag-template\" href=\"#\" class=\"plp-2026_tag w-inline-block\">\n            <span fs-cmsfilter-element=\"tag-text\" class=\"plp-2026_tag-text\">Tag</span>\n            <span fs-cmsfilter-element=\"tag-remove\" class=\"plp-2026_tag-remove\">\n              <img src=\"{{ 'plp-tag-close.svg' | asset_url }}\" alt=\"Remove filter\" class=\"plp-2026_tag-close\">\n            </span>\n          </a>\n        </div>\n      </div>\n    {%- endif -%}\n\n    {%- paginate collection.products by section.settings.products_per_page -%}\n      {%- if collection.products.size > 0 -%}\n        <div class=\"plp-2026_list w-dyn-list\">\n        <div\n          fs-cmsfilter-element=\"list\"\n          fs-cmssort-element=\"list\"\n          fs-cmsfilter-showquery=\"true\"\n          fs-cmsfilter-tagformat=\"category\"\n          role=\"list\"\n          class=\"plp-2026_grid w-dyn-items\"\n        >\n          {%- for item in collection.products -%}\n            {%- assign roast = item.metafields.custom.roast_profile.value -%}\n            {%- comment -%} The wrapper is the list item so the box button can sit outside the card link. {%- endcomment -%}\n            <div role=\"listitem\" class=\"plp-2026_item w-dyn-item\">\n            <a href=\"{{ item.url }}\" class=\"plp-2026_card\">\n              <div class=\"plp-2026_card-media\">\n                {%- if item.featured_image != blank -%}\n                  <img\n                    src=\"{{ item.featured_image | img_url: '600x' }}\"\n                    srcset=\"{{ item.featured_image | img_url: '300x' }} 300w, {{ item.featured_image | img_url: '600x' }} 600w, {{ item.featured_image | img_url: '900x' }} 900w\"\n                    sizes=\"227px\"\n                    alt=\"{{ item.featured_image.alt | default: item.title | escape }}\"\n                    {% if forloop.index <= 4 %}loading=\"eager\"{% if forloop.first %} fetchpriority=\"high\"{% endif %}{% else %}loading=\"lazy\"{% endif %}\n                    decoding=\"async\"\n                    class=\"plp-2026_card-image\"\n                  >\n                {%- endif -%}\n              </div>\n              <div class=\"plp-2026_card-info\">\n                {%- if roast != blank -%}\n                  <span class=\"plp-2026_card-roast\">{{ roast }} {{ section.settings.roast_suffix }}</span>\n                {%- endif -%}\n                {%- render 'fc-tasting-notes', product_id: item.id -%}\n                <span fs-cmssort-field=\"Name\" class=\"plp-2026_card-title\">{{ item.title }}</span>\n                <span fs-cmssort-field=\"Price\" class=\"plp-2026_card-price\">{{ item.price | money }}</span>\n              </div>\n              {%- comment -%}\n                Finsweet matches the facet checkbox text against these values\n                exactly, so they carry the bare metafield value — the visible\n                label above appends \"Roast\" for display and must stay separate.\n              {%- endcomment -%}\n              <span fs-cmsfilter-field=\"Roast\" class=\"plp-2026_card-hidden\">{{ roast }}</span>\n              <span fs-cmssort-field=\"Featured\" class=\"plp-2026_card-hidden\">{{ item.metafields.custom.featured.value }}</span>\n              <span fs-cmsfilter-field=\"Package\" class=\"plp-2026_card-hidden\">{{ item.metafields.custom.packagetype.value }}</span>\n            </a>\n            {%- render 'box-button', product: item, class: 'fc-box-btn--card' -%}\n            </div>\n          {%- endfor -%}\n        </div>\n        </div>\n      {%- else -%}\n        <p class=\"plp-2026_empty\">{{ section.settings.empty_text }}</p>\n      {%- endif -%}\n\n      {%- if paginate.pages > 1 -%}\n        <nav role=\"navigation\" aria-label=\"Pagination\" class=\"plp-2026_pagination\">\n          {%- if paginate.previous.is_link -%}\n            <a href=\"{{ paginate.previous.url }}\" class=\"plp-2026_page-link\">Previous</a>\n          {%- endif -%}\n          {%- if paginate.next.is_link -%}\n            <a href=\"{{ paginate.next.url }}\" class=\"plp-2026_page-link\">Next</a>\n          {%- endif -%}\n        </nav>\n      {%- endif -%}\n    {%- endpaginate -%}\n  </div>\n</div>\n\n<style>\n  .site-redesign-26.plp-2026 {\n    background-color: #fff;\n  }\n\n  .plp-2026_inner {\n    max-width: var(--site-max-width);\n    margin: 0 auto;\n    display: flex;\n    flex-direction: column;\n    gap: 27px;\n  }\n\n  /* Filter bar ---------------------------------------------------------- */\n\n  .plp-2026_filter-wrap {\n    display: flex;\n    flex-direction: column;\n    gap: 5px;\n  }\n\n  .plp-2026_filter-form {\n    margin: 0;\n  }\n\n  .plp-2026_filter-bar {\n    display: flex;\n    align-items: center;\n    gap: 13px;\n    margin: 0;\n  }\n\n  .plp-2026_filter-label {\n    font-family: \"Avenir Next Condensed\", sans-serif;\n    font-weight: 700;\n    font-size: 28px;\n    line-height: 1.2;\n    color: #000;\n    text-transform: uppercase;\n    margin: 0;\n  }\n\n  .plp-2026_facets {\n    display: flex;\n    align-items: center;\n    gap: 13px;\n  }\n\n  .plp-2026_facet {\n    position: relative;\n    margin: 0;\n  }\n\n  .plp-2026_facet-toggle {\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    gap: 10px;\n    padding: 0;\n    color: #000;\n    cursor: pointer;\n  }\n\n  .plp-2026_facet-label {\n    font-family: \"Avenir Next Condensed\", sans-serif;\n    font-weight: 600;\n    font-size: 24px;\n    line-height: 1.2;\n    color: #000;\n  }\n\n  .plp-2026_facet-chevron {\n    width: 14.76px;\n    height: 9.41px;\n    display: block;\n    transition: transform 0.2s;\n  }\n\n  /* Webflow adds w--open to the toggle and the list, never to the\n     .w-dropdown wrapper — so the chevron rule has to hang off the toggle. */\n  .plp-2026_facet-toggle.w--open .plp-2026_facet-chevron {\n    transform: rotate(180deg);\n  }\n\n  /* Base stays display:none so Webflow's w--open toggle still controls\n     visibility — .w-dropdown-list is display:none by default and this\n     block loads after components.css, so setting display here would\n     pin the panel open. */\n  .plp-2026_facet-panel {\n    background-color: var(--dark-grey);\n    border: 2.47px solid var(--butterscotch);\n    border-radius: 24.7px;\n    padding: 30px 21px;\n    min-width: 211px;\n    gap: 8px;\n    z-index: 5;\n  }\n\n  .plp-2026_facet-panel.w--open {\n    display: flex;\n  }\n\n  .plp-2026_facet-options {\n    display: flex;\n    flex-direction: column;\n    gap: 11.5px;\n    flex: 1;\n  }\n\n  .plp-2026_check {\n    display: flex;\n    align-items: center;\n    gap: 9px;\n    margin: 0;\n    padding: 0;\n    cursor: pointer;\n  }\n\n  .plp-2026_check-box {\n    flex-shrink: 0;\n    width: 18.11px;\n    height: 18.11px;\n    margin: 0;\n    border: 0.823px solid #fff;\n    border-radius: 0;\n    background-color: transparent;\n    background-position: center;\n    background-repeat: no-repeat;\n    background-size: 12.35px 11.53px;\n  }\n\n  .plp-2026_check-box.w--redirected-checked {\n    background-color: transparent;\n    border-color: #fff;\n    background-image: url({{ 'plp-check.svg' | asset_url }});\n  }\n\n  .plp-2026_check-label {\n    font-family: \"Avenir Next Condensed\", sans-serif;\n    font-weight: 600;\n    font-size: 19.76px;\n    line-height: 1;\n    color: #fff;\n    text-transform: uppercase;\n  }\n\n  .plp-2026_facet-reset {\n    align-self: flex-start;\n    font-family: Avenirnextltpro, sans-serif;\n    font-weight: 500;\n    font-size: 11.5px;\n    line-height: 1.7;\n    color: #fff;\n    text-transform: uppercase;\n    text-decoration: none;\n    white-space: nowrap;\n  }\n\n  .plp-2026_sort {\n    margin: 0 0 0 auto;\n  }\n\n  .plp-2026_sort-toggle {\n    display: flex;\n    align-items: center;\n    height: 36px;\n    padding: 0 6px;\n    border: 2px solid var(--butterscotch);\n    cursor: pointer;\n  }\n\n  .plp-2026_sort-label,\n  .plp-2026_sort-value {\n    font-family: Avenirnextltpro, sans-serif;\n    font-weight: 600;\n    font-size: 16px;\n    color: #000;\n  }\n\n  .plp-2026_sort-value {\n    color: var(--butterscotch);\n    margin-left: 4px;\n  }\n\n  .plp-2026_sort-chevron {\n    width: 10px;\n    height: 6px;\n    display: block;\n    margin-left: 12px;\n    transition: transform 0.2s;\n  }\n\n  .plp-2026_sort-toggle.w--open .plp-2026_sort-chevron {\n    transform: rotate(180deg);\n  }\n\n  .plp-2026_sort-panel {\n    background-color: var(--dark-grey);\n    border: 2.5px solid var(--butterscotch);\n    border-radius: 25px;\n  }\n\n  .plp-2026_sort-link {\n    color: #fff;\n    font-family: Avenirnextltpro, sans-serif;\n    font-size: 15px;\n    padding: 8px 12px;\n  }\n\n  /* Active filter tags -------------------------------------------------- */\n\n  .plp-2026_tags {\n    display: flex;\n    flex-wrap: wrap;\n    gap: 13px;\n    min-height: 28px;\n  }\n\n  .plp-2026_tag {\n    display: flex;\n    align-items: center;\n    height: 28px;\n    border: 2px solid var(--butterscotch);\n    text-decoration: none;\n    overflow: hidden;\n  }\n\n  .plp-2026_tag-text {\n    padding: 0 6px;\n    font-family: Avenirnextltpro, sans-serif;\n    font-weight: 600;\n    font-size: 16px;\n    color: #000;\n    white-space: nowrap;\n  }\n\n  .plp-2026_tag-remove {\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    background-color: var(--butterscotch);\n    padding: 6px;\n    align-self: stretch;\n  }\n\n  .plp-2026_tag-close {\n    width: 14px;\n    height: 14px;\n    display: block;\n  }\n\n  /* Product grid -------------------------------------------------------- */\n\n  .plp-2026_grid {\n    display: grid;\n    grid-template-columns: repeat(4, minmax(0, 227px));\n    gap: 40px 60px;\n  }\n\n  .plp-2026_item {\n    display: flex;\n    flex-direction: column;\n    align-self: stretch;\n    height: 100%;\n  }\n\n  /* Cards stretch to the tallest in the row; the CTA sits at the bottom (flex-end),\n     so one- and two-line titles still line up. Specificity beats .fc-box-btn.has-tag. */\n  .plp-2026_item .plp-2026_card {\n    flex: 1 1 auto;\n    padding-bottom: 28px;\n  }\n\n  .plp-2026_item .fc-box-btn.fc-box-btn--card {\n    margin-top: auto;\n    flex: 0 0 auto;\n  }\n\n  .plp-2026_card {\n    display: flex;\n    flex-direction: column;\n    gap: 10px;\n    text-decoration: none;\n  }\n\n  .plp-2026_card-media {\n    width: 100%;\n    aspect-ratio: 1;\n    border-radius: 30px;\n    overflow: hidden;\n    background-color: var(--gray-4);\n  }\n\n  .plp-2026_card-image {\n    width: 100%;\n    height: 100%;\n    object-fit: cover;\n    display: block;\n  }\n\n  .plp-2026_card-info {\n    display: flex;\n    flex-direction: column;\n    align-items: center;\n    gap: 8px;\n    padding-top: 4.768px;\n    text-align: center;\n    text-transform: uppercase;\n  }\n\n  .plp-2026_card-roast {\n    font-family: Avenirnextltpro, sans-serif;\n    font-weight: 700;\n    font-size: 14px;\n    line-height: 1.1;\n    color: var(--butterscotch);\n  }\n\n  .plp-2026_card-notes {\n    font-family: Avenirnextltpro, sans-serif;\n    font-size: 13px;\n    line-height: 1.35;\n    text-transform: none;\n    color: #4a4a45;\n    max-width: 100%;\n  }\n\n  .plp-2026_card-title {\n    font-family: \"Avenir Next Condensed\", sans-serif;\n    font-weight: 700;\n    font-size: 24px;\n    line-height: 1;\n    color: #000;\n  }\n\n  .plp-2026_card-price {\n    font-family: Avenirnextltpro, sans-serif;\n    font-weight: 500;\n    font-size: 18px;\n    line-height: 1;\n    color: #000;\n  }\n\n  .plp-2026_card-hidden {\n    display: none;\n  }\n\n  .plp-2026_empty {\n    font-family: Avenirnextltpro, sans-serif;\n    font-size: 18px;\n    color: var(--gray-3);\n    text-align: center;\n    margin: 0;\n  }\n\n  .plp-2026_pagination {\n    display: flex;\n    justify-content: center;\n    gap: 16px;\n  }\n\n  .plp-2026_page-link {\n    font-family: Avenirnextltpro, sans-serif;\n    font-weight: 700;\n    font-size: 16px;\n    text-transform: uppercase;\n    color: #000;\n    text-decoration: none;\n    border-bottom: 2px solid var(--butterscotch);\n    padding-bottom: 2px;\n  }\n\n  @media screen and (max-width: 991px) {\n    .plp-2026_grid {\n      grid-template-columns: repeat(3, minmax(0, 1fr));\n      gap: 32px;\n    }\n\n    .plp-2026_filter-bar {\n      flex-wrap: wrap;\n    }\n\n    .plp-2026_sort {\n      margin-left: 0;\n    }\n  }\n\n  @media screen and (max-width: 660px) {\n    .plp-2026_grid {\n      grid-template-columns: repeat(2, minmax(0, 1fr));\n      gap: 24px;\n    }\n\n    .plp-2026_filter-label {\n      font-size: 24px;\n    }\n\n    .plp-2026_card-title {\n      font-size: 20px;\n    }\n  }\n</style>\n\n<script>var currentSection = document.currentScript.closest('.shopify-section');currentSection.setAttribute(\"class\",\"section_collection-products site-redesign-26\");</script>\n\n{% schema %}\n{\n  \"name\": \"Section - PLP Products\",\n  \"tag\": \"section\",\n  \"class\": \"section_collection-products\",\n  \"settings\": [\n    {\n      \"type\": \"checkbox\",\n      \"id\": \"show_filters\",\n      \"label\": \"Show filter bar\",\n      \"default\": true\n    },\n    {\n      \"type\": \"text\",\n      \"id\": \"filter_label\",\n      \"label\": \"Filter label\",\n      \"default\": \"FILTER\"\n    },\n    {\n      \"type\": \"text\",\n      \"id\": \"sort_label\",\n      \"label\": \"Sort label\",\n      \"default\": \"Sort By:\"\n    },\n    {\n      \"type\": \"text\",\n      \"id\": \"sort_default\",\n      \"label\": \"Default sort value shown\",\n      \"default\": \"Featured\"\n    },\n    {\n      \"type\": \"text\",\n      \"id\": \"reset_label\",\n      \"label\": \"Reset link label\",\n      \"default\": \"RESET\"\n    },\n    {\n      \"type\": \"text\",\n      \"id\": \"roast_suffix\",\n      \"label\": \"Word appended to the roast label on cards\",\n      \"default\": \"Roast\",\n      \"info\": \"Card shows the product's custom.roast_profile metafield followed by this word, e.g. \\\"Dark Roast\\\".\"\n    },\n    {\n      \"type\": \"text\",\n      \"id\": \"empty_text\",\n      \"label\": \"Empty state text\",\n      \"default\": \"No products found.\"\n    },\n    {\n      \"type\": \"range\",\n      \"id\": \"products_per_page\",\n      \"label\": \"Products per page\",\n      \"min\": 12,\n      \"max\": 100,\n      \"step\": 4,\n      \"default\": 100,\n      \"info\": \"Finsweet filters only what is rendered on the page, so keep this high enough to cover the collection.\"\n    }\n  ],\n  \"blocks\": [\n    {\n      \"type\": \"facet\",\n      \"name\": \"Filter facet\",\n      \"settings\": [\n        {\n          \"type\": \"text\",\n          \"id\": \"label\",\n          \"label\": \"Facet label\",\n          \"default\": \"Roast\"\n        },\n        {\n          \"type\": \"text\",\n          \"id\": \"field\",\n          \"label\": \"Finsweet field name\",\n          \"info\": \"Must match the fs-cmsfilter-field on the product card, e.g. Roast or Package.\"\n        },\n        {\n          \"type\": \"text\",\n          \"id\": \"options\",\n          \"label\": \"Options (comma separated)\",\n          \"info\": \"Each must match a product's metafield value exactly, e.g. Light, Medium, Dark, Blend.\"\n        }\n      ]\n    }\n  ],\n  \"presets\": [\n    {\n      \"name\": \"Section - Collection Products\",\n      \"blocks\": [\n        { \"type\": \"facet\", \"settings\": { \"label\": \"Roast\", \"field\": \"Roast\", \"options\": \"Light, Medium, Dark, Blend\" } },\n        { \"type\": \"facet\", \"settings\": { \"label\": \"Package\", \"field\": \"Package\", \"options\": \"16 oz Bags, 5 lb Bulk, Pods\" } }\n      ]\n    }\n  ]\n}\n{% endschema %}\n"
      }
    },
    {
      "filename": "sections/main-product-feature.liquid",
      "body": {
        "type": "TEXT",
        "value": "{%- liquid\n  assign s = section.settings\n  assign bundle = s.bundle_product\n  assign bundle_collection_id = s.bundle_collection.id\n\n  comment\n    The product description drives the page: its first <ul> becomes the bullets in the\n    info column and everything else becomes the partnership copy at the bottom.\n  endcomment\n  assign desc = product.description\n  assign list_html = ''\n  assign copy_html = desc\n  if desc contains '<ul'\n    assign desc_pre = desc | split: '<ul' | first\n    assign desc_rest = desc | remove_first: desc_pre\n    assign list_html = desc_rest | split: '</ul>' | first | append: '</ul>'\n    assign copy_html = desc_pre | append: desc_rest | remove_first: list_html\n  endif\n\n  assign is_split = false\n  if s.feature_layout == 'split'\n    assign is_split = true\n  endif\n  assign is_backdrop = false\n  if s.feature_layout == 'backdrop'\n    assign is_backdrop = true\n  endif\n\n  assign banner = nil\n  assign banner_mobile = nil\n  assign banner_fg = nil\n  for block in section.blocks\n    if block.type == 'banner_image' and banner == nil\n      if block.settings.image != blank\n        assign banner = block.settings.image | image_url: width: 2000\n      elsif block.settings.image_asset != blank\n        assign banner = block.settings.image_asset | asset_url\n      endif\n      if block.settings.mobile_image != blank\n        assign banner_mobile = block.settings.mobile_image | image_url: width: 1000\n      elsif block.settings.mobile_image_asset != blank\n        assign banner_mobile = block.settings.mobile_image_asset | asset_url\n      endif\n      if block.settings.foreground_image != blank\n        assign banner_fg = block.settings.foreground_image | image_url: width: 1100\n      elsif block.settings.foreground_image_asset != blank\n        assign banner_fg = block.settings.foreground_image_asset | asset_url\n      endif\n    endif\n  endfor\n-%}\n\n<style>\n  .fpf {\n    --fpf-bg: {{ s.panel_bg }};\n    --fpf-accent: {{ s.accent_color }};\n    --fpf-text: {{ s.text_color }};\n    --fpf-tag: {{ s.tag_color }};\n    --fpf-discount: {{ s.discount_color }};\n    --fpf-radius: {{ s.panel_radius }}px;\n    margin: var(--desktop-y-spacing) var(--desktop-x-spacing) 0;\n    color: var(--fpf-text);\n  }\n\n  .fpf__panel {\n    max-width: 1292px;\n    margin: 0 auto;\n    overflow: hidden;\n    border-radius: var(--fpf-radius);\n    background: linear-gradient(rgba(0, 0, 0, 0.2), rgba(0, 0, 0, 0.2)), var(--fpf-bg);\n  }\n\n  /* Product image + info */\n  .fpf__top {\n    display: grid;\n    grid-template-columns: 1fr 1fr;\n    gap: 46px;\n    justify-content: center;\n    align-items: flex-start;\n    padding: 50px 50px;\n  }\n\n  .fpf__media {\n    height: 698px;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    overflow: hidden;\n    border-radius: var(--fpf-radius);\n  }\n\n  .fpf__media img {\n    display: block;\n    width: auto;\n    max-width: 100%;\n    height: 665px;\n    object-fit: contain;\n  }\n\n  .fpf__info {\n    min-height: 698px;\n    box-sizing: border-box;\n    padding-top: 16px;\n  }\n\n  .fpf__eyebrow {\n    margin: 0;\n    font-family: Avenirnextltpro, sans-serif;\n    font-size: 15.9px;\n    line-height: 1;\n    color: var(--fpf-accent);\n  }\n\n  .fpf__title {\n    margin: 0;\n    padding-top: 4.8px;\n    font-family: \"Avenir Next Condensed\", sans-serif;\n    font-weight: 700;\n    font-size: 44.5px;\n    line-height: 1;\n    text-transform: uppercase;\n    color: var(--fpf-text);\n  }\n\n  .fpf__price {\n    margin: 16px 0 0;\n    font-family: Avenirnextltpro, sans-serif;\n    font-size: 22.25px;\n    line-height: 1;\n    color: var(--fpf-text);\n  }\n\n  .fpf__bullets {\n    margin: 32px 0 0;\n    padding: 0;\n    font-family: \"Avenir Next Condensed\", sans-serif;\n    font-size: 18px;\n    line-height: 22.25px;\n    color: var(--fpf-text);\n  }\n\n  .fpf__bullets:empty { display: none; }\n  .fpf__bullets--blocks { padding-left: 40px; }\n  .fpf__bullets ul { margin: 0; padding: 0 0 0 40px; }\n  .fpf__bullets li { margin: 0; }\n  .fpf__bullets p { margin: 0 0 12px; }\n\n  .fpf .fbb { margin-top: 30px; }\n\n  /* Format (size) switcher: links to the sibling products */\n  .fpf__formats { margin-top: 30px; display: flex; flex-direction: column; gap: 11px; }\n  .fpf__formats-label { margin: 0; font-family: \"Avenir Next Condensed\", sans-serif; font-weight: 700; font-size: 15px; line-height: 15.9px; color: var(--fpf-text); }\n  .fpf__formats-label:empty { display: none; }\n  .fpf__formats-row { display: flex; flex-wrap: wrap; gap: 14px; }\n  .fpf__format {\n    display: flex; align-items: center; justify-content: center; box-sizing: border-box;\n    min-width: 106px; height: 39px; padding: 6px 15px;\n    border: 2px solid var(--fpf-text); border-radius: 2px; background: transparent; color: var(--fpf-text);\n    font-family: Roboto, sans-serif; font-weight: 700; font-size: 14px; line-height: 14px; letter-spacing: 0.7px;\n    text-align: center; text-decoration: none; white-space: nowrap; transition: background-color .15s, border-color .15s;\n  }\n  a.fpf__format:hover { border-color: var(--fpf-accent); color: var(--fpf-text); }\n  .fpf__format.is-current { background: var(--fpf-accent); border-color: var(--fpf-accent); }\n  a.fpf__format:focus-visible { outline: 2px solid #fff; outline-offset: 3px; }\n  .fpf__formats + .fbb { margin-top: 30px; }\n\n  /* Buy box */\n  .fbb__form { display: flex; flex-direction: column; gap: 30px; }\n  .fbb__options { display: flex; flex-direction: column; gap: 17px; }\n  .fbb__group { margin: 0; padding: 0; border: 0; min-width: 0; display: flex; flex-direction: column; gap: 11px; }\n  .fbb__group--toggle { flex-direction: row; gap: 14px; flex-wrap: wrap; }\n  .fbb__group[hidden], .fbb [hidden] { display: none !important; }\n  .fbb__label {\n    padding: 0; font-family: \"Avenir Next Condensed\", sans-serif; font-weight: 700;\n    font-size: 15px; line-height: 15.9px; color: var(--fpf-text);\n  }\n  .fbb__sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }\n  .fbb__row { display: flex; flex-wrap: wrap; gap: 14px; align-items: flex-start; }\n  .fbb__bag { display: flex; flex-direction: column; align-items: center; gap: 7px; }\n\n  .fbb__opt { position: relative; display: block; cursor: pointer; }\n  .fbb__opt input { position: absolute; opacity: 0; width: 1px; height: 1px; margin: 0; }\n  .fbb__btn {\n    display: flex; align-items: center; justify-content: center; box-sizing: border-box;\n    min-width: 106px; height: 39px; padding: 6px 15px;\n    border: 2px solid var(--fpf-text); border-radius: 2px; background: transparent; color: var(--fpf-text);\n    font-family: Roboto, sans-serif; font-weight: 700; font-size: 14px; line-height: 14px; letter-spacing: 0.7px;\n    text-align: center; white-space: nowrap;\n    transition: background-color .15s, border-color .15s;\n  }\n  .fbb__opt--big .fbb__btn {\n    width: 183px; height: 55px; text-transform: uppercase; white-space: normal;\n  }\n  .fbb__opt:hover .fbb__btn { border-color: var(--fpf-accent); }\n  .fbb__opt input:checked + .fbb__btn { background: var(--fpf-accent); border-color: var(--fpf-accent); }\n  .fbb__opt input:focus-visible + .fbb__btn { outline: 2px solid #fff; outline-offset: 3px; }\n\n  .fbb__tag {\n    position: absolute; z-index: 1; display: flex; align-items: center; justify-content: center; box-sizing: border-box;\n    border-radius: 6.4px; background: var(--fpf-tag); color: #fff; text-align: center; text-transform: uppercase;\n    font-family: \"Avenir Next Condensed\", sans-serif; font-weight: 700; font-size: 9.5px; line-height: 8.75px;\n    pointer-events: none;\n  }\n  .fbb__tag--top { left: 50%; bottom: calc(100% - 8px); transform: translateX(-50%); width: 70px; height: 23px; }\n  .fbb__tag--corner { top: -15px; left: calc(100% - 16px); padding: 7px; white-space: nowrap; }\n\n  .fbb__discount {\n    font-family: \"Avenir Next Condensed\", sans-serif; font-weight: 700; font-size: 15.1px; line-height: 15.1px;\n    color: var(--fpf-discount); white-space: nowrap;\n  }\n\n  .fbb__add {\n    box-sizing: border-box; width: 100%; max-width: none; padding: 7.7px 23px; border: 0; border-radius: 2.2px;\n    background: var(--fpf-accent); color: #fff; cursor: pointer;\n    font-family: Avenirnextltpro, sans-serif; font-weight: 700; font-size: 18px; line-height: 38px; text-transform: uppercase;\n    transition: background-color .15s;\n  }\n  .fbb__add:hover:not(:disabled) { filter: brightness(0.9); }\n  .fbb__add:focus-visible { outline: 2px solid #fff; outline-offset: 3px; }\n  .fbb__add:disabled { opacity: .5; cursor: not-allowed; }\n  /* Create a Box leads the options, then an \"or\" rule. Hidden until assets/box-builder.js shows the button. */\n  .fpf__box-lead { margin-top: 40px; display: flex; flex-direction: column; gap: 10px; }\n  .fpf__box-lead:not(:has(.fc-box-btn:not([hidden]))) { display: none; }\n  .fpf__box-lead .fc-box-btn { margin-top: 0; }\n  .fpf__box-lead .fc-box-btn--solid { background: var(--fpf-accent); border-color: var(--fpf-accent); }\n  .fpf__or {\n    display: flex; padding-top: 30px; align-items: center; gap: 16px; margin: 0;\n    font-family: Avenirnextltpro, sans-serif; font-weight: 700; font-size: 14px; line-height: 1;\n    letter-spacing: .08em; text-transform: uppercase; color: var(--fpf-text);\n  }\n  .fpf__or::before, .fpf__or::after { content: \"\"; flex: 1; height: 1px; background: currentColor; opacity: .35; }\n  .fbb__error { margin: 12px 0 0; font-family: Avenirnextltpro, sans-serif; font-size: 14px; color: #ff6b61; }\n\n  /* Feature area */\n  .fpf__feature {\n    display: flex; flex-direction: column; align-items: center; text-align: center;\n    min-height: 727px; box-sizing: border-box; padding: 105px 108px 56px;\n    background-color: var(--fpf-bg); background-image: var(--fpf-banner, none); background-size: cover; background-position: center;\n  }\n  .fpf__quote { max-width: 935px; margin: 0 0 10px; }\n  .fpf__quote-text {\n    margin: 0; font-family: \"Avenir Next Condensed\", sans-serif; font-weight: 700; font-size: 44.5px; line-height: 49px; color: var(--fpf-text);\n  }\n  .fpf__quote-by {\n    margin: 0; font-family: \"Avenir Next Condensed\", sans-serif; font-weight: 700; font-size: 24px; line-height: 49px; text-transform: uppercase; color: var(--fpf-text);\n  }\n  .fpf__logo { display: block; width: var(--fpf-logo-w-set, 321px); max-width: 100%; height: auto; margin: 0 auto 56px; }\n  .fpf__body {\n    max-width: 1027px; margin: 0 0 56px; font-family: \"Avenir Next Condensed\", sans-serif; font-size: 27px; line-height: 34px; color: var(--fpf-text);\n  }\n  .fpf__body p { margin: 0 0 1em; }\n  .fpf__body p:last-child { margin-bottom: 0; }\n\n  .fpf__heading {\n    margin: 0 0 24px; font-family: \"Avenir Next Condensed\", sans-serif; font-weight: 700;\n    font-size: 55px; line-height: 49px; text-transform: uppercase; color: var(--fpf-text);\n  }\n\n  /* Split feature layout: logo left, heading + copy right, banner anchored to the bottom */\n  .fpf__feature--split {\n    min-height: 0; padding: 10px 50px 0; align-items: stretch; text-align: left; background: transparent;\n    --fpf-fade: color-mix(in srgb, var(--fpf-bg) 80%, #000);\n  }\n  .fpf__split { position: relative; z-index: 1; display: flex; gap: 48px; align-items: center; justify-content: center; }\n  .fpf__split-logo { flex: 0 0 auto; }\n  .fpf__split-logo .fpf__logo { width: var(--fpf-logo-w-set, 284px); margin: 0; border-radius: 50%; }\n  .fpf__split-text { flex: 0 1 678px; display: flex; flex-direction: column; gap: 14px; }\n  .fpf__split-text .fpf__heading { max-width: 557px; margin: 0; }\n  .fpf__split-text .fpf__quote { max-width: none; margin: 0; }\n  .fpf__split-text .fpf__body { max-width: none; margin: 0; font-size: 22px; line-height: 31px; }\n  .fpf__scene {\n    position: relative; height: 419px; margin: -4px -50px 0;\n    background-color: var(--fpf-fade); background-image: var(--fpf-banner, none); background-size: cover; background-position: center top;\n  }\n  .fpf__scene::before {\n    content: \"\"; position: absolute; top: 0; left: 0; right: 0; height: 270px;\n    background: linear-gradient(to bottom, var(--fpf-fade) 10.236%, transparent);\n  }\n  .fpf__scene-fg { position: absolute; left: 90px; bottom: 0; display: block; width: 517px; max-width: 45%; height: auto; }\n\n  /* Backdrop layout (BAFO, Figma 500:354): the banner photo sits behind the lower part of the\n     whole panel, left-aligned at 2448px wide on a 1292px panel; the product description's\n     paragraph moves up under the bullets; the feature area is an optional video, then the\n     cut-out photo beside the logo and copy, flush with the panel's bottom edge. */\n  .fpf__panel--backdrop { position: relative; isolation: isolate; }\n  .fpf__backdrop {\n    position: absolute; z-index: -1; left: 0; bottom: 0; width: 189.5%; aspect-ratio: 16 / 9;\n    background-image: var(--fpf-banner, none); background-size: cover; background-position: left top;\n    pointer-events: none;\n  }\n  .fpf__summary {\n    margin-top: 14px; padding-top: 10px; font-family: \"Avenir Next Condensed\", sans-serif;\n    font-size: 16px; line-height: 22.25px; color: var(--fpf-text);\n  }\n  .fpf__summary p { margin: 0 0 12px; }\n  .fpf__summary p:last-child { margin-bottom: 0; }\n  .fpf__feature--backdrop {\n    min-height: 0; padding: 63px 0 0; align-items: stretch; text-align: left; background: transparent;\n  }\n  .fpf__video { position: relative; width: 888px; max-width: calc(100% - 100px); margin: 0 auto 49px; aspect-ratio: 16 / 9; background: #000; }\n  .fpf__video video, .fpf__video iframe { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; object-fit: cover; }\n  /* Play button: matches .vimeo-video-2026_big-play on the homepage */\n  .fpf__video-toggle {\n    position: absolute; inset: 0; display: flex; align-items: center; justify-content: center;\n    padding: 0; border: 0; background: transparent; cursor: pointer;\n  }\n  .fpf__video-play {\n    display: flex; align-items: center; justify-content: center; width: 76px; height: 76px; border-radius: 50%;\n    background-color: rgba(0, 0, 0, 0.55); color: #fff; transition: opacity 0.2s, transform 0.2s;\n  }\n  .fpf__video-play svg { width: 38px; height: 38px; margin-left: 4px; }\n  .fpf__video-toggle:hover .fpf__video-play { transform: scale(1.06); }\n  .fpf__video-toggle:focus-visible { outline: 2px solid #fff; outline-offset: -4px; }\n  .fpf__video.is-playing .fpf__video-play { opacity: 0; }\n  .fpf__story { display: flex; align-items: center; gap: 34px; padding-left: 33px; }\n  .fpf__story-fg { flex: 0 0 573px; align-self: flex-end; display: block; width: 573px; height: auto; }\n  .fpf__story-text { flex: 0 1 606px; display: flex; flex-direction: column; align-items: center; gap: 48px; padding: 40px 0; }\n  .fpf__story-text .fpf__logo { width: var(--fpf-logo-w-set, 150px); margin: 0; }\n  .fpf__story-text .fpf__heading,\n  .fpf__story-text .fpf__quote { align-self: stretch; margin: 0; }\n  .fpf__story-text .fpf__body { align-self: stretch; max-width: none; margin: 0; font-size: 31px; line-height: 35px; }\n  .fpf__story-text .fpf__body p { margin-bottom: 35px; }\n  .fpf__story-text .fpf__body p:last-child { margin-bottom: 0; }\n\n  @media screen and (max-width: 991px) {\n    .fpf__backdrop { width: 300%; background-image: var(--fpf-banner-m, var(--fpf-banner, none)); }\n    /* The bio sits over the photo's top edge on narrow screens: fade that edge into the panel and lift the text off it. */\n    .fpf__backdrop::before { content: \"\"; position: absolute; top: 0; left: 0; right: 0; height: 30%; background: linear-gradient(to bottom, var(--fpf-bg), transparent); }\n    .fpf__story-text .fpf__body { text-shadow: 0 1px 4px rgba(0, 0, 0, 0.85); }\n    .fpf__feature--backdrop { padding-top: 16px; }\n    .fpf__video { max-width: calc(100% - 48px); margin-bottom: 32px; }\n    .fpf__story { flex-direction: column-reverse; align-items: center; gap: 24px; padding: 0 24px; }\n    .fpf__story-fg { flex: none; align-self: center; width: 85%; max-width: 420px; }\n    .fpf__story-text { flex: none; gap: 24px; padding: 0; }\n    .fpf__story-text .fpf__logo { width: min(var(--fpf-logo-w-set, 150px), 120px); }\n    .fpf__story-text .fpf__body { font-size: 20px; line-height: 1.35; }\n    .fpf__story-text .fpf__body p { margin-bottom: 20px; }\n  }\n\n  @media screen and (max-width: 991px) {\n    .fpf__heading { font-size: 34px; line-height: 1.05; margin-bottom: 16px; }\n    .fpf__feature--split { padding: 16px 24px 0; }\n    .fpf__split { flex-direction: column; gap: 24px; }\n    .fpf__split-logo .fpf__logo { width: min(var(--fpf-logo-w-set, 284px), 200px); }\n    .fpf__split-text .fpf__body { font-size: 19px; line-height: 1.4; }\n    .fpf__scene { height: 280px; margin: 24px -24px 0; background-image: var(--fpf-banner-m, var(--fpf-banner, none)); }\n    .fpf__scene::before { height: 160px; }\n    .fpf__scene-fg { left: 12px; width: 62%; max-width: 340px; }\n  }\n\n  @media screen and (max-width: 991px) {\n    .fpf__top { grid-template-columns: 1fr; gap: 0; padding: 24px 24px 40px; }\n    .fpf__media { height: auto; padding: 24px 0; }\n    .fpf__media img { height: auto; max-height: 520px; }\n    .fpf__info { min-height: 0; }\n    .fpf__bullets--blocks, .fpf__bullets ul { padding-left: 24px; }\n    .fbb__opt--big .fbb__btn { width: 100%; }\n    .fbb__group--toggle > .fbb__opt { flex: 1 1 183px; }\n    .fbb__tag--corner { left: auto; right: -6px; }\n    .fbb__add, .fpf__box-lead { max-width: none; }\n    .fpf__split-text { flex: auto }\n    .fpf__feature { min-height: 0; background-image: var(--fpf-banner-m, var(--fpf-banner, none)); }\n    .fpf__feature:not(.fpf__feature--split):not(.fpf__feature--backdrop) { padding: 56px 24px 40px; }\n    .fpf__quote-text { font-size: 28px; line-height: 1.15; }\n    .fpf__quote-by { font-size: 18px; line-height: 1.6; }\n    .fpf__logo { width: min(var(--fpf-logo-w-set, 321px), 220px); margin-bottom: 32px; }\n    .fpf__body { font-size: 19px; line-height: 1.4; margin-bottom: 24px; }\n  }\n</style>\n\n<section class=\"fpf\" id=\"fpf-{{ section.id }}\">\n  <div class=\"fpf__panel{% if is_backdrop %} fpf__panel--backdrop{% endif %}\">\n    {%- if is_backdrop and banner != nil -%}\n      <div class=\"fpf__backdrop\" style=\"--fpf-banner: url('{{ banner }}');{% if banner_mobile != nil %} --fpf-banner-m: url('{{ banner_mobile }}');{% endif %}\" aria-hidden=\"true\"></div>\n    {%- endif -%}\n    <div class=\"fpf__top\">\n      <div class=\"fpf__media\">\n        {%- liquid\n          assign product_img = nil\n          if s.product_image != blank\n            assign product_img = s.product_image | image_url: width: 1000\n          elsif product.featured_image != blank\n            assign product_img = product.featured_image | image_url: width: 1000\n          elsif s.product_image_asset != blank\n            assign product_img = s.product_image_asset | asset_url\n          endif\n        -%}\n        {%- if product_img != nil -%}\n          <img src=\"{{ product_img }}\" alt=\"{{ s.product_image.alt | default: product.title | escape }}\" width=\"401\" height=\"665\" loading=\"eager\">\n        {%- endif -%}\n      </div>\n\n      <div class=\"fpf__info\">\n        {%- assign eyebrow = s.eyebrow_text | default: product.type -%}\n        {%- if eyebrow != blank -%}\n          <p class=\"fpf__eyebrow\">{{ eyebrow }}</p>\n        {%- endif -%}\n        <h1 class=\"fpf__title\">{{ product.title }}</h1>\n        <!-- Start of Judge.me code --> <div class='jdgm-widget jdgm-preview-badge' data-id='{{ product.id }}' data-auto-install='false'> {{ product.metafields.judgeme.badge }} </div> <!-- End of Judge.me code -->\n        <p class=\"fpf__price\">{{ product.selected_or_first_available_variant.price | money }}</p>\n\n        {%- if list_html != blank -%}\n          <div class=\"fpf__bullets\">{{ list_html }}</div>\n        {%- else -%}\n          <ul class=\"fpf__bullets fpf__bullets--blocks\">\n            {%- for block in section.blocks -%}\n              {%- if block.type == 'bullet' -%}\n                <li {{ block.shopify_attributes }}>{{ block.settings.text }}</li>\n              {%- endif -%}\n            {%- endfor -%}\n          </ul>\n        {%- endif -%}\n\n        {%- if is_backdrop and copy_html != blank -%}\n          <div class=\"fpf__summary\">{{ copy_html }}</div>\n        {%- endif -%}\n\n        {%- render 'feature-box-lead', product: product -%}\n        {%- liquid\n          assign format_count = 0\n          for block in section.blocks\n            if block.type == 'format' and block.settings.product != blank\n              assign format_count = format_count | plus: 1\n            endif\n          endfor\n        -%}\n        {%- if format_count > 1 -%}\n          <div class=\"fpf__formats\">\n            <p class=\"fpf__formats-label\">{{ s.formats_label }}</p>\n            <div class=\"fpf__formats-row\">\n              {%- for block in section.blocks -%}\n                {%- if block.type == 'format' and block.settings.product != blank -%}\n                  {%- assign format_product = block.settings.product -%}\n                  {%- assign format_name = block.settings.label | default: format_product.title -%}\n                  {%- if format_product.handle == product.handle -%}\n                    <span class=\"fpf__format is-current\" aria-current=\"page\" {{ block.shopify_attributes }}>{{ format_name }}</span>\n                  {%- else -%}\n                    <a class=\"fpf__format\" href=\"{{ format_product.url }}\" {{ block.shopify_attributes }}>{{ format_name }}</a>\n                  {%- endif -%}\n                {%- endif -%}\n              {%- endfor -%}\n            </div>\n          </div>\n        {%- else -%}\n          {%- render 'format-switcher', product: product, label: s.formats_label -%}\n        {%- endif -%}\n\n        {%- render 'feature-buy-box', product: product, section: section, bundle: bundle, collection_id: bundle_collection_id -%}\n      </div>\n    </div>\n\n    {%- capture banner_vars -%}{% if banner != nil %}--fpf-banner: url('{{ banner }}');{% endif %}{% if banner_mobile != nil %} --fpf-banner-m: url('{{ banner_mobile }}');{% endif %}{%- endcapture -%}\n    {%- capture logo_html -%}\n      {%- for block in section.blocks -%}\n        {%- if block.type == 'partner_logo' -%}\n          {%- liquid\n            assign logo = nil\n            if block.settings.image != blank\n              assign logo = block.settings.image | image_url: width: 700\n            elsif block.settings.image_asset != blank\n              assign logo = block.settings.image_asset | asset_url\n            endif\n          -%}\n          {%- if logo != nil -%}\n            <img\n              class=\"fpf__logo\"\n              src=\"{{ logo }}\"\n              alt=\"{{ block.settings.alt | escape }}\"\n              width=\"{{ block.settings.max_width }}\"\n              height=\"{{ block.settings.max_width }}\"\n              loading=\"lazy\"\n              style=\"--fpf-logo-w-set: {{ block.settings.max_width }}px;\"\n              {{ block.shopify_attributes }}\n            >\n          {%- endif -%}\n        {%- endif -%}\n      {%- endfor -%}\n    {%- endcapture -%}\n\n    {%- if is_backdrop -%}\n      <div class=\"fpf__feature fpf__feature--backdrop\">\n        {%- for block in section.blocks -%}\n          {%- if block.type == 'video' -%}\n            {%- assign v = block.settings -%}\n            {%- if v.video != blank -%}\n              <div class=\"fpf__video\" {{ block.shopify_attributes }}>\n                {{ v.video | video_tag: image_size: '1100x', controls: true, playsinline: true, preload: 'metadata' }}\n              </div>\n            {%- elsif v.video_url != blank -%}\n              <div class=\"fpf__video\" {{ block.shopify_attributes }}>\n                {%- if v.video_url.type == 'youtube' -%}\n                  <iframe src=\"https://www.youtube-nocookie.com/embed/{{ v.video_url.id }}?rel=0\" title=\"{{ v.title | default: product.title | escape }}\" loading=\"lazy\" allow=\"accelerometer; autoplay; encrypted-media; gyroscope; picture-in-picture\" allowfullscreen></iframe>\n                {%- elsif v.video_url.type == 'vimeo' -%}\n                  {%- comment -%} Unlisted Vimeo links carry a privacy hash after the ID (vimeo.com/ID/HASH or ?h=HASH); the player needs it. {%- endcomment -%}\n                  {%- liquid\n                    assign vimeo_raw = v.video_url | append: ''\n                    assign vimeo_hash = ''\n                    if vimeo_raw contains 'h='\n                      assign vimeo_hash = vimeo_raw | split: 'h=' | last | split: '&' | first\n                    else\n                      assign vimeo_after = vimeo_raw | split: v.video_url.id | last | split: '?' | first | remove_first: '/'\n                      assign vimeo_hash = vimeo_after | split: '/' | first\n                    endif\n                  -%}\n                  {%- comment -%} Same treatment as the homepage video (section-vimeo-video): Vimeo's own UI is off and a single round play button sits on top. {%- endcomment -%}\n                  <iframe src=\"https://player.vimeo.com/video/{{ v.video_url.id }}?{% if vimeo_hash != blank %}h={{ vimeo_hash }}&amp;{% endif %}badge=0&amp;autopause=0&amp;controls=0&amp;title=0&amp;byline=0&amp;portrait=0&amp;dnt=1\" title=\"{{ v.title | default: product.title | escape }}\" loading=\"lazy\" allow=\"autoplay; fullscreen; picture-in-picture\" allowfullscreen data-fpf-vimeo></iframe>\n                  <button type=\"button\" class=\"fpf__video-toggle\" data-fpf-video-toggle aria-label=\"Play video\">\n                    <span class=\"fpf__video-play\" aria-hidden=\"true\">\n                      <svg viewBox=\"0 0 24 24\"><path d=\"M8 5v14l11-7z\" fill=\"currentColor\"/></svg>\n                    </span>\n                  </button>\n                {%- endif -%}\n              </div>\n            {%- endif -%}\n          {%- endif -%}\n        {%- endfor -%}\n        <div class=\"fpf__story\">\n          {%- if banner_fg != nil -%}\n            <img class=\"fpf__story-fg\" src=\"{{ banner_fg }}\" alt=\"\" width=\"573\" height=\"573\" loading=\"lazy\">\n          {%- endif -%}\n          <div class=\"fpf__story-text\">\n            {{ logo_html }}\n            {%- for block in section.blocks -%}\n              {%- case block.type -%}\n                {%- when 'heading' -%}\n                  {%- if block.settings.text != blank -%}\n                    <h2 class=\"fpf__heading\" {{ block.shopify_attributes }}>{{ block.settings.text | escape }}</h2>\n                  {%- endif -%}\n                {%- when 'quote' -%}\n                  <div class=\"fpf__quote\" {{ block.shopify_attributes }}>\n                    {%- if block.settings.quote != blank -%}\n                      <p class=\"fpf__quote-text\">{{ block.settings.quote | escape }}</p>\n                    {%- endif -%}\n                    {%- if block.settings.attribution != blank -%}\n                      <p class=\"fpf__quote-by\">{{ block.settings.attribution | escape }}</p>\n                    {%- endif -%}\n                  </div>\n                {%- when 'rich_text' -%}\n                  {%- comment -%} The description's paragraph is already under the bullets, so only explicit copy shows here. {%- endcomment -%}\n                  {%- if block.settings.text != blank -%}\n                    <div class=\"fpf__body\" {{ block.shopify_attributes }}>{{ block.settings.text }}</div>\n                  {%- endif -%}\n              {%- endcase -%}\n            {%- endfor -%}\n          </div>\n        </div>\n      </div>\n    {%- elsif is_split -%}\n      <div class=\"fpf__feature fpf__feature--split\">\n    