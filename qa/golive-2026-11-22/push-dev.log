    {
      "filename": "assets/cart-2026.css",
      "body": {
        "type": "TEXT",
        "value": "/* Cart page and slide-out mini cart: white background with black type and gold actions,\n   matching the PLP and PDP. Loaded site-wide from layout/theme.liquid for the mini cart. */\n\n.section_cart-page { background: #fff; color: #000; font-family: Avenirnextltpro, \"Avenir Next\", sans-serif; }\n.section_cart-page .cart-form, .section_cart-page .cart-item_info { color: #000; }\n\n.section_cart-page .h3 {\n  margin: 0; color: #000; font-family: \"Avenir Next Condensed\", Avenirnextltpro, sans-serif;\n  font-weight: 700; font-size: 44px; line-height: 1; text-transform: uppercase;\n}\n.section_cart-page .cart-label { color: #000; font-weight: 700; font-size: 14px; letter-spacing: .06em; text-transform: uppercase; }\n.section_cart-page .home-dashed-rule_right { height: 1px; background: rgba(0, 0, 0, .15); }\n\n/* Line items */\n.section_cart-page .cart-item_grid { padding: 20px 0; border-bottom: 1px solid rgba(0, 0, 0, .1); }\n.section_cart-page .cart-item-image { border-radius: 20px; background: #f3f3f3; object-fit: cover; }\n.section_cart-page .cart-item-title {\n  color: #000; font-family: \"Avenir Next Condensed\", Avenirnextltpro, sans-serif;\n  font-weight: 700; font-size: 24px; line-height: 1.05; text-transform: uppercase;\n}\n.section_cart-page .p-medium.is-cart { color: #000; font-weight: 500; font-size: 18px; line-height: 1.3; }\n.section_cart-page .cart-item_info .p-medium.is-cart + .p-medium.is-cart { font-weight: 400; font-size: 14px; opacity: .75; }\n.section_cart-page .product-price.compare-at { color: rgba(0, 0, 0, .5); font-size: 14px; text-decoration: line-through; }\n.section_cart-page .product-price.compare-at:empty { display: none; }\n.section_cart-page .cart-item_total { align-items: baseline; gap: 8px; }\n.section_cart-page .cart-item_total .p-medium.is-cart { font-weight: 700; }\n.section_cart-page a { color: inherit; text-decoration: none; }\n\n/* Quantity stepper and remove */\n.section_cart-page .udesly-increment-decrement-buttons { border: 1.5px solid #000; border-radius: 2.2px; }\n.section_cart-page .udesly-input-field { height: 40px; color: #000; font-weight: 700; }\n.section_cart-page .udesly-decrement-button, .section_cart-page .udesly-increment-button {\n  display: flex; align-items: center; justify-content: center; min-width: 40px; height: 40px; padding: 0;\n  background: transparent; color: #000; font-size: 18px;\n}\n.section_cart-page .cart-item-remove { color: rgba(0, 0, 0, .55); }\n.section_cart-page .cart-item-remove:hover { color: #000; }\n\n/* Notes, totals, buttons */\n.section_cart-page .cart-footer-text-area { border: 1.5px solid #000; border-radius: 2.2px; background: #fff; color: #000; }\n.section_cart-page .cart-footer-text-area::placeholder { color: rgba(0, 0, 0, .55); }\n.section_cart-page .cart-line:first-child { font-weight: 700; font-size: 20px; }\n.section_cart-page .btn {\n  display: inline-flex; align-items: center; justify-content: center; min-height: 53px; border-radius: 2.2px;\n  font-family: Avenirnextltpro, \"Avenir Next\", sans-serif; font-weight: 700; font-size: 18px; text-transform: uppercase; cursor: pointer;\n}\n.section_cart-page .btn.secondary { border: 1.5px solid #000; background: #fff; color: #000; }\n.section_cart-page .btn.secondary:hover { background: #000; color: #fff; }\n.section_cart-page .btn.mobile-stretch { border: 0; background: #d2a014; color: #fff; }\n.section_cart-page .btn.mobile-stretch:hover { filter: brightness(.9); }\n.section_cart-page .btn:focus-visible, .section_cart-page .fcbox-edit:focus-visible { outline: 2px solid #000; outline-offset: 3px; }\n\n/* Slide-out mini cart (sections/navbar.liquid) */\n.cart_container { background: #fff; color: #000; font-family: Avenirnextltpro, \"Avenir Next\", sans-serif; }\n/* Sticky header stays above the scrolling notes and items (their buttons are position: relative). */\n.cart_container .mini-cart-header { z-index: 2; background: #fff; border-bottom: 1px solid rgba(0, 0, 0, .1); }\n.cart_container .mini-cart_header-text {\n  color: #000; font-family: \"Avenir Next Condensed\", Avenirnextltpro, sans-serif;\n  font-weight: 700; font-size: 28px; line-height: 1; text-transform: uppercase;\n}\n.cart_container .fa-icon.is-minicart, .cart_container .close-button { color: #000; }\n.cart_container .cart-item { margin: 0; padding: 16px 0; border-bottom: 1px solid rgba(0, 0, 0, .1); }\n.cart_container .minicart-img { border-radius: 12px; background: #f3f3f3; }\n.cart_container .p-medium.is-minicart { color: #000; font-weight: 600; line-height: 1.3; }\n.cart_container .product-price.is-minicart { color: #000; font-weight: 700; }\n.cart_container .fc-compare-price { color: rgba(0, 0, 0, .5); font-size: 14px; text-decoration: line-through; }\n.cart_container .input-number.is-minicart { border: 1.5px solid #000; border-radius: 2.2px; background: #fff; color: #000; }\n/* Quantity stepper and trash, matching the cart page. */\n.cart_container .fc-qty-row { display: flex; align-items: center; gap: 12px; margin-top: 8px; }\n.cart_container .input-group.fc-qty { margin: 0; border: 1.5px solid #000; border-radius: 2.2px; align-items: stretch; }\n.cart_container .fc-qty__btn {\n  display: flex; align-items: center; justify-content: center; min-width: 34px; height: 34px; padding: 0;\n  border: 0; background: transparent; color: #000; font-size: 18px; font-weight: 700; cursor: pointer;\n}\n.cart_container .fc-qty .input-number.is-minicart {\n  width: 34px; height: 34px; padding: 0; border: 0; border-radius: 0; text-align: center; font-weight: 700; -moz-appearance: textfield;\n}\n.cart_container .fc-qty .input-number.is-minicart::-webkit-inner-spin-button,\n.cart_container .fc-qty .input-number.is-minicart::-webkit-outer-spin-button { -webkit-appearance: none; margin: 0; }\n.cart_container .fc-qty-row [data-node-type=\"cart-remove-link\"] { display: flex; align-items: center; color: rgba(0, 0, 0, .55); }\n.cart_container .fc-qty-row [data-node-type=\"cart-remove-link\"]:hover { color: #000; }\n.cart_container .fc-qty-row .fa-icon.is-minicart { color: inherit; }\n.cart_container .mini-cart-footer { background: #fff; border-top: 1px solid rgba(0, 0, 0, .1); }\n.cart_container .btn-stretched.secondary {\n  min-height: 53px; border: 0; border-radius: 2.2px; background: #d2a014; color: #fff;\n  font-weight: 700; font-size: 18px; text-transform: uppercase;\n}\n.cart_container .btn-stretched.secondary:hover { background: #d2a014; color: #fff; filter: brightness(.9); }\n\n@media (max-width: 767px) {\n  .section_cart-page .h3 { font-size: 36px; }\n  .section_cart-page .cart-item-title { font-size: 20px; }\n}\n"
      }
