>\n                                        <div\n                                          id=\"w-node-e15bec90-3a80-8654-99bf-0032f21d113b-729082ad\"\n                                          class=\"sale-variant-text\"\n                                        >\n                                          {{ 't7c9b5330' | t }}\n                                        </div>\n                                      </label>\n                                    </div>\n                                  </div>\n                                   <input\n                                    type=\"submit\"\n                                    data-node-type=\"commerce-add-to-cart-button\"\n                                    data-loading-text=\"Adding to cart...\"\n                                    aria-busy=\"false\"\n                                    aria-haspopup=\"dialog\"\n                                    data-wait=\"Adding to cart...\"\n                                    class=\"subscription-add-to-cart is-margin-top w-button\"\n                                    value=\"{{ 'tn26bdceda' | t }}\"\n                                  >\n                                  {% comment %}{%- render \"product-variants-data\" product: product -%}{% endcomment %}\n                                {%- endform -%}\n                                {% comment %}\n                                  <div style=\"display:none\" class=\"w-commerce-commerceaddtocartoutofstock\" tabindex=\"0\">\n                                    <div>{{ 't7aaa2dac' | t }}</div>\n                                  </div>\n                                  <div aria-live=\"assertive\" data-node-type=\"commerce-add-to-cart-error\" style=\"display:none\" class=\"w-commerce-commerceaddtocarterror\">\n                                    <div data-node-type=\"commerce-add-to-cart-error\" data-w-add-to-cart-quantity-error=\"Product is not available in this quantity.\" data-w-add-to-cart-general-error=\"Something went wrong when adding this item to the cart.\" data-w-add-to-cart-mixed-cart-error=\"You can’t purchase another product with a subscription.\" data-w-add-to-cart-buy-now-error=\"Something went wrong when trying to purchase this item.\" data-w-add-to-cart-checkout-disabled-error=\"Checkout is disabled on this site.\" data-w-add-to-cart-select-all-options-error=\"Please select an option in each set.\">{{ 'tn1c765d0d' | t }}</div>\n                                  </div>\n                                {% endcomment %}\n                              </div>\n                            </div>\n                          </div>\n                        </div>\n                      </div>\n                    {%- endif -%}\n                  </div>\n                </div>\n              </div>\n            </div>\n          </div>\n        </div>\n      </section>\n    {%- endif -%}\n    {%- endunless -%}\n    {%- if product.metafields.custom.features -%}\n      <div class=\"section_features\">\n        <div class=\"product-features_bkgd-wrapper\">\n          <img\n            src=\"{{ 'first-cup-product-features-min.png' | asset_url }}\"\n            loading=\"lazy\"\n            sizes=\"100vw\"\n            srcset=\"{{ 'first-cup-product-features-min-p-500.png' | asset_url }} 500w, {{ 'first-cup-product-features-min.png' | asset_url }} 800w\"\n            alt=\"\"\n            class=\"image\"\n          >\n        </div>\n        <div class=\"padding-global\">\n          <div class=\"container-large\">\n            <div class=\"padding-section-medium\">\n              <div class=\"product-features_component\">\n                <div class=\"product-features_container\">\n                  <h1 class=\"product-features_heading\">{{ 't1d52d43d' | t }}</h1>\n                  <div class=\"product-features_wrapper\">\n                    {%- for features in product.metafields.custom.features.value -%}\n                      <div class=\"product-feature\">\n                        <div class=\"icon-embed-custom-3 w-embed\">\n                          <svg\n                            xmlns=\"http://www.w3.org/2000/svg\"\n                            width=\"100%\"\n                            height=\"100%\"\n                            viewBox=\"0 0 595 514\"\n                            fill=\"none\"\n                            preserveAspectRatio=\"xMidYMid meet\"\n                            aria-hidden=\"true\"\n                            role=\"img\"\n                          >\n                            <path d=\"M1.5 512.1H568.91L593.35 453.98V1.5H25.94L1.5 59.63V512.1Z\" stroke=\"currentColor\" stroke-width=\"5\" stroke-miterlimit=\"10\"></path>\n                          </svg>\n                        </div>\n                        <div class=\"product-feature_bkd clipping-mask\">\n                          <div class=\"product-feature_overlay\"></div>\n                          <img\n                            src=\"{{ features.image | img_url: 'master' }}\"\n                            loading=\"lazy\"\n                            alt=\"\"\n                            class=\"product-feature_img\"\n                          >\n                        </div>\n                        <div class=\"product-feature_content\">\n                          <h4 class=\"product-feature_heading\">{{ features.name }}</h4>\n                          <p>{{ features.description }}</p>\n                        </div>\n                      </div>\n                    {%- endfor -%}\n                  </div>\n                </div>\n              </div>\n            </div>\n          </div>\n        </div>\n      </div>\n    {%- endif -%}\n    {%- if product.metafields.custom.partner.value -%}\n      <div class=\"section_partner\">\n        <div class=\"padding-global\">\n          <div class=\"container-large\">\n            <div class=\"padding-section-partner\">\n              <div class=\"partner_component\">\n                <div class=\"partner_bkgd-wrapper-copy\">\n                  <img\n                    src=\"{{ 'first-cup-product-features-min.png' | asset_url }}\"\n                    loading=\"lazy\"\n                    sizes=\"100vw\"\n                    srcset=\"{{ 'first-cup-product-features-min-p-500.png' | asset_url }} 500w, {{ 'first-cup-product-features-min.png' | asset_url }} 800w\"\n                    alt=\"\"\n                    class=\"image\"\n                  >\n                </div>\n                <div class=\"partner_content-wrpr\">\n                  <div class=\"partner_image-wrpr\">\n                    <img\n                      src=\"{{ 'nick-f2.png' | asset_url }}\"\n                      loading=\"lazy\"\n                      sizes=\"100vw\"\n                      srcset=\"{{ 'nick-f2-p-500.png' | asset_url }} 500w, {{ 'nick-f2.png' | asset_url }} 600w\"\n                      alt=\"\"\n                      class=\"image-8\"\n                    >\n                  </div>\n                  <div class=\"partner_content\">\n                    <div class=\"partner_heading-wrpr\">\n                      <div class=\"partner_freitas-logo\">\n                        <img src=\"{{ 'nicks-ugly-mug-logo_horizontal-light.svg' | asset_url }}\" loading=\"lazy\" alt=\"\">\n                      </div>\n                      <div class=\"partner_heading-x\">{{ 't78' | t }}</div>\n                      <div class=\"partner_fcc-logo\">\n                        <img src=\"{{ 'first-cup-lockup-no-date-white.svg' | asset_url }}\" loading=\"lazy\" alt=\"\">\n                      </div>\n                    </div>\n                    <p class=\"paragraph is-category-grid\">\n                      {{ 't4ab0fad5' | t -}}\n                      <br>\n                      <br>\n                      {{ 'tn7e1ef42b' | t }}\n                    </p>\n                  </div>\n                </div>\n              </div>\n            </div>\n          </div>\n        </div>\n      </div>\n    {%- endif -%}\n    <div class=\"padding-global\"><div class=\"container-large\"><!-- Start of Judge.me code -->{% assign has_legacy = false %}{% if product.metafields.judgeme.widget.size > 20 %}{% assign has_legacy = true %}{% endif %}<div style='clear:both'></div><div id='judgeme_product_reviews' class='jdgm-widget jdgm-review-widget' data-product-title='{{ product.title | escape }}' data-id='{{ product.id }}' data-product-id='{{ product.id }}' data-widget='review' data-auto-install='false' data-shop-reviews-count='{{ shop.metafields.judgeme.shop_reviews_count | default: 0 | escape }}' data-entry-point='review_widget.js' data-entry-key='review-widget/main.js'>{% if has_legacy %}<div class='jdgm-legacy-widget-content' style='display: none;'>{{ product.metafields.judgeme.widget }}</div>{% endif %}</div>{% if product.metafields.judgeme.review_widget_data %}<script>jdgm.data ||= {}; jdgm.data.reviewWidget ||= {}; jdgm.data.reviewWidget[{{ product.id }}] = {{ product.metafields.judgeme.review_widget_data }}</script>{% endif %}<!-- End of Judge.me code --></div></div>\n    <div class=\"section_related-products\">\n      <div class=\"padding-global\">\n        <div class=\"container-large\">\n          <div class=\"padding-section-medium\">\n            <div class=\"related-products_component\">\n              <h1 class=\"product-features_heading\">{{ 't1cc955d9' | t }}</h1>\n              <div class=\"related-products_wrapper\">\n                <div\n                  id=\"w-node-a0daa097-caea-b930-ac1a-5f014dbd8f0f-729082ad\"\n                  class=\"w-dyn-list\"\n                  shopify-recommended=\"{{ product.id }}\"\n                >\n                  <div role=\"list\" class=\"collection-list-2 w-dyn-items\"></div>\n                  <div class=\"w-dyn-empty\" style=\"display: none;\">\n                    <div>{{ 't3d503d2b' | t }}</div>\n                  </div>\n                </div>\n              </div>\n            </div>\n          </div>\n        </div>\n      </div>\n    </div>\n  </main>\n  {%- section 'footer' -%}\n</div>\n<script\n  src=\"https://d3e54v103j8qbb.cloudfront.net/js/jquery-3.5.1.min.dc5e7f18c8.js?site=654ae336a6e86029761320fd\"\n  type=\"text/javascript\"\n  integrity=\"sha256-9/aliU8dGd2tb6OSsuzixeV4y/faTqgFtohetphbbj0=\"\n  crossorigin=\"anonymous\"\n></script>\n<script src=\"{{ 'first-cup-coffee.js' | asset_url }}\" type=\"text/javascript\"></script>\n<script>\n  $('.input-number-increment').click(function () {\n    var $input = $(this).parents('.input-number-group').find('.input-number');\n    var val = parseInt($input.val(), 10);\n    $input.val(val + 1);\n  });\n  $('.input-number-decrement').click(function () {\n    var $input = $(this).parents('.input-number-group').find('.input-number');\n    var val = parseInt($input.val(), 10);\n    $input.val(Math.max(val - 1, 1));\n  });\n</script>\n<svg\n  class=\"hide\"\n  width=\"0\"\n  height=\"0\"\n  viewBox=\"0 0 592 511\"\n  xmlns=\"http://www.w3.org/2000/svg\"\n  xmlns:xlink=\"http://www.w3.org/1999/xlink\"\n>\n  <g id=\"Assets\" fill=\"none\">\n    <defs>\n      <clipPath id=\"mask\" clipPathUnits=\"objectBoundingBox\" transform=\"scale(0.001689617301681, 0.00195848021935)\">\n        <path d=\"M0 510.6H567.41L591.85 452.48V0H24.44L0 58.13V510.6Z\"></path>\n      </clipPath>\n    </defs>\n  </g>\n</svg>\n<style>\n  .clipping-mask {\n    \t-webkit-clip-path: url(#mask);\n      clip-path: url(#mask);\n      object-fit: cover;\n      width: 100%;\n      }\n  .hide {\n  height:0 px;\n  }\n</style>\n<script>\n  document.querySelector(\"input[type='submit'].subscription-add-to-cart\").addEventListener('click', async () => {\n    var bundleId = document.querySelector('#wf-form-subscription-box-form').getAttribute('data-bundle-id');\n    var selectedBundleVariantId = document\n      .querySelector(\"input[name='product-count']:checked\", '#wf-form-subscription-box-form')\n      .getAttribute('data-bundle-variant-id');\n    var sellingPlan = document\n      .querySelector(\"input[name='Deliver-Every']:checked\", '#wf-form-subscription-box-form')\n      .getAttribute('data-selling-plan-id');\n    var productId = '{{ product.id }}';\n    var selectedVariant = '{{ product.selected_or_first_available_variant.id }}';\n    var collectionId = document.querySelector('#wf-form-subscription-box-form').getAttribute('data-collection-id');\n    var quantity = parseInt(\n      document.querySelector(\"input[name='product-count']:checked\", '#wf-form-subscription-box-form').value\n    );\n    var productName = $('.desktop-product-header .product_name').text();\n    const bundleProductData = {\n      variantId: selectedBundleVariantId, //ID of the custom coffee box variant (i.e. number of bags)\n      productId: bundleId, //ID of the custom coffee box\n      sellingPlan: sellingPlan,\n    };\n    // This creates the bundle object containing the selections\n    // we'll pass this object to `getBundleId`.\n    const bundle = {\n      externalVariantId: bundleProductData.variantId,\n      externalProductId: bundleProductData.productId,\n      selections: [\n        {\n          collectionId: collectionId,\n          externalProductId: productId,\n          externalVariantId: selectedVariant,\n          quantity: quantity,\n        },\n      ],\n    };\n    const rbId = await recharge.bundle.getBundleId(bundle);\n    // Adds the value directly to the cart\n    const cartData = {\n      items: [\n        {\n          id: bundleProductData.variantId,\n          quantity: 1,\n          selling_plan: bundleProductData.sellingPlan,\n          properties: { Contents: quantity + 'X ' + productName, _rb_id: rbId },\n        },\n      ],\n    };\n    await fetch(window.Shopify.routes.root + 'cart/add.js', {\n      method: 'POST',\n      headers: { 'Content-Type': 'application/json' },\n      body: JSON.stringify(cartData),\n    });\n    window.location.href = '/cart';\n  });\n</script>\n\n{{ 'udesly-shopify.min.js' | asset_url | script_tag }}\n"
      }
    },
    {
      "filename": "assets/box-builder.css",
      "body": {
        "type": "TEXT",
        "value": "/* Subscription box builder: buttons, floating \"Your Box\" pill, drawer, cart note.\n   White panel with black type and gold actions, matching the PLP and PDP. */\n\n:root { --fcbox-gold: #d2a014; --fcbox-ink: #111; --fcbox-line: rgba(0, 0, 0, .2); --fcbox-red: #c33a31; --uniform-green: #3d441e; }\n\nhtml.fcbox-open { overflow: hidden; }\n\n/* Buttons ---------------------------------------------------------------- */\n.fc-box-btn {\n  position: relative; box-sizing: border-box; display: inline-flex; align-items: center; justify-content: center;\n  width: 100%; min-height: 44px; padding: 14px 18px; border: 1.5px solid var(--fcbox-gold); border-radius: 2.2px;\n  background: transparent; color: #111; cursor: pointer;\n  font-family: Avenirnextltpro, \"Avenir Next\", sans-serif; font-weight: 700; font-size: 15px; line-height: 1.2;\n  letter-spacing: .02em; text-transform: uppercase; transition: background-color .15s, color .15s, filter .15s;\n}\n.fc-box-btn[hidden] { display: none; }\n.fc-box-btn:hover, .fc-box-btn.is-active { background: var(--fcbox-gold); color: #fff; }\n.fc-box-btn:focus-visible { outline: 2px solid var(--fcbox-ink); outline-offset: 3px; }\n.fc-box-btn.has-tag { margin-top: 16px; }\n/* Solid gold: PLP cards and the cart prompt. */\n.fc-box-btn--card, .fc-box-btn--solid { background: var(--fcbox-gold); color: #fff; }\n.fc-box-btn--card:hover, .fc-box-btn--solid:hover { filter: brightness(.9); }\n.fc-box-btn--dark { color: #fff; max-width: 468px; margin-top: 14px; font-size: 18px; min-height: 53px; }\n.fc-box-btn--dark:focus-visible { outline-color: #fff; }\n.fc-box-btn--legacy { margin-top: 12px; }\n.fc-box-btn--dark.has-tag, .fc-box-btn--legacy.has-tag { margin-top: 26px; max-width: none; }\n@media (max-width: 767px) { .fc-box-btn--dark { max-width: none; } }\n\n/* Standard PDP: Create a Box leads the options, then an \"or\" rule (templates/product.liquid). */\n.fc-box-lead { margin: 26px 0 24px; display: flex; flex-direction: column; gap: 28px; }\n.fc-box-lead:not(:has(.fc-box-btn:not([hidden]))) { display: none; }\n.fc-box-lead .fc-box-btn { margin-top: 0; min-height: 53px; font-size: 18px; }\n.fc-box-or {\n  display: flex; align-items: center; gap: 16px; margin: 0;\n  font-family: Avenirnextltpro, \"Avenir Next\", sans-serif; font-weight: 700; font-size: 14px; line-height: 1;\n  letter-spacing: .08em; text-transform: uppercase; color: var(--fcbox-ink);\n}\n.fc-box-or::before, .fc-box-or::after { content: \"\"; flex: 1; height: 1px; background: currentColor; opacity: .25; }\n\n/* Red pill above every box button (\"Save up to 15%\"), matching the Most Popular tags. */\n.fc-box-tag {\n  position: absolute; left: 50%; bottom: calc(100% - 6px); transform: translateX(-50%);\n  padding: 3px 9px; border: 1px solid var(--fcbox-gold); border-radius: 6px; background: var(--fcbox-red); color: #fff;\n  font-family: \"Avenir Next Condensed\", Avenirnextltpro, sans-serif; font-weight: 700; font-size: 12px; line-height: 1.25;\n  letter-spacing: .02em; text-transform: uppercase; white-space: nowrap; pointer-events: none;\n}\n\n/* Floating pill ---------------------------------------------------------- */\n.fcbox-fab {\n  position: fixed; right: 20px; bottom: 20px; z-index: 9000; display: inline-flex; align-items: center; gap: 10px;\n  min-height: 48px; padding: 8px 10px 8px 18px; border: 0; border-radius: 999px; background: var(--fcbox-ink); color: #fff; cursor: pointer;\n  box-shadow: 0 6px 20px rgba(0, 0, 0, .3);\n  font-family: Avenirnextltpro, \"Avenir Next\", sans-serif; font-weight: 700; font-size: 14px; text-transform: uppercase; letter-spacing: .04em;\n}\n.fcbox-fab[hidden] { display: none; }\n.fcbox-fab__count { min-width: 32px; padding: 6px 9px; border-radius: 999px; background: var(--fcbox-gold); text-align: center; }\n.fcbox-fab:focus-visible { outline: 2px solid var(--fcbox-gold); outline-offset: 3px; }\nhtml.fcbox-open .fcbox-fab { display: none; }\n\n/* Drawer ----------------------------------------------------------------- */\n.fcbox { position: fixed; inset: 0; z-index: 9500; }\n.fcbox[hidden] { display: none; }\n.fcbox__scrim { position: absolute; inset: 0; background: rgba(0, 0, 0, .55); }\n.fcbox__panel {\n  position: absolute; top: 0; right: 0; bottom: 0; width: min(480px, 100%); display: flex; flex-direction: column;\n  background: #fff; color: var(--fcbox-ink); outline: 0; font-family: Avenirnextltpro, \"Avenir Next\", sans-serif;\n  box-shadow: -8px 0 30px rgba(0, 0, 0, .2); animation: fcbox-in .2s ease-out;\n}\n@keyframes fcbox-in { from { transform: translateX(100%); } to { transform: none; } }\n@media (prefers-reduced-motion: reduce) { .fcbox__panel { animation: none; } }\n\n.fcbox__head { display: flex; align-items: center; justify-content: space-between; padding: 20px 24px 12px; }\n.fcbox__title { margin: 0; color: var(--fcbox-ink); font-family: \"Avenir Next Condensed\", Avenirnextltpro, sans-serif; font-weight: 700; font-size: 30px; line-height: 1.1; text-transform: uppercase; }\n.fcbox__close { width: 44px; height: 44px; margin-right: -10px; border: 0; background: none; color: var(--fcbox-ink); font-size: 32px; line-height: 1; cursor: pointer; }\n.fcbox__body { flex: 1; overflow-y: auto; padding: 0 24px 24px; display: flex; flex-direction: column; gap: 18px; }\n.fcbox button:focus-visible, .fcbox a:focus-visible, .fcbox input:focus-visible + .fcbox__pill { outline: 2px solid var(--fcbox-ink); outline-offset: 2px; }\n\n.fcbox__eyebrow { margin: 0; color: var(--fcbox-gold); font-weight: 700; font-size: 14px; text-transform: uppercase; letter-spacing: .06em; }\n.fcbox__tabs { display: flex; gap: 8px; flex-wrap: wrap; }\n.fcbox__tab { min-height: 40px; padding: 6px 12px; border: 1.5px solid var(--fcbox-ink); border-radius: 2.2px; background: none; color: var(--fcbox-ink); font: inherit; font-weight: 700; font-size: 13px; text-transform: uppercase; cursor: pointer; }\n.fcbox__tab[aria-selected=\"true\"] { border-color: var(--fcbox-gold); background: var(--fcbox-gold); color: #fff; }\n.fcbox__tab-n { opacity: .8; }\n\n.fcbox__slots { display: grid; grid-template-columns: repeat(4, 1fr); gap: 10px; }\n.fcbox__slot { aspect-ratio: 1; display: flex; align-items: center; justify-content: center; border: 1.5px dashed var(--fcbox-line); border-radius: 12px; background: #f6f6f6; color: rgba(0, 0, 0, .35); font-size: 26px; overflow: hidden; }\n.fcbox__slot.is-filled { border: 1.5px solid var(--fcbox-gold); background: #fff; }\n.fcbox__slot img { width: 100%; height: 100%; object-fit: contain; }\n.fcbox__progress, .fcbox__message { margin: 0; font-size: 15px; line-height: 1.4; }\n.fcbox__message { padding: 10px 12px; border-left: 8px solid var(--uniform-green); background: #ddd; }\n.fcbox__message.shadow { background: rgba(246, 246, 246, 0.2); }\n.fcbox__pending { padding: 14px; border: 1.5px solid var(--fcbox-gold); border-radius: 8px; }\n.fcbox__pending-title { margin: 0 0 10px; font-weight: 700; font-size: 15px; }\n.fcbox__pills { display: flex; flex-wrap: wrap; gap: 8px; }\n.fcbox__pill { display: inline-flex; align-items: center; justify-content: center; min-height: 40px; padding: 6px 14px; border: 1.5px solid var(--fcbox-ink); border-radius: 2.2px; background: #fff; color: var(--fcbox-ink); font: inherit; font-weight: 700; font-size: 14px; text-transform: uppercase; cursor: pointer; }\n.fcbox__pill:disabled { opacity: .45; cursor: not-allowed; }\n.fcbox__pill-wrap { position: relative; }\n.fcbox__pill-wrap input { position: absolute; opacity: 0; inset: 0; margin: 0; cursor: pointer; }\n.fcbox__pill-wrap input:checked + .fcbox__pill, button.fcbox__pill:hover:not(:disabled) { border-color: var(--fcbox-gold); background: var(--fcbox-gold); color: #fff; }\n\n.fcbox__items { margin: 0; padding: 0; list-style: none; display: flex; flex-direction: column; gap: 12px; }\n.fcbox__item { display: grid; grid-template-columns: 56px 1fr auto; gap: 12px; align-items: center; }\n.fcbox__item-img { width: 56px; height: 56px; border-radius: 8px; background: #f6f6f6; object-fit: contain; }\n.fcbox__item-text { display: flex; flex-direction: column; min-width: 0; }\n.fcbox__item-title { font-family: \"Avenir Next Condensed\", Avenirnextltpro, sans-serif; font-weight: 700; font-size: 18px; line-height: 1.15; text-transform: uppercase; }\n.fcbox__item-variant { font-size: 13px; opacity: .75; }\n.fcbox__qty { display: flex; align-items: center; border: 1.5px solid var(--fcbox-ink); border-radius: 2.2px; }\n.fcbox__qty button { width: 40px; height: 40px; border: 0; background: none; color: var(--fcbox-ink); font-size: 20px; cursor: pointer; }\n.fcbox__qty button:disabled { opacity: .35; cursor: not-allowed; }\n.fcbox__qty span { min-width: 22px; text-align: center; font-weight: 700; }\n\n.fcbox__plans { margin: 0; padding: 0; border: 0; min-width: 0; }\n.fcbox__plans legend { margin-bottom: 10px; padding: 0; font-weight: 700; font-size: 15px; color: var(--fcbox-ink); }\n\n.fcbox__foot { margin-top: auto; padding-top: 16px; border-top: 1px solid var(--fcbox-line); display: flex; flex-direction: column; gap: 12px; }\n.fcbox__total { display: flex; justify-content: space-between; align-items: baseline; gap: 12px; font-size: 15px; }\n.fcbox__total s { opacity: .6; }\n.fcbox__total strong { font-size: 20px; }\n.fcbox__tag { display: inline-block; padding: 2px 6px; border-radius: 2px; background: var(--fcbox-red); color: #fff; font-style: normal; font-weight: 700; font-size: 12px; text-transform: uppercase; }\n.fcbox__error { margin: 0; font-size: 14px; color: #b3261e; }\n.fcbox__error[hidden] { display: none; }\n.fcbox__cta { width: 100%; min-height: 53px; border: 0; border-radius: 2.2px; background: var(--fcbox-gold); color: #fff; font: inherit; font-weight: 700; font-size: 18px; text-transform: uppercase; cursor: pointer; }\n.fcbox__cta:hover:not(:disabled) { filter: brightness(.9); }\n.fcbox__cta:disabled { opacity: .5; cursor: not-allowed; }\n.fcbox__links { display: flex; justify-content: space-between; }\n.fcbox__links button, .fcbox__links a { display: inline-flex; align-items: center; min-height: 44px; padding: 0; border: 0; background: none; color: var(--fcbox-ink); font: inherit; font-size: 14px; text-decoration: underline; cursor: pointer; }\n\n/* Cart prompt (cart page and slide-out mini cart) -------------------------- */\n.fcbox-notes[hidden] { display: none; }\n.fcbox-note { display: flex; flex-direction: column; gap: 12px; margin-bottom: 24px; padding: 16px 18px; border: 1.5px solid var(--fcbox-gold); border-radius: 8px; }\n.fcbox-note__text { margin: 0; font-size: 16px; line-height: 1.4; }\n.fcbox-notes { display: flex; flex-direction: column; gap: 12px; margin-bottom: 32px; }\n.fcbox-notes--mini { margin-bottom: 0; padding: 14px 12px 0; }\n.fcbox-notes .fcbox-note { margin-bottom: 0; gap: 8px; }\n/* The note's action is a gold text link, not a button (cart page and slide-out). */\n.fcbox-notes .fc-box-btn, .fcbox-notes .fc-box-btn--solid, .fcbox-notes .fc-box-btn.has-tag {\n  width: auto; min-height: 0; margin: 0; padding: 0; border: 0; background: none; color: var(--fcbox-gold);\n  justify-content: flex-start; align-self: flex-start; font-size: 15px; text-decoration: underline; text-underline-offset: 3px;\n}\n.fcbox-notes .fc-box-btn:hover { background: none; color: var(--fcbox-gold); filter: brightness(.85); }\n.fcbox-notes .fc-box-tag { display: none; }\n/* Box line in the cart page and the mini cart: bordered, one coffee per line, Edit / Remove. */\n/* The card is a wrapper inside the row, so the row keeps its own padding and divider line. */\n.section_cart-page .fcbox-line, .cart_container .fcbox-line {\n  padding: 16px; border: 1.5px solid var(--uniform-green); border-radius: 8px;\n}\n.fcbox-line__items { margin: 8px 0 0; padding: 0; list-style: none; color: #000; font-size: 15px; line-height: 1.4; }\n.fcbox-line__items li { display: flex; align-items: center; gap: 10px; padding: 6px 0; border-top: 1px solid var(--fcbox-line); }\n.fcbox-line__img { flex: none; width: 60px; height: 60px; border-radius: 12px; background: #f3f3f3; object-fit: cover; }\n/* Each coffee shows its own image, so the box's single bundle image is hidden. */\n.cart_container .fcbox-line .minicart-img, .section_cart-page .fcbox-line .cart-item_component > a:first-child { display: none; }\n.section_cart-page .fcbox-line .cart-item_component { grid-template-columns: 1.41fr .5fr; }\n/* Cart page: the coffee list and actions span the whole line, under the title and price. */\n.section_cart-page .fcbox-line__details { grid-column: 1 / -1; }\n.section_cart-page .cart-item_grid > .fcbox-line { grid-column: 1 / -1; display: grid; grid-template-columns: 2.3fr .4fr; column-gap: 16px; align-items: start; }\n.section_cart-page .fcbox-line .cart-item_component { margin-bottom: 0; }\n/* Mini cart box line: title and price share the top row; the coffee list and actions run full width below. */\n.cart_container .cart-item > .fcbox-line { flex: 1; display: flex; flex-wrap: wrap; align-items: flex-start; column-gap: 12px; }\n.cart_container .fcbox-line .minicart_prod-info-wrapper { display: contents; }\n.cart_container .fcbox-line .w-commerce-commercecartproductname {\n  flex: 1; order: 0; font-family: \"Avenir Next Condensed\", Avenirnextltpro, sans-serif; font-weight: 700; font-size: 20px;\n  line-height: 1.05; text-transform: uppercase;\n}\n.cart_container .fcbox-line .div-block-7 { order: 1; align-self: flex-start; }\n.cart_container .fcbox-line .fcbox-line__items { order: 2; flex-basis: 100%; }\n.cart_container .fcbox-line .fcbox-line__actions { order: 3; flex-basis: 100%; }\n.cart_container .fcbox-line .minicart_prod-info-wrapper > div:has(.input-number-group) { display: none; }\n@media (max-width: 767px) {\n  .section_cart-page .fcbox-line .cart-item_component { grid-template-columns: 1fr; }\n  .section_cart-page .cart-item_grid > .fcbox-line { grid-template-columns: 2.2fr .5fr; }\n}\n.fcbox-line__items li:first-child { border-top: 0; }\n.fcbox-line__actions { display: flex; flex-wrap: wrap; align-items: baseline; gap: 15px; margin-top: 10px; }\n/* Edit box reads like the gold box links (.fcbox-notes .fc-box-btn); Remove box is the trash icon used on other lines. */\n.fcbox-line__actions .fcbox-edit {\n  margin-top: 0; color: var(--fcbox-gold); font-family: Avenirnextltpro, \"Avenir Next\", sans-serif; font-weight: 700; font-size: 15px;\n  letter-spacing: .02em; text-transform: uppercase; text-decoration: underline; text-underline-offset: 3px;\n}\n.fcbox-line__actions .fcbox-edit:hover { filter: brightness(.85); }\n.fcbox-line__actions .fcbox-edit--remove {\n  font-family: \"Fa Solid 900\", sans-serif; font-weight: 900; font-size: 16px; letter-spacing: 0; text-transform: none;\n  text-decoration: none; color: rgba(0, 0, 0, .55);\n}\n.fcbox-line__actions .fcbox-edit--remove:hover { filter: none; color: #000; }\n/* A box is one bundle line: no quantity stepper or trash icon, Remove box replaces them. */\n.fcbox-line .udesly-input-wrapper, .fcbox-line .cart-item-remove, .fcbox-line .input-number-group,\n.fcbox-line .div-block-7 > [data-node-type=\"cart-remove-link\"] { display: none; }\n.fcbox-edit { display: inline-block; margin-top: 6px; padding: 0; border: 0; background: none; color: inherit; font: inherit; font-size: 14px; text-decoration: underline; cursor: pointer; }\n\n/* Guided start: format chooser and the coffee picker inside the box ------- */\n.fcbox__step { margin: 0; color: var(--fcbox-ink); font-family: \"Avenir Next Condensed\", Avenirnextltpro, sans-serif; font-weight: 700; font-size: 24px; line-height: 1.1; text-transform: uppercase; }\n.fcbox__formats { display: grid; gap: 12px; }\n.fcbox__format { display: grid; grid-template-columns: 84px 1fr; grid-template-rows: 1fr 1fr; column-gap: 14px; row-gap: 4px; padding: 12px; border: 1.5px solid var(--fcbox-ink); border-radius: 12px; background: #fff; color: var(--fcbox-ink); text-align: left; font: inherit; cursor: pointer; }\n.fcbox__format:hover { border-color: var(--fcbox-gold); background: #fdf7e6; }\n.fcbox__format img { grid-row: 1 / 3; width: 84px; height: 84px; object-fit: contain; }\n.fcbox__format-name { grid-column: 2; align-self: end; font-family: \"Avenir Next Condensed\", Avenirnextltpro, sans-serif; font-weight: 700; font-size: 24px; line-height: 1; text-transform: uppercase; }\n.fcbox__format-note { grid-column: 2; align-self: start; color: var(--fcbox-red); font-weight: 700; font-size: 13px; text-transform: uppercase; }\n.fcbox__picker { display: flex; flex-direction: column; gap: 14px; }\n.fcbox__choices { margin: 0; padding: 0; list-style: none; display: flex; flex-direction: column; gap: 16px; }\n.fcbox__choice { display: grid; grid-template-columns: 56px 1fr; gap: 12px; align-items: start; }\n.fcbox__choice-main { display: flex; flex-direction: column; gap: 8px; min-width: 0; }\n.fcbox__pill--add { min-height: 40px; padding: 4px 12px; font-size: 13px; }\n.fcbox__progress a { color: inherit; text-decoration: underline; }\n/* The picker makes the box long, so the total and Subscribe button stay pinned. */\n.fcbox__body { padding-bottom: 0; }\n.fcbox__foot { position: sticky; bottom: 0; z-index: 1; padding-bottom: 16px; background: #fff; }\n"
      }
