: \"purchase_type_legend\", \"label\": \"Purchase type (screen reader)\", \"default\": \"Purchase type\" },\n\n    { \"type\": \"header\", \"content\": \"Related products\" },\n    { \"type\": \"checkbox\", \"id\": \"show_related\", \"label\": \"Show related products\", \"default\": true },\n    { \"type\": \"text\", \"id\": \"related_heading\", \"label\": \"Heading\", \"default\": \"Related Products\" }\n  ],\n  \"blocks\": [\n    {\n      \"type\": \"bullet\",\n      \"name\": \"Bullet (fallback)\",\n      \"settings\": [\n        { \"type\": \"text\", \"id\": \"text\", \"label\": \"Text\", \"info\": \"Only shown if the product description has no bullet list.\" }\n      ]\n    },\n    {\n      \"type\": \"format\",\n      \"name\": \"Size link\",\n      \"settings\": [\n        { \"type\": \"product\", \"id\": \"product\", \"label\": \"Product\", \"info\": \"Add one per size, including this product. The current product is highlighted; the others link to their pages.\" },\n        { \"type\": \"text\", \"id\": \"label\", \"label\": \"Button label\", \"info\": \"Leave blank to use the product title.\" }\n      ]\n    },\n    {\n      \"type\": \"banner_image\",\n      \"name\": \"Banner image\",\n      \"limit\": 1,\n      \"settings\": [\n        { \"type\": \"image_picker\", \"id\": \"image\", \"label\": \"Banner image\" },\n        { \"type\": \"text\", \"id\": \"image_asset\", \"label\": \"Fallback filename (theme asset)\" },\n        { \"type\": \"image_picker\", \"id\": \"mobile_image\", \"label\": \"Mobile banner image\" },\n        { \"type\": \"text\", \"id\": \"mobile_image_asset\", \"label\": \"Mobile fallback filename (theme asset)\" },\n        { \"type\": \"image_picker\", \"id\": \"foreground_image\", \"label\": \"Foreground cut-out (split and backdrop layouts)\", \"info\": \"Transparent PNG shown at the bottom-left of the panel.\" },\n        { \"type\": \"text\", \"id\": \"foreground_image_asset\", \"label\": \"Foreground fallback filename (theme asset)\" }\n      ]\n    },\n    {\n      \"type\": \"video\",\n      \"name\": \"Video (backdrop layout)\",\n      \"limit\": 1,\n      \"settings\": [\n        { \"type\": \"video\", \"id\": \"video\", \"label\": \"Video\", \"info\": \"Uploaded to Shopify. Leave empty to use the link below.\" },\n        { \"type\": \"video_url\", \"id\": \"video_url\", \"label\": \"Or a YouTube / Vimeo link\", \"accept\": [\"youtube\", \"vimeo\"] },\n        { \"type\": \"text\", \"id\": \"title\", \"label\": \"Video title (screen readers)\" }\n      ]\n    },\n    {\n      \"type\": \"heading\",\n      \"name\": \"Heading\",\n      \"settings\": [\n        { \"type\": \"text\", \"id\": \"text\", \"label\": \"Heading\" }\n      ]\n    },\n    {\n      \"type\": \"quote\",\n      \"name\": \"Pull quote\",\n      \"settings\": [\n        { \"type\": \"textarea\", \"id\": \"quote\", \"label\": \"Quote\" },\n        { \"type\": \"text\", \"id\": \"attribution\", \"label\": \"Attribution\" }\n      ]\n    },\n    {\n      \"type\": \"partner_logo\",\n      \"name\": \"Partner logo\",\n      \"settings\": [\n        { \"type\": \"image_picker\", \"id\": \"image\", \"label\": \"Logo\" },\n        { \"type\": \"text\", \"id\": \"image_asset\", \"label\": \"Fallback filename (theme asset)\" },\n        { \"type\": \"text\", \"id\": \"alt\", \"label\": \"Alt text\" },\n        { \"type\": \"range\", \"id\": \"max_width\", \"label\": \"Width\", \"min\": 80, \"max\": 500, \"step\": 10, \"unit\": \"px\", \"default\": 320 }\n      ]\n    },\n    {\n      \"type\": \"rich_text\",\n      \"name\": \"Body copy\",\n      \"settings\": [\n        { \"type\": \"richtext\", \"id\": \"text\", \"label\": \"Text\", \"info\": \"Leave blank to use the product description (without its bullet list).\" }\n      ]\n    }\n  ],\n  \"presets\": [\n    {\n      \"name\": \"Main - Product Feature\",\n      \"blocks\": [\n        { \"type\": \"bullet\" },\n        { \"type\": \"bullet\" },\n        { \"type\": \"bullet\" },\n        { \"type\": \"banner_image\" },\n        { \"type\": \"quote\" },\n        { \"type\": \"partner_logo\" },\n        { \"type\": \"rich_text\" }\n      ]\n    }\n  ]\n}\n{% endschema %}\n"
