    {
      "filename": "templates/product.liquid",
      "body": {
        "type": "TEXT",
        "value": "{%- assign headerSnippetPath = 'header-product' -%}\n{%- assign wfPage = '654d36a6d6abfe37729082ad' -%}\n{%- assign bodyClasses = 'body' -%}\n<div class=\"page-wrapper\">\n  {%- render 'google-icons' -%}\n  {%- render 'global-styles' -%}\n  {%- section 'top-ad' -%}\n  {%- section 'navbar' -%}\n  {%- render 'preloader' -%}\n  <main class=\"main-wrapper\">\n    {%- if product.metafields.custom.partner.value -%}\n      <section class=\"section_imprint-header\">\n        <div class=\"padding-global padding-section-header1\">\n          <div class=\"container-medium\">\n            <div class=\"imprint-header_content\">\n              <div class=\"product_component-wrapper\">\n                <div class=\"product_column is-product-image\">\n                  <div class=\"mobile-product-header\">\n                    <div class=\"product_type\">{{ product.type }}</div>\n                    <h1 class=\"product_name\">{{ product.title }}</h1>\n<!-- Start of Judge.me code --> <div class='jdgm-widget jdgm-preview-badge' data-id='{{ product.id }}' data-auto-install='false'> {{ product.metafields.judgeme.badge }} </div> <!-- End of Judge.me code -->\n                  </div>\n                  <a href=\"#\" class=\"product-lightbox w-inline-block w-lightbox\"\n                    ><img\n                      alt=\"{{ product.featured_image.alt }}\"\n                      loading=\"eager\"\n                      src=\"{{ product.featured_image | img_url: 'master' }}\"\n                      class=\"product-image is-imprint\"\n                      data-commerce-type=\"variation-image\"\n                      srcset=\"{{ product.featured_image | img_url: '1920x' }} 1920w,{{ product.featured_image | img_url: '1600x' }} 1600w,{{ product.featured_image | img_url: '1366x' }} 1366w,{{ product.featured_image | img_url: '1024x' }} 1024w,{{ product.featured_image | img_url: '768x' }} 768w,{{ product.featured_image | img_url: '640x' }} 640w\"\n                    >\n                    <div class=\"zoom-icon w-embed\">\n                      <svg\n                        xmlns=\"http://www.w3.org/2000/svg\"\n                        width=\"100%\"\n                        height=\"100%\"\n                        viewBox=\"0 0 64 64\"\n                        fill=\"none\"\n                        preserveAspectRatio=\"xMidYMid meet\"\n                        aria-hidden=\"true\"\n                        role=\"img\"\n                      >\n                        <path d=\"M30.0098 16.51H24.0098V24.01H16.5098V30.01H24.0098V37.51H30.0098V30.01H37.5098V24.01H30.0098V16.51Z\" fill=\"currentColor\"></path>\n                        <path d=\"M48.09 43.8501C57.4 32.2001 55.5 15.2101 43.85 5.90006C32.21 -3.39994 15.22 -1.49994 5.91001 10.1501C-3.39999 21.8001 -1.49999 38.7901 10.15 48.0901C20.01 55.9601 34 55.9601 43.86 48.0901L59.04 63.2701L63.28 59.0301L48.1 43.8501H48.09ZM27.01 48.0101C15.41 48.0101 6.01001 38.6101 6.01001 27.0101C6.01001 15.4101 15.42 6.01006 27.01 6.01006C38.6 6.01006 48.01 15.4101 48.01 27.0101C48.01 38.6101 38.61 48.0101 27.01 48.0101Z\" fill=\"currentColor\"></path>\n                      </svg>\n                    </div>\n                    <script type=\"application/json\" class=\"w-json\">\n                      {\"items\":[{% for image in product.images %}{\"caption\":\"\",\"url\":\"{{ image | product_img_url: 'master' }}\",\"type\":\"image\"}{% unless forloop.last %},{% endunless %}{% endfor %}],\"group\":\"Product {{ product.id }} images\"}\n                    </script>\n                  </a>\n                </div>\n                <div class=\"product_column is-product-description\">\n                  <div class=\"product_description-component\">\n                    <div class=\"desktop-product-header\">\n                      <div class=\"product_type\">{{ product.type }}</div>\n                      <h1 class=\"product_name\">{{ product.title }}</h1>\n<!-- Start of Judge.me code --> <div class='jdgm-widget jdgm-preview-badge' data-id='{{ product.id }}' data-auto-install='false'> {{ product.metafields.judgeme.badge }} </div> <!-- End of Judge.me code -->\n                    </div>\n                    <div data-commerce-type=\"variation-compare_at_price\" class=\"product-price compare-at\">\n                      {{ product.selected_or_first_available_variant.compare_at_price | money }}\n                    </div>\n                    <div data-commerce-type=\"variation-price\" class=\"product_price\">{{ product.price | money }}</div>\n                    <div class=\"product-description_wrapper\">\n                      <p class=\"product_description-text\">{{ product.metafields.udesly.description }}</p>\n                      <div class=\"product_description-text\">{{ product.description }}</div>\n                    </div>\n                    <div class=\"fc-box-lead\">\n                      <p class=\"fcbox__message\">All subscriptions are eligible for <b>FREE SHIPPING!</b></p>\n                      {%- render 'box-button', product: product, class: 'fc-box-btn--legacy fc-box-btn--solid' -%}\n                      <p class=\"fc-box-or\">or</p>\n                    </div>\n                    {%- render 'format-switcher', product: product, legacy: true -%}\n                    {%- if product.metafields.custom.subscription_type.value == 'Bag' -%}\n                      <div class=\"subscription-product\">\n                        <div\n                          data-current=\"Tab 2\"\n                          data-easing=\"ease\"\n                          data-duration-in=\"300\"\n                          data-duration-out=\"100\"\n                          class=\"w-tabs\"\n                        >\n                          <div class=\"tabs-menu w-tab-menu\">\n                            <a data-w-tab=\"Tab 1\" class=\"button-3 sub-prod-sel_tab is-left w-inline-block w-tab-link\">\n                              <div class=\"sub-prod-sel_text\">{{ 'tn5a6851a7' | t }}</div>\n                              <div class=\"sub-prod-sel_price-wrapper\">\n                                <div data-commerce-type=\"variation-price\">{{ product.price | money }}</div>\n                                <div>{{ 'tn37df6cfd' | t }}</div>\n                              </div>\n                            </a>\n                            <a\n                              data-w-tab=\"Tab 2\"\n                              class=\"sub-prod-sel_tab is-right w-inline-block w-tab-link w--current\"\n                            >\n                              <div class=\"sub-prod-sel_text\">{{ 't788769ed' | t }}</div>\n                              <div class=\"sub-prod-sel_price-wrapper\">\n                                <div data-commerce-type=\"variation-price\">{{ product.price | money }}</div>\n                                <div>{{ 'tn7ec1f6aa' | t }}</div>\n                              </div>\n                              <div class=\"free-shipping-badge\">\n                                <div>\n                                  {{ 't40fc714' | t -}}\n                                  <br>\n                                  {{ 'tn426d07ed' | t }}\n                                </div>\n                              </div>\n                            </a>\n                          </div>\n                          <div class=\"w-tab-content\">\n                            <div data-w-tab=\"Tab 1\" class=\"w-tab-pane\">\n                              <div>\n                                {%- form 'product',\n                                  product,\n                                  data-node-type: 'commerce-add-to-cart-form',\n                                  class: 'w-commerce-commerceaddtocartform'\n                                -%}\n                                  {%- unless product.has_only_default_variant or product.variants.size == 1 -%}\n                                    <div\n                                      data-node-type=\"add-to-cart-option-list\"\n                                      position-id=\"f0ce0ead-d970-b9ab-4467-e897a0bf5ff6\"\n                                    >\n                                      {%- for option in product.options_with_values -%}\n                                        <fieldset\n                                          data-node-type=\"add-to-cart-option\"\n                                          style=\"{% if product.has_only_default_variant or product.variants.size == 1 %}display: none; {% endif %}\"\n                                        >\n                                          <label data-node-type=\"add-to-cart-option-label\">{{ option.name }}</label\n                                          ><select\n                                            data-node-type=\"add-to-cart-option-select\"\n                                            class=\"w-select\"\n                                            style=\"display: none;\"\n                                            name=\"{{ \"option\" | append: forloop.index }}\"\n                                          >\n                                            {%- render 'product-options', option: option -%}\n                                          </select>\n                                          <div\n                                            data-node-type=\"add-to-cart-option-pill-group\"\n                                            class=\"w-commerce-commerceaddtocartoptionpillgroup\"\n                                            aria-label=\"{{ \"option\" | append: forloop.index  }}\"\n                                          >\n                                            {%- for value in option.values -%}\n                                              <div\n                                                data-node-type=\"add-to-cart-option-pill\"\n                                                class=\"button-3 w-commerce-commerceaddtocartoptionpill\"\n                                                data-option-name=\"{{ value | handle }}\"\n                                              >\n                                                <div data-node-type=\"block\">{{ value }}</div>\n                                              </div>\n                                            {%- endfor -%}\n                                          </div>\n                                        </fieldset>\n                                      {%- endfor -%}\n                                    </div>\n                                  {%- endunless -%}\n                                  <div position-id=\"f0ce0ead-d970-b9ab-4467-e897a0bf5ffd\" class=\"add-to-cart_component\">\n                                    {%- assign condition_value = product.type | strip -%}\n                                    {%- unless condition_value == 'e348fd487d0102946c9179d2a94bb613' -%}\n                                      <label for=\"quantity-75f2feb68714ea4665d3ede4e0092581\">\n                                        {{- 'tn48bd3755' | t -}}\n                                      </label>\n                                    {%- endunless -%}\n                                    <div\n                                      position-id=\"0bdc2566-2ac1-2daf-6ee1-0989537f67df\"\n                                      class=\"add-to-cart_wrapper _w-form\"\n                                    >\n                                      <div>\n                                        <div class=\"input-group input-number-group\">\n                                          <div class=\"input-group-button\">\n                                            <div class=\"input-number-decrement\">{{ 't2013' | t }}</div>\n                                          </div>\n                                          {%- assign condition_value = product.type | strip -%}\n                                          {%- unless condition_value == 'e348fd487d0102946c9179d2a94bb613' -%}\n                                            <input\n                                              type=\"number\"\n                                              pattern=\"^[0-9]+$\"\n                                              inputmode=\"numeric\"\n                                              id=\"quantity-75f2feb68714ea4665d3ede4e0092581\"\n                                              name=\"quantity\"\n                                              min=\"1\"\n                                              class=\"w-commerce-commerceaddtocartquantityinput input-number\"\n                                              value=\"1\"\n                                            >\n                                          {%- endunless -%}\n                                          <div class=\"input-group-button\">\n                                            <div class=\"input-number-increment\">{{ 't2b' | t }}</div>\n                                          </div>\n                                        </div>\n                                      </div>\n                                      <input\n                                        type=\"submit\"\n                                        data-node-type=\"commerce-add-to-cart-button\"\n                                        data-loading-text=\"{{ 'tn60b63398' | t }}\"\n                                        aria-busy=\"false\"\n                                        aria-haspopup=\"dialog\"\n                                        class=\"w-commerce-commerceaddtocartbutton add-to-cart-button\"\n                                        value=\"{{ 'tn26bdceda' | t }}\"\n                                      >\n                                    </div>\n                                  </div>\n                                  {%- render 'product-variants-data', product: product -%}\n                                {%- endform -%}\n                                <div style=\"di