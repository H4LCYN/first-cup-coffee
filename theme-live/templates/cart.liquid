                    <h3 class="h3">{{ 't10ade2ed' | t }}</h3>
                    <div class="spacer-1"></div>
                    <div class="cart-label_grid">
                      <div id="w-node-_0de1d94e-65b3-8655-e515-33335a9d2d49-729082a5" class="cart-label">{{ 't185958cf' | t }}</div>
                      <div id="w-node-a795a532-aa55-41d4-b62d-020e8a6c6503-729082a5" class="cart-label is-quantity">{{ 'tn1df1ab75' | t }}</div>
