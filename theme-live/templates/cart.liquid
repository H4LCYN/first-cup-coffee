                        </div>
                      </div>
                      <div class="cart_buttons-wrapper"><input type="submit" data-wait="Please wait..." class="btn secondary w-button" value="{{ 'tn689adb17' | t }}" name="update"><input type="submit" data-wait="Please wait..." class="btn mobile-stretch w-button" value="{{ 't51040653' | t }}" name="checkout"></div>
                    </div>
                  </div>
                </form>
                
                
              </div>
            </div>
          </div>
        </div>
