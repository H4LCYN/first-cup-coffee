                            </div>
                          </div>
                          <a href="/cart/change?line={{ forloop.index }}&amp;amp;quantity=0" class="cart-item-remove">{{ 'tf2ed' | t }}</a>
                        </div>
                      </div>
                      <div id="w-node-e20065b3-02ae-3d79-6441-1b44f03b5d70-729082a5" class="cart-item_total">
