                        <div class="cart-item_wrapper">
                          <a href="{{ item.url }}" class="w-inline-block">
                            <div class="cart-item_info">
                              <div class="cart-item-title">{{ item.title }}</div>
                              <div class="product-price compare-at">{{ item.variant.compare_at_price  | money }}</div>
                              <div class="p-medium is-cart">{{ item.final_line_price | money }}</div>
                              <div class="p-medium is-cart">{%- render 'cart-item-properties', item: item -%}</div>
                            </div>
                          </a>
                        </div>
                        <div id="w-node-_952baa3a-868a-a04c-c135-5dd9e90d483e-729082a5" class="cart-item_wrapper align-center">
                          <div class="udesly-input-wrapper">
