                      </div>
                    </div>{%- endfor -%}
                    <div class="spacer-2"></div>
                    <div class="home-dashed-rule_right"></div>
                  </div>
                  <div class="cart-footer"><textarea placeholder="{{ 't77790f97' | t }}" maxlength="5000" id="note" name="note" data-name="Note" class="cart-footer-text-area w-input">{{ cart.note }}</textarea>
