              <form action="/search" class="display-none w-form" method="get" role="search"><label for="search-2">{{ 'tn6ca0ae38' | t }}</label><input class="w-input" maxlength="256" name="q" placeholder="{{ 'tn2774f8a2' | t }}" type="search" id="search" required=""><input type="submit" class="w-button" value="{{ 'tn6ca0ae38' | t }}"></form>{%- if search.performed -%}<div data-node-type="search-result-wrapper" class="display-none">{%- if search.results_count > 0 -%}<div data-node-type="search-result-list">{%- for item in search.results -%}<div data-node-type="search-result-item"><a data-node-type="link" href="{{ item.url }}">{{ item.title }}</a><div data-node-type="block">{{ item.url }}</div><p data-node-type="paragraph">{{ item.content | highlight: search.terms }}</p></div>{%- endfor -%}</div>{%- endif -%}{%- if search.results_count == 0 -%}<div data-node-type="search-result-empty"><div data-node-type="block">{{ 'tn75764c4' | t }}</div></div>{%- endif -%}</div>{%- endif -%}
              {%- render "search_results_product" -%}
            </div>
          </div>
        </div>
