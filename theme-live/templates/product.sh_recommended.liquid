{% layout none %}
{% assign item = product %}            
<div role="listitem" class="w-dyn-item">
                        <a href="{{ item.url }}" class="home-product_link w-inline-block">
                          <div class="product-container-image"><img src="{{ item.featured_image | img_url: 'master' }}" loading="lazy" alt="{{ item.featured_image.alt }}" class="product-image" data-commerce-type="variation-image" srcset="{{ item.featured_image | img_url: '1920x' }} 1920w,{{ item.featured_image | img_url: '1600x' }} 1600w,{{ item.featured_image | img_url: '1366x' }} 1366w,{{ item.featured_image | img_url: '1024x' }} 1024w,{{ item.featured_image | img_url: '768x' }} 768w,{{ item.featured_image | img_url: '640x' }} 640w"></div>
                          <div class="product-container-info">
                            <div class="p-medium">{{ item.title }}</div>
                            <div class="p-small">{{ item.type }}</div>
                          </div>
                        </a>
                      </div>