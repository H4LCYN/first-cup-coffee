{% schema %}
{
  "name": "Section - Room Rentals",
  "tag": "section",
  "class": "section_room-rentals",
  "settings": [],
  "blocks": [
    {
      "name": "room-rental-location",
      "type": "room_rental_location",
      "settings": [
                    {
              "id": "rental_link",
              "label": "Rental Link",
              "type": "url"
            },
            {
              "type": "image_picker",
              "id": "location-image",
              "label": "Location Image"
            },
        {
          "type": "text",
          "id": "location_name",
          "label": "location-name",
          "default": "Pearland"
        },
        {
          "type": "text",
          "id": "conference_rooms",
          "label": "conference-rooms",
          "default": "1 Conference Room"
        },
        {
          "type": "text",
          "id": "meeting_rooms",
          "label": "meeting-rooms",
          "default": "3 Meeting Rooms"
        },
        {
          "type": "checkbox",
          "id": "show_conference_rooms",
          "label": "show-conference-rooms",
          "default": true
        },
        {
          "type": "checkbox",
          "id": "show_meeting_rooms",
          "label": "show-meeting-rooms",
          "default": true
        }
      ]
    }
  ]
}
{% endschema %}