
<div class="site-redesign-26 page-hero-2026">
  <div class="page-hero-2026_inner">
    <div class="page-hero-2026_photo">
      {%- if section.settings.image != blank -%}
        <img
          src="{{ section.settings.image | img_url: '1920x' }}"
          srcset="{{ section.settings.image | img_url: '768x' }} 768w, {{ section.settings.image | img_url: '1440x' }} 1440w, {{ section.settings.image | img_url: '1920x' }} 1920w"
          sizes="100vw"
          alt="{{ section.settings.image.alt | escape }}"
          fetchpriority="high"
          class="page-hero-2026_image"
          style="object-position: {{ section.settings.image_position_x }}% {{ section.settings.image_position_y }}%;"
        >
      {%- elsif section.settings.fallback_image != blank -%}
        <img
          src="{{ section.settings.fallback_image | asset_url }}"
          alt=""
          fetchpriority="high"
          class="page-hero-2026_image"
          style="object-position: {{ section.settings.image_position_x }}% {{ section.settings.image_position_y }}%;"
        >
      {%- endif -%}
    </div>
    <div class="page-hero-2026_scrim"></div>
    <div class="page-hero-2026_grain">
      <img src="{{ 'hero-carousel-grain-overlay.png' | asset_url }}" alt="" decoding="async" class="page-hero-2026_grain-image">
    </div>
    <div class="page-hero-2026_content">
      <h1 class="page-hero-2026_heading">{{ section.settings.heading | escape }}</h1>
      {%- if section.settings.text != blank -%}
        <p class="page-hero-2026_text" style="max-width: {{ section.settings.text_max_width }}px;">{{ section.settings.text | escape }}</p>
      {%- endif -%}
      {%- if section.settings.button_1_text != blank or section.settings.button_2_text != blank -%}
        <div class="page-hero-2026_buttons">
          {%- if section.settings.button_1_text != blank -%}
            <a href="{{ section.settings.button_1_link }}" class="page-hero-2026_button">{{ section.settings.button_1_text | escape }}</a>
          {%- endif -%}
          {%- if section.settings.button_2_text != blank -%}
            <a href="{{ section.settings.button_2_link }}" class="page-hero-2026_button">{{ section.settings.button_2_text | escape }}</a>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</div>

<style>
  /* Full-bleed subpage hero (Figma "_desktop-hero_web_1440x576", e.g. node
     244:1987 on the Locations page). Unlike the homepage carousel it runs
     edge to edge with square corners, so the section drops the shared
     side padding. */
  section.site-redesign-26.section_page-hero {
    padding: 0;
  }

  .page-hero-2026_inner {
    position: relative;
    max-width: var(--site-max-width);
    margin: 0 auto;
    aspect-ratio: 1440 / 576;
    min-height: 480px;
    overflow: hidden;
    background-color: var(--dark-grey);
  }

  .page-hero-2026_photo,
  .page-hero-2026_image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .page-hero-2026_image {
    object-fit: cover;
  }

  /* Figma "Rectangle 1124": #232323 fading to transparent across the left
     ~86% of the frame. */
  .page-hero-2026_scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(to right, #232323 0%, rgba(35, 35, 35, 0) 85.8%);
    pointer-events: none;
  }

  /* Same flattened grain export the homepage hero uses (opacity baked in). */
  .page-hero-2026_grain {
    position: absolute;
    inset: 0;
    mix-blend-mode: lighten;
    pointer-events: none;
  }

  .page-hero-2026_grain-image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .page-hero-2026_content {
    position: relative;
    z-index: 1;
    height: 100%;
    max-width: calc(643px + 24px + 10.775%);
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: flex-start;
    gap: 35px;
    padding: 40px 24px 40px 10.775%;
  }

  .page-hero-2026_heading {
    margin: 0;
    font-family: Avenirnextltpro, sans-serif;
    font-weight: 700;
    font-size: 72px;
    line-height: 0.92;
    color: #fff;
    text-transform: uppercase;
  }

  .page-hero-2026_text {
    margin: 0;
    max-width: 469px;
    font-family: Roboto, sans-serif;
    font-weight: 400;
    font-size: 20px;
    line-height: 26px;
    color: #fff;
  }

  .page-hero-2026_buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 16px 35px;
  }

  .page-hero-2026_button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 216px;
    min-height: 53px;
    padding: 8px 23px;
    background-color: var(--butterscotch);
    border-radius: 2px;
    font-family: Avenirnextltpro, sans-serif;
    font-weight: 700;
    font-size: 18px;
    color: #000;
    text-align: center;
    text-transform: uppercase;
    text-decoration: none;
    transition: opacity 0.2s;
  }

  .page-hero-2026_button:hover {
    opacity: 0.85;
  }

  @media screen and (max-width: 991px) {
    .page-hero-2026_heading {
      font-size: 56px;
    }

    .page-hero-2026_content {
      padding-left: 60px;
    }
  }

  @media screen and (max-width: 767px) {
    .page-hero-2026_inner {
      aspect-ratio: auto;
      min-height: 520px;
    }

    .page-hero-2026_scrim {
      background: linear-gradient(to right, rgba(35, 35, 35, 0.9) 0%, rgba(35, 35, 35, 0.4) 100%);
    }

    .page-hero-2026_content {
      max-width: none;
      min-height: 520px;
      gap: 24px;
      padding: 60px 24px;
    }

    .page-hero-2026_heading {
      font-size: 40px;
    }

    .page-hero-2026_text {
      font-size: 18px;
      line-height: 24px;
    }

    .page-hero-2026_buttons {
      gap: 16px;
    }

    .page-hero-2026_button {
      min-width: 0;
      min-height: 48px;
      font-size: 16px;
    }
  }
</style>

<script>var currentSection = document.currentScript.closest('.shopify-section');currentSection.setAttribute("class","section_page-hero site-redesign-26");</script>

{% schema %}
{
  "name": "Section - Page Hero",
  "tag": "section",
  "class": "section_page-hero",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Background photo"
    },
    {
      "type": "text",
      "id": "fallback_image",
      "label": "Fallback photo filename (asset, used only if no photo is picked above)",
      "info": "Advanced: filename of a theme asset, e.g. locations-hero.webp"
    },
    {
      "type": "range",
      "id": "image_position_x",
      "label": "Photo focal point (horizontal)",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 50
    },
    {
      "type": "range",
      "id": "image_position_y",
      "label": "Photo focal point (vertical)",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 50
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Page heading"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Paragraph"
    },
    {
      "type": "range",
      "id": "text_max_width",
      "label": "Paragraph width (desktop)",
      "min": 400,
      "max": 600,
      "step": 2,
      "unit": "px",
      "default": 470
    },
    {
      "type": "text",
      "id": "button_1_text",
      "label": "Button 1 text"
    },
    {
      "type": "url",
      "id": "button_1_link",
      "label": "Button 1 link"
    },
    {
      "type": "text",
      "id": "button_2_text",
      "label": "Button 2 text"
    },
    {
      "type": "url",
      "id": "button_2_link",
      "label": "Button 2 link"
    }
  ],
  "presets": [
    {
      "name": "Section - Page Hero"
    }
  ]
}
{% endschema %}
