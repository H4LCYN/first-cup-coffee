<div class="padding-global-4">
          <div class="container-large-2">
            <div class="padding-section-medium-2">
              <div class="home-cta_component is-left">
                <div class="home-cta_content-wrapper">
                  <h2 sym-bind="{"children":{"type":"Select","val":{"from":{"type":"Variable","val":"data"},"prop":"048665ad-f15b-4b0e-0b77-7612281f1758"}}}" class="h2">First Cup LOCATIONs</h2>
                  <p sym-bind="{"children":{"type":"Select","val":{"from":{"type":"Variable","val":"data"},"prop":"c391f7f9-5ef9-6d7c-1240-b35e52459bec"}}}" class="text-size-medium-3">The First Cup Coffee Company Flagship location is now open to serve you! Online Order Ahead, pass through the Drive-Thru, or come relax in our spacious shop. Check out the First Cup private offices and conference room rentals.</p>
                  <div class="spacer-small-2"></div>
                  <div class="home-cta-2_button-wrapper">
                    <a href="{{ section.settings.url_button_1_link }}" class="button-1 w-inline-block"> <div class="text-block">{{ section.settings.text_button_1_text }}</div> </a>
                    <a href="{{ section.settings.url_button_2_link }}" class="button-1 w-inline-block"> <div class="text-block">{{ section.settings.text_button_2_text }}</div> </a>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
        <div class="home-cta-1_background">
          <div class="home-cta-2_background-overlay"></div>{% if section.settings.image_background_image %}
{{ section.settings.image_background_image | image_url: width: 1000 | image_tag: class: 'home-cta-1_background-image', sizes: '(max-width: 1162px) 100vw, 1162px', loading: 'lazy' }}
{% else %}
<img class="home-cta-1_background-image" src="{{ '2Q6A9148.jpg' | asset_url }}" alt="" sizes="(max-width: 1162px) 100vw, 1162px" loading="lazy" srcset="{{ '2Q6A9148-p-500.jpg' | asset_url }} 500w, {{ '2Q6A9148-p-800.jpg' | asset_url }} 800w, {{ '2Q6A9148.jpg' | asset_url }} 1162w">
{% endif %}
        </div> {% schema %} {
    "tag": "section",
    "name": "Home CTA 2",
    "class": "section_home-cta-2",
    "settings": [
        {
            "id": "url_button_1_link",
            "type": "url",
            "label": "Button 1 Link"
        },
        {
            "id": "text_button_1_text",
            "type": "text",
            "label": "Button 1 Text",
            "default": "LEARN\u00a0MORE"
        },
        {
            "id": "url_button_2_link",
            "type": "url",
            "label": "Button 2 Link"
        },
        {
            "id": "text_button_2_text",
            "type": "text",
            "label": "Button 2 Text",
            "default": "ORDER\u00a0AHEAD"
        },
        {
            "id": "image_background_image",
            "type": "image_picker",
            "label": "Background Image"
        }
    ],
    "presets": [
        {
            "name": "Home CTA 2",
            "category": "Liquify",
            "blocks": []
        }
    ]
} {% endschema %}