<div class="padding-global-4">
          <div class="container-xs">
            <div class="padding-section-medium-2">
              <div class="email-signup_content-wrapper">
                <h3 class="text-color-white-2">BE THE first to know</h3>
                <p class="text-size-medium-4 text-color-white-2">Join the First Cup newsletter to be the first to know about new products and offers.</p>
                <div class="email-signup-form_component w-form">
                  {% form 'customer', return_to: '/', class: 'footer_form' %}
<div class="form-4"><label for="Email" class="form_hidden-label">Your E-Mail-Address</label><input class="text-field w-input" maxlength="256" name="contact[email]" data-name="Email" placeholder="{{ section.settings.placeholder_text }}" type="email" id="Email" required=""><input type="submit" data-wait="" id="w-node-ab0288fc-b85e-8127-26d0-37f474f6854a-31fd25d2" class="button-2 w-button" value="Subscribe"></div>
                    <div li-object="form.errors | default_errors" class="text-size-tiny text-color-red">{{ form.errors | default_errors }}</div>
                    <div id="w-node-_7b0d66a6-07e9-ea68-033a-4410eacf649e-31fd25d2" class="hide w-embed"><input type="hidden" name="contact[accepts_marketing]" value="false"></div><label id="w-node-_7b0d66a6-07e9-ea68-033a-4410eacf649f-31fd25d2" class="w-checkbox form_checkbox" name="contact[accepts_marketing]"><input type="checkbox" name="Accepts-Marketing-2" id="Accepts-Marketing-2" data-name="Accepts Marketing 2" class="w-checkbox-input form_checkbox-icon"><span class="form_checkbox-label text-size-tiny w-form-label" for="Accepts-Marketing-2">
{{ section.settings.text_checkbox }}
</span></label>
                  {% endform %}
                  <div class="hide w-form-done">
                    <div>Thank you! Your submission has been received!</div>
                  </div>
                  <div class="hide w-form-fail">
                    <div>Oops! Something went wrong while submitting the form.</div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div> {% schema %} {
    "tag": "div",
    "name": "Newsletter Signup",
    "class": "section_email-signup",
    "settings": [
        {
            "id": "text_checkbox",
            "type": "text",
            "label": "Checkbox",
            "default": "By subscribing you agree to with our <a href=\"#\"><span>Privacy Policy<\/span><\/a> and provide consent to receive updates from our company."
        }
    ],
    "presets": [
        {
            "name": "Newsletter Signup",
            "category": "Liquify",
            "blocks": []
        }
    ]
} {% endschema %}