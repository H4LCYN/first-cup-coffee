datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

// Standard Shopify session storage model — required by @shopify/shopify-app-session-storage-prisma.
// This app only ever needs the store's offline (Admin API) session; no per-customer data lives here,
// everything about a prayer request lives in the prayer_request metaobject in Shopify itself.
model Session {
  id            String    @id
  shop          String
  state         String
  isOnline      Boolean   @default(false)
  scope         String?
  expires       DateTime?
  accessToken   String
  userId        BigInt?
  firstName     String?
  lastName      String?
  email         String?
  accountOwner  Boolean   @default(false)
  locale        String?
  collaborator  Boolean?  @default(false)
  emailVerified Boolean?  @default(false)
}

// One row per guest (logged-out) submission, used only to throttle guest posting.
// ipHash is a salted SHA-256 of the visitor's IP, never the IP itself; null when the
// App Proxy didn't forward one.
model GuestSubmission {
  id        Int      @id @default(autoincrement())
  ipHash    String?
  createdAt DateTime @default(now())

  @@index([ipHash, createdAt])
  @@index([createdAt])
}
